{% comment %}
  Section: مختارات هذا الأسبوع (Weekly Picks)
  Apple-like Minimal Editorial & Product Showcase Section
  Designed for Hassef Store (الحصيف)
{% endcomment %}

{%- assign section_id = section.id | replace: '_', '' | replace: '-', '' | downcase -%}
{%- assign locale_code = request.locale.iso_code | downcase | split: '-' | first | default: 'ar' -%}
{%- assign is_rtl = false -%}
{%- if 'ar,he,fa,ur' contains locale_code -%}
  {%- assign is_rtl = true -%}
{%- endif -%}

{% style %}
/* ── MAIN SECTION WRAPPER ── */
.weekly-picks-{{ section_id }} {
  display: block;
  width: 100%;
  max-width: {{ section.settings.max_width }}px;
  margin: {{ section.settings.margin_top }}px auto {{ section.settings.margin_bottom }}px;
  padding: {{ section.settings.padding_vertical }}px {{ section.settings.padding_horizontal }}px;
  box-sizing: border-box;
  /* Direction and text-align inherited from html[dir] */
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "IBM Plex Sans Arabic", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
  position: relative;
  overflow: hidden;
}

/* Header */
.wp-header-{{ section_id }} {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: {{ section.settings.header_gap }}px;
  padding: 0 2px;
}

.wp-titles-{{ section_id }} {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.wp-subtitle-{{ section_id }} {
  font-size: {{ section.settings.subtitle_size }}px;
  font-weight: 600;
  color: {{ section.settings.accent_color }};
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.wp-title-{{ section_id }} {
  font-size: {{ section.settings.title_size }}px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  margin: 0;
  line-height: 1.2;
}

.wp-view-all-{{ section_id }} {
  font-size: 14px;
  font-weight: 600;
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: opacity 0.2s ease;
}

.wp-view-all-{{ section_id }}:hover {
  opacity: 0.8;
}

/* ── CAROUSEL TRACK ── */
.wp-carousel-container-{{ section_id }} {
  position: relative;
  width: 100%;
  /* Direction inherited */
}

.wp-track-{{ section_id }} {
  display: flex;
  gap: {{ section.settings.slide_gap }}px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding: 4px 0 12px;
  align-items: stretch;
  /* Direction inherited */
}

.wp-track-{{ section_id }}::-webkit-scrollbar {
  display: none;
}

/* ── LARGE EDITORIAL CARD (Renders ONLY ONCE at start) ── */
.wp-editorial-card-{{ section_id }} {
  flex: 0 0 {{ section.settings.editorial_width }}px;
  width: {{ section.settings.editorial_width }}px;
  scroll-snap-align: start;
  position: relative;
  border-radius: {{ section.settings.card_border_radius }}px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: {{ section.settings.editorial_padding }}px;
  box-sizing: border-box;
  text-decoration: none;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  border: 1px solid rgba(0, 0, 0, 0.05);
  background-size: cover;
  background-position: center;
}

.wp-editorial-card-{{ section_id }}:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.09);
}

.wp-editorial-overlay-{{ section_id }} {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.wp-editorial-content-{{ section_id }} {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.wp-editorial-label-{{ section_id }} {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.85;
}

.wp-editorial-heading-{{ section_id }} {
  font-size: {{ section.settings.editorial_heading_size }}px;
  font-weight: 700;
  line-height: 1.22;
  margin: 0;
  letter-spacing: -0.015em;
}

.wp-editorial-desc-{{ section_id }} {
  font-size: 13px;
  line-height: 1.45;
  opacity: 0.9;
  margin: 0;
}

.wp-editorial-img-wrap-{{ section_id }} {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0;
}

.wp-editorial-img-{{ section_id }} {
  max-width: 85%;
  max-height: 150px;
  object-fit: contain;
  transition: transform 0.4s ease;
}

.wp-editorial-card-{{ section_id }}:hover .wp-editorial-img-{{ section_id }} {
  transform: scale(1.06);
}

.wp-editorial-cta-{{ section_id }} {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  margin-top: auto;
  padding-top: 8px;
}

/* ── STACKED PRODUCTS COLUMN (2 Products Stacked) ── */
.wp-products-col-{{ section_id }} {
  flex: 0 0 {{ section.settings.col_width }}px;
  width: {{ section.settings.col_width }}px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.card_gap }}px;
  justify-content: space-between;
}

/* ── PRODUCT CARD ── */
.wp-product-card-{{ section_id }} {
  flex: 1;
  border-radius: {{ section.settings.card_border_radius }}px;
  padding: 12px 14px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  text-decoration: none;
  border: 1px solid rgba(0, 0, 0, 0.05);
  background-color: {{ section.settings.fixed_card_bg }};
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
}

.wp-product-card-{{ section_id }}:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.wp-product-header-{{ section_id }} {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 6px;
  text-align: start !important;
}

.wp-product-title-{{ section_id }} {
  font-size: {{ section.settings.card_title_size }}px !important;
  font-weight: 700 !important;
  color: #171717 !important;
  margin: 0 !important;
  line-height: 1.3 !important;
  opacity: 1 !important;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box !important;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  visibility: visible !important;
  text-align: start !important;
}

.wp-product-img-wrap-{{ section_id }} {
  width: {{ section.settings.img_width_percent }}%;
  height: {{ section.settings.img_height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4px auto;
}

.wp-product-img-{{ section_id }} {
  max-width: 100%;
  max-height: 100%;
  object-fit: {{ section.settings.img_fit }};
  transition: transform 0.3s ease;
}

.wp-product-card-{{ section_id }}:hover .wp-product-img-{{ section_id }} {
  transform: scale(1.06);
}

.wp-product-footer-{{ section_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  /* Direction inherited */
}

.wp-product-price-{{ section_id }} {
  font-size: {{ section.settings.card_price_size }}px !important;
  font-weight: 700 !important;
  color: #171717 !important;
  display: flex;
  align-items: baseline;
  gap: 4px;
  opacity: 1 !important;
  visibility: visible !important;
  text-align: start !important;
}

.wp-product-compare-{{ section_id }} {
  font-size: 11px;
  color: #a3a3a3;
  text-decoration: line-through;
  font-weight: 400;
}

.wp-add-btn-{{ section_id }} {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #ffffff;
  color: #171717;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  padding: 0;
  outline: none;
}

.wp-add-btn-{{ section_id }}:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  border-color: {{ section.settings.accent_color }};
  transform: scale(1.12);
}

.wp-add-btn-{{ section_id }}.is-loading {
  opacity: 0.6;
  pointer-events: none;
}

.wp-add-btn-{{ section_id }}.is-added {
  background: #22c55e;
  color: #ffffff;
  border-color: #22c55e;
}

/* ── FRAMELESS CIRCULAR BROWSE MORE BUTTON AT END ── */
.wp-browse-col-{{ section_id }} {
  flex: 0 0 110px;
  width: 110px;
  scroll-snap-align: start;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wp-browse-btn-{{ section_id }} {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background: transparent;
  border: none;
  gap: 8px;
  cursor: pointer;
  padding: 0;
  transition: transform 0.3s ease;
}

.wp-browse-btn-{{ section_id }}:hover {
  transform: scale(1.08);
}

.wp-browse-circle-{{ section_id }} {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  transition: background 0.3s ease, transform 0.3s ease;
}

.wp-browse-btn-{{ section_id }}:hover .wp-browse-circle-{{ section_id }} {
  background: #171717;
  transform: scale(1.06);
}

.wp-browse-title-{{ section_id }} {
  font-size: 13px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  margin: 0;
  white-space: nowrap;
}

/* ── PAGINATION DOTS ── */
.wp-dots-{{ section_id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: {{ section.settings.dots_margin_top }}px;
}

.wp-dot-{{ section_id }} {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.wp-dot-{{ section_id }}.is-active {
  background: {{ section.settings.accent_color }};
  width: 22px;
  border-radius: 4px;
}

/* Mobile Responsive */
@media screen and (max-width: 749px) {
  .wp-editorial-card-{{ section_id }} {
    flex: 0 0 240px;
    width: 240px;
  }
  .wp-products-col-{{ section_id }} {
    flex: 0 0 220px;
    width: 220px;
  }
}
{% endstyle %}

{%- comment -%} Determine Product Objects (Pickers 1-6 or Product List) {%- endcomment -%}
{%- assign p1 = section.settings.product_1 | default: section.settings.products[0] -%}
{%- assign p2 = section.settings.product_2 | default: section.settings.products[1] -%}
{%- assign p3 = section.settings.product_3 | default: section.settings.products[2] -%}
{%- assign p4 = section.settings.product_4 | default: section.settings.products[3] -%}
{%- assign p5 = section.settings.product_5 | default: section.settings.products[4] -%}
{%- assign p6 = section.settings.product_6 | default: section.settings.products[5] -%}

{%- assign img1 = section.settings.image_1 -%}
{%- assign img2 = section.settings.image_2 -%}
{%- assign img3 = section.settings.image_3 -%}
{%- assign img4 = section.settings.image_4 -%}
{%- assign img5 = section.settings.image_5 -%}
{%- assign img6 = section.settings.image_6 -%}

{%- comment -%} High Contrast Text Colors per product card {%- endcomment -%}
{%- assign raw_card_text = section.settings.card_text_color | default: '#171717' -%}
{%- if raw_card_text == blank or raw_card_text == 'transparent' or raw_card_text == '#ffffff' or raw_card_text == '#fff' -%}
  {%- assign raw_card_text = '#171717' -%}
{%- endif -%}

{%- assign txt_c1 = raw_card_text -%}
{%- assign txt_c2 = raw_card_text -%}
{%- assign txt_c3 = raw_card_text -%}
{%- assign txt_c4 = raw_card_text -%}
{%- assign txt_c5 = raw_card_text -%}
{%- assign txt_c6 = raw_card_text -%}

{%- if section.settings.enable_auto_colors -%}
  {%- if section.settings.color_1 != blank and section.settings.color_1 != '#ffffff' -%}{%- assign txt_c1 = section.settings.color_1 -%}{%- endif -%}
  {%- if section.settings.color_2 != blank and section.settings.color_2 != '#ffffff' -%}{%- assign txt_c2 = section.settings.color_2 -%}{%- endif -%}
  {%- if section.settings.color_3 != blank and section.settings.color_3 != '#ffffff' -%}{%- assign txt_c3 = section.settings.color_3 -%}{%- endif -%}
  {%- if section.settings.color_4 != blank and section.settings.color_4 != '#ffffff' -%}{%- assign txt_c4 = section.settings.color_4 -%}{%- endif -%}
  {%- if section.settings.color_5 != blank and section.settings.color_5 != '#ffffff' -%}{%- assign txt_c5 = section.settings.color_5 -%}{%- endif -%}
  {%- if section.settings.color_1 != blank and section.settings.color_1 != '#ffffff' -%}{%- assign txt_c6 = section.settings.color_1 -%}{%- endif -%}
{%- endif -%}

<div class="weekly-picks-{{ section_id }}" id="WeeklyPicks-{{ section_id }}">
  {%- if section.settings.title != blank -%}
    <div class="wp-header-{{ section_id }}">
      <div class="wp-titles-{{ section_id }}">
        {%- if section.settings.subtitle != blank -%}
          <span class="wp-subtitle-{{ section_id }}">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        <h2 class="wp-title-{{ section_id }}">{{ section.settings.title }}</h2>
      </div>

      {%- if section.settings.show_view_all and section.settings.collection_url != blank -%}
        <a href="{{ section.settings.collection_url }}" class="wp-view-all-{{ section_id }}">
          {{ section.settings.view_all_text | default: 'عرض الكل' }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="wp-carousel-container-{{ section_id }}">
    <div class="wp-track-{{ section_id }}" id="WpTrack-{{ section_id }}">
      
      <!-- 1) EDITORIAL LARGE CARD (Renders ONLY ONCE at start) -->
      <a
        href="{{ section.settings.editorial_cta_url | default: '#' }}"
        class="wp-editorial-card-{{ section_id }}"
        style="
          background-color: {{ section.settings.editorial_bg_color | default: '#5B171C' }};
          color: {{ section.settings.editorial_text_color | default: '#ffffff' }};
          {% if section.settings.editorial_bg_image != blank %}background-image: url('{{ section.settings.editorial_bg_image | image_url: width: 800 }}');{% endif %}
        "
      >
        {%- if section.settings.overlay_opacity > 0 -%}
          <div
            class="wp-editorial-overlay-{{ section_id }}"
            style="background: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>
        {%- endif -%}

        <div class="wp-editorial-content-{{ section_id }}">
          {%- if section.settings.editorial_label != blank -%}
            <span class="wp-editorial-label-{{ section_id }}">{{ section.settings.editorial_label }}</span>
          {%- endif -%}
          {%- if section.settings.editorial_heading != blank -%}
            <h3 class="wp-editorial-heading-{{ section_id }}">{{ section.settings.editorial_heading }}</h3>
          {%- endif -%}
          {%- if section.settings.editorial_desc != blank -%}
            <p class="wp-editorial-desc-{{ section_id }}">{{ section.settings.editorial_desc }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.editorial_image != blank -%}
          <div class="wp-editorial-img-wrap-{{ section_id }}">
            <img
              src="{{ section.settings.editorial_image | image_url: width: 600 }}"
              alt="{{ section.settings.editorial_heading | escape }}"
              class="wp-editorial-img-{{ section_id }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        {%- if section.settings.editorial_cta_text != blank -%}
          <div class="wp-editorial-cta-{{ section_id }}" style="color: {{ section.settings.editorial_accent_color | default: '#ffffff' }}">
            {{ section.settings.editorial_cta_text }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
          </div>
        {%- endif -%}
      </a>

      <!-- 2) STACKED COLUMN 1 (Products 1 & 2) -->
      <div class="wp-products-col-{{ section_id }}">
        
        <!-- Product 1 -->
        <div class="wp-product-card-{{ section_id }}" style="position:relative;">
          {%- if p1 != blank -%}
            <a href="{{ p1.url }}" aria-label="{{ p1.title | escape }}" style="position:absolute;inset:0;z-index:1;border-radius:inherit;"></a>
            <div class="wp-product-header-{{ section_id }}">
              <h4 class="wp-product-title-{{ section_id }}" style="color: {% if txt_c1 == '#ffffff' or txt_c1 == '#FFFFFF' or txt_c1 == blank %}#171717{% else %}{{ txt_c1 }}{% endif %} !important;">{{ p1.title }}</h4>
            </div>
            <div class="wp-product-img-wrap-{{ section_id }}">
              {%- if img1 != blank -%}
                <img src="{{ img1 | image_url: width: 400 }}" alt="{{ p1.title | escape }}" class="wp-product-img-{{ section_id }}" loading="lazy" width="400" height="400">
              {%- elsif p1.featured_image -%}
                <img src="{{ p1.featured_image | image_url: width: 400 }}" alt="{{ p1.title | escape }}" class="wp-product-img-{{ section_id }}" loading="lazy" width="400" height="400">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="wp-product-footer-{{ section_id }}">
              <div class="wp-product-price-{{ section_id }}" style="color: {% if txt_c1 == '#ffffff' or txt_c1 == '#FFFFFF' or txt_c1 == blank %}#171717{% else %}{{ txt_c1 }}{% endif %} !important;">
                {{ p1.price | money }}
                {%- if p1.compare_at_price > p1.price -%}<span class="wp-product-compare-{{ section_id }}">{{ p1.compare_at_price | money }}</span>{%- endif -%}
              </div>
              {%- if section.settings.show_add_button -%}
                <button type="button" class="wp-add-btn-{{ section_id }}" data-variant-id="{{ p1.first_available_variant.id | default: p1.variants.first.id }}" aria-label="+" style="position:relative;z-index:2;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="wp-product-header-{{ section_id }}"><h4 class="wp-product-title-{{ section_id }}" style="color: #171717 !important;">اختر المنتج 1</h4></div>
            <div class="wp-product-img-wrap-{{ section_id }}">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="wp-product-footer-{{ section_id }}"><div class="wp-product-price-{{ section_id }}" style="color: #171717 !important;">350 ج.م</div></div>
          {%- endif -%}
        </div>

        <!-- Product 2 -->
        <div class="wp-product-card-{{ section_id }}" style="position:relative;">
          {%- if p2 != blank -%}
            <a href="{{ p2.url }}" aria-label="{{ p2.title | escape }}" style="position:absolute;inset:0;z-index:1;border-radius:inherit;"></a>
            <div class="wp-product-header-{{ section_id }}">
              <h4 class="wp-product-title-{{ section_id }}" style="color: {% if txt_c2 == '#ffffff' or txt_c2 == '#FFFFFF' or txt_c2 == blank %}#171717{% else %}{{ txt_c2 }}{% endif %} !important;">{{ p2.title }}</h4>
            </div>
            <div class="wp-product-img-wrap-{{ section_id }}">
              {%- if img2 != blank -%}
                <img src="{{ img2 | image_url: width: 400 }}" alt="{{ p2.title | escape }}" class="wp-product-img-{{ section_id }}" loading="lazy" width="400" height="400">
              {%- elsif p2.featured_image -%}
                <img src="{{ p2.featured_image | image_url: width: 400 }}" alt="{{ p2.title | escape }}" class="wp-product-img-{{ section_id }}" loading="lazy" width="400" height="400">
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="wp-product-footer-{{ section_id }}">
              <div class="wp-product-price-{{ section_id }}" style="color: {% if txt_c2 == '#ffffff' or txt_c2 == '#FFFFFF' or txt_c2 == blank %}#171717{% else %}{{ txt_c2 }}{% endif %} !important;">
                {{ p2.price | money }}
                {%- if p2.compare_at_price > p2.price -%}<span class="wp-product-compare-{{ section_id }}">{{ p2.compare_at_price | money }}</span>{%- endif -%}
              </div>
              {%- if section.settings.show_add_button -%}
                <button type="button" class="wp-add-btn-{{ section_id }}" data-variant-id="{{ p2.first_available_variant.id | default: p2.variants.first.id }}" aria-label="+" style="position:relative;z-index:2;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="wp-product-header-{{ section_id }}"><h4 class="wp-product-title-{{ section_id }}" style="color: #171717 !important;">اختر المنتج 2</h4></div>
            <div class="wp-product-img-wrap-{{ section_id }}">{{ 'product-2' | placeholder_svg_tag }}</div>
            <div class="wp-product-footer-{{ section_id }}"><div class="wp-product-price-{{ section_id }}" style="color: #171717 !important;">350 ج.م</div></div>
          {%- endif -%}
        </div>

