<script>
(function() {
  const sectionId = '{{ section_id }}';
  const track = document.getElementById('WpTrack-' + sectionId);
  const dotsContainer = document.getElementById('WpDots-' + sectionId);
  
  if (!track) return;

  // Pagination Dots Sync (RTL Safe using IntersectionObserver & scrollIntoView)
  if (dotsContainer) {
    const dots = Array.from(dotsContainer.querySelectorAll('.wp-dot-' + sectionId));
    const slides = Array.from(track.children).filter(child => 
      child.classList.contains('wp-editorial-card-' + sectionId) || 
      child.classList.contains('wp-products-col-' + sectionId)
    );
    
    // 1. Click to scroll
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        if (slides[idx]) {
          slides[idx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }
      });
    });

    // 2. Observe scrolling to update dots
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const slideIdx = slides.indexOf(entry.target);
          if (slideIdx !== -1 && dots[slideIdx]) {
            dots.forEach(d => d.classList.remove('is-active'));
            dots[slideIdx].classList.add('is-active');
          }
        }
      });
    }, {
      root: track,
      threshold: 0.5 // trigger when 50% of the slide is visible
    });

    slides.forEach(slide => observer.observe(slide));
  }

  // AJAX Add to Cart Buttons
  const addButtons = document.querySelectorAll('#WeeklyPicks-' + sectionId + ' .wp-add-btn-' + sectionId);
  addButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      const variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;

      const self = this;
      self.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => res.json())
      .then(data => {
        self.classList.remove('is-loading');
        self.classList.add('is-added');
        setTimeout(() => self.classList.remove('is-added'), 2000);

        if (window.Shopify && Shopify.onItemAdded) {
          Shopify.onItemAdded(data);
        }
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            const countEl = document.getElementById('hfCartCount');
            if (countEl) {
              countEl.textContent = cart.item_count;
              countEl.style.display = cart.item_count > 0 ? 'inline-flex' : 'none';
            }
          }).catch(() => {});
      })
      .catch(() => {
        self.classList.remove('is-loading');
      });
    });
  });

})();
</script>

