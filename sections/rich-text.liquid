{% comment %}
  الحصيف - قسم تفاعلي بتجربة scroll storytelling
  يدعم إضافة كولكشن منتجات وأقسام الموقع من الإعدادات
{% endcomment %}

{{ 'hasif-section.css' | asset_url | stylesheet_tag }}

<div id="hasif-universe" class="hasif-universe">

  <!-- ======= SCROLL STORY ======= -->
  <div class="hasif-scroll-container" id="hasifScrollContainer">
    <div class="hasif-sticky-stage" id="hasifStage">
      
      <!-- الشعار الدائم -->
      <div class="hasif-logo-mark" id="hasifLogoMark">
        <div class="hasif-dots">
          <div class="dot dot-large"></div>
          <div class="dot dot-small"></div>
        </div>
      </div>

      <!-- الشرائح -->
      <div class="hasif-slides" id="hasifSlides">

        <!-- Slide 0: الرئيسية -->
        <div class="hasif-slide" data-slide="0">
          <div class="slide-content slide-hero">
            <div class="hasif-dots hero-dots">
              <div class="dot dot-large"></div>
              <div class="dot dot-small"></div>
            </div>
            <h1 class="hasif-title">الحصيف</h1>
            <p class="hasif-subtitle">مساحة تجمع بين روح الماضي<br>ووضوح الحاضر</p>
            <p class="hasif-body">
              نقدّم أشرطة كاسيت، كتبًا جديدة ومستعملة،<br>
              وقطعًا مختارة تحمل ذاكرة لا تُرى مباشرة...<br>
              <strong>بل تُحس.</strong>
            </p>
            <span class="hasif-since">منذ 2025</span>
            <div class="scroll-hint">
              <span>↓</span>
            </div>
          </div>
        </div>

        <!-- Slide 1 -->
        <div class="hasif-slide" data-slide="1">
          <div class="slide-content slide-centered">
            <p class="hasif-statement">
              لا نعرض الأشياء...<br>
              <strong>بل نعيد تقديمها بمعناها</strong>
            </p>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="hasif-slide" data-slide="2">
          <div class="slide-content slide-centered">
            <p class="hasif-statement">
              لسنا مهتمين بالشكل فقط،<br>
              <strong>بل بما تبقّى في هذه الأشياء من أثر وتجربة</strong>
            </p>
          </div>
        </div>

        <!-- Slide 3: مع فينيل -->
        <div class="hasif-slide" data-slide="3">
          <div class="slide-content slide-vinyl">
            <div class="vinyl-visual">
              <div class="vinyl-record">
                <div class="vinyl-grooves"></div>
                <div class="vinyl-label">
                  <div class="vinyl-label-inner"></div>
                </div>
                <div class="vinyl-hole"></div>
              </div>
            </div>
            <div class="vinyl-text">
              <p class="hasif-statement-side">
                كل قطعة تحمل أثرًا...<br>
                <strong>نحن نعيد إحياءه.</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Slide 4: مع كتاب -->
        <div class="hasif-slide" data-slide="4">
          <div class="slide-content slide-book">
            <div class="book-visual">
              <div class="book-pages">
                <div class="page page-1"></div>
                <div class="page page-2"></div>
                <div class="page page-3"></div>
                <div class="page page-4"></div>
                <div class="page page-5"></div>
              </div>
            </div>
            <div class="book-text">
              <p class="hasif-statement-side right-text">
                نميل إلى البساطة،<br>
                <strong>ونحترم التفاصيل.</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Slide 5: نهاية القصة + المنتجات -->
        <div class="hasif-slide slide-final" data-slide="5">
          <div class="slide-content slide-end">
            
            <!-- الشعار والنقاط -->
            <div class="final-logo">
              <div class="hasif-dots">
                <div class="dot dot-large"></div>
                <div class="dot dot-small"></div>
              </div>
              <span class="final-brand-name">الحصيف</span>
            </div>

            <!-- كولكشن المنتجات -->
            {% if section.settings.collection != blank %}
            <div class="hasif-products-section">
              <div class="hasif-products-grid">
                {% for product in section.settings.collection.products limit: section.settings.products_count %}
                <a href="{{ product.url }}" class="hasif-product-card">
                  <div class="product-card-inner">
                    <div class="product-img-wrap">
                      {% if product.featured_image %}
                        <img 
                          src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" 
                          alt="{{ product.title }}"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="product-no-img">
                          <div class="hasif-dots mini-dots">
                            <div class="dot dot-large"></div>
                            <div class="dot dot-small"></div>
                          </div>
                        </div>
                      {% endif %}
                      <div class="card-corner-ornament top-left"></div>
                      <div class="card-corner-ornament top-right"></div>
                      <div class="card-corner-ornament bottom-left"></div>
                      <div class="card-corner-ornament bottom-right"></div>
                    </div>
                    <div class="product-info">
                      <h3 class="product-title">{{ product.title }}</h3>
                      <p class="product-price">{{ product.price | money }}</p>
                    </div>
                  </div>
                </a>
                {% endfor %}
              </div>
            </div>
            {% endif %}

            <!-- أقسام الموقع -->
            <div class="hasif-nav-grid">
              {% for block in section.blocks %}
                {% if block.type == 'nav_item' %}
                <a href="{{ block.settings.link }}" class="hasif-nav-card" {{ block.shopify_attributes }}>
                  <div class="nav-card-ornament"></div>
                  <span class="nav-card-label">{{ block.settings.label }}</span>
                  <div class="nav-card-arrow">←</div>
                </a>
                {% endif %}
              {% endfor %}
            </div>

          </div>
        </div>

      </div><!-- end slides -->

      <!-- مؤشر التقدم -->
      <div class="hasif-progress" id="hasifProgress">
        <div class="progress-track">
          <div class="progress-fill" id="hasifProgressFill"></div>
        </div>
        <div class="progress-dots" id="hasifProgressDots">
          {% for i in (0..5) %}
          <div class="prog-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
          {% endfor %}
        </div>
      </div>

    </div><!-- end sticky stage -->
  </div><!-- end scroll container -->

</div><!-- end universe -->

<style>
/* ===== HASIF SECTION STYLES ===== */

@import url('https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap');

:root {
  --hasif-cream: #F0EDE6;
  --hasif-cream-dark: #E8E4DC;
  --hasif-ink: #1C1A17;
  --hasif-ink-soft: #3D3A35;
  --hasif-warm-gray: #B8B4AC;
  --hasif-dot-color: #C4BFB6;
  --hasif-accent: #8B7355;
  --hasif-font-arabic: 'Noto Naskh Arabic', serif;
  --hasif-font-latin: 'Cormorant Garamond', serif;
}

.hasif-universe {
  direction: rtl;
  background: var(--hasif-cream);
  font-family: var(--hasif-font-arabic);
  color: var(--hasif-ink);
  -webkit-font-smoothing: antialiased;
}

/* ===== SCROLL CONTAINER ===== */
.hasif-scroll-container {
  position: relative;
  height: 600vh;
}

.hasif-sticky-stage {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--hasif-cream);
}

/* Subtle paper texture */
.hasif-sticky-stage::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(ellipse at 20% 50%, rgba(180,170,155,0.08) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 20%, rgba(180,170,155,0.06) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* ===== LOGO MARK PERMANENT ===== */
.hasif-logo-mark {
  position: absolute;
  top: 48px;
  right: 50%;
  transform: translateX(50%);
  z-index: 20;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.hasif-logo-mark.visible {
  opacity: 1;
}

/* ===== DOTS ===== */
.hasif-dots {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  justify-content: center;
}

.dot {
  border-radius: 50%;
  background: var(--hasif-dot-color);
}

.dot-large {
  width: 44px;
  height: 44px;
}

.dot-small {
  width: 30px;
  height: 30px;
  margin-bottom: 4px;
}

.mini-dots .dot-large { width: 20px; height: 20px; }
.mini-dots .dot-small { width: 14px; height: 14px; }

/* ===== SLIDES ===== */
.hasif-slides {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hasif-slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
}

.hasif-slide.active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.hasif-slide.exit-up {
  opacity: 0;
  transform: translateY(-30px);
}

.hasif-slide.exit-down {
  opacity: 0;
  transform: translateY(30px);
}

.slide-content {
  text-align: center;
  padding: 40px 24px;
  max-width: 600px;
  width: 100%;
}

/* ===== SLIDE HERO ===== */
.slide-hero .hero-dots {
  margin-bottom: 32px;
}

.slide-hero .hero-dots .dot-large {
  width: 56px;
  height: 56px;
}

.slide-hero .hero-dots .dot-small {
  width: 38px;
  height: 38px;
}

.hasif-title {
  font-family: var(--hasif-font-arabic);
  font-size: clamp(3rem, 10vw, 5.5rem);
  font-weight: 700;
  color: var(--hasif-ink);
  margin: 0 0 8px;
  letter-spacing: -0.01em;
  line-height: 1;
}

.hasif-subtitle {
  font-size: clamp(1.1rem, 3.5vw, 1.5rem);
  font-weight: 500;
  color: var(--hasif-ink);
  margin: 0 0 24px;
  line-height: 1.7;
}

.hasif-body {
  font-size: clamp(0.9rem, 2.5vw, 1.1rem);
  color: var(--hasif-ink-soft);
  line-height: 2;
  margin: 0 0 24px;
}

.hasif-body strong {
  font-weight: 700;
  color: var(--hasif-ink);
}

.hasif-since {
  font-family: var(--hasif-font-latin);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--hasif-warm-gray);
  letter-spacing: 0.05em;
}

.scroll-hint {
  margin-top: 32px;
  animation: bounceDown 2s ease-in-out infinite;
  color: var(--hasif-warm-gray);
  font-size: 1.2rem;
}

@keyframes bounceDown {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50% { transform: translateY(6px); opacity: 1; }
}

/* ===== CENTERED SLIDES ===== */
.slide-centered {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hasif-statement {
  font-size: clamp(1.2rem, 4vw, 2rem);
  color: var(--hasif-ink-soft);
  line-height: 2;
  margin: 0;
  font-weight: 400;
}

.hasif-statement strong {
  display: block;
  font-weight: 700;
  color: var(--hasif-ink);
  font-size: 1.05em;
}

/* ===== VINYL SLIDE ===== */
.slide-vinyl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48px;
  max-width: 800px;
  text-align: right;
}

.vinyl-visual {
  flex-shrink: 0;
}

.vinyl-record {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: linear-gradient(135deg, #D8D4CC 0%, #C8C4BC 30%, #D4D0C8 60%, #C0BDB5 100%);
  position: relative;
  box-shadow: 
    inset 0 0 0 2px rgba(255,255,255,0.2),
    0 8px 32px rgba(28,26,23,0.15);
  animation: vinylSpin 8s linear infinite paused;
}

.slide-vinyl.active .vinyl-record {
  animation-play-state: running;
}

@keyframes vinylSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.vinyl-grooves {
  position: absolute;
  inset: 8px;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle at center,
    transparent 0px,
    transparent 3px,
    rgba(28,26,23,0.04) 3px,
    rgba(28,26,23,0.04) 4px
  );
}

.vinyl-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: var(--hasif-cream);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vinyl-label-inner {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--hasif-cream-dark);
  border: 1px solid var(--hasif-dot-color);
}

.vinyl-hole {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--hasif-ink);
}

.hasif-statement-side {
  font-size: clamp(1rem, 3vw, 1.6rem);
  color: var(--hasif-ink-soft);
  line-height: 2;
  margin: 0;
  font-weight: 400;
}

.hasif-statement-side strong {
  display: block;
  font-weight: 700;
  color: var(--hasif-ink);
}

.vinyl-text {
  flex: 1;
}

/* ===== BOOK SLIDE ===== */
.slide-book {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 48px;
  max-width: 800px;
  padding-bottom: 60px;
}

.book-visual {
  flex-shrink: 0;
  align-self: flex-end;
}

.book-pages {
  display: flex;
  align-items: flex-end;
  position: relative;
  width: 160px;
  height: 120px;
}

.page {
  position: absolute;
  bottom: 0;
  width: 140px;
  background: linear-gradient(to right, #EAE6DE, #F4F0E8);
  border-radius: 0 8px 0 0;
  transform-origin: bottom left;
  box-shadow: 1px 0 2px rgba(28,26,23,0.08);
}

.page-1 { height: 110px; left: 0px; transform: rotate(-12deg); opacity: 0.4; }
.page-2 { height: 115px; left: 5px; transform: rotate(-6deg); opacity: 0.6; }
.page-3 { height: 118px; left: 10px; transform: rotate(-2deg); opacity: 0.8; }
.page-4 { height: 120px; left: 14px; transform: rotate(0deg); }
.page-5 { height: 116px; left: 18px; transform: rotate(3deg); opacity: 0.7; background: linear-gradient(to right, #E8E4DC, #F0ECE4); }

.book-text {
  flex: 1;
  text-align: right;
}

.right-text {
  text-align: right;
}

/* ===== FINAL SLIDE ===== */
.slide-final {
  overflow-y: auto;
  align-items: flex-start;
  padding-top: 20px;
}

.slide-end {
  padding: 0;
  max-width: 100%;
  width: 100%;
}

.final-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 48px 24px 32px;
}

.final-brand-name {
  font-family: var(--hasif-font-arabic);
  font-size: 2rem;
  font-weight: 700;
  color: var(--hasif-ink);
  letter-spacing: -0.01em;
}

/* ===== PRODUCTS ===== */
.hasif-products-section {
  padding: 0 24px 32px;
}

.hasif-products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
  max-width: 900px;
  margin: 0 auto;
}

@media (max-width: 480px) {
  .hasif-products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
}

.hasif-product-card {
  text-decoration: none;
  color: inherit;
  display: block;
}

.product-card-inner {
  background: var(--hasif-cream-dark);
  border: 1px solid rgba(180,170,155,0.4);
  border-radius: 4px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.hasif-product-card:hover .product-card-inner {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(28,26,23,0.12);
}

.product-img-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--hasif-cream);
}

.product-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.hasif-product-card:hover .product-img-wrap img {
  transform: scale(1.04);
}

/* Card corner ornaments - هوية الحصيف */
.card-corner-ornament {
  position: absolute;
  width: 16px;
  height: 16px;
  z-index: 2;
  pointer-events: none;
}

.card-corner-ornament.top-left {
  top: 6px; left: 6px;
  border-top: 1.5px solid rgba(180,170,155,0.6);
  border-left: 1.5px solid rgba(180,170,155,0.6);
}

.card-corner-ornament.top-right {
  top: 6px; right: 6px;
  border-top: 1.5px solid rgba(180,170,155,0.6);
  border-right: 1.5px solid rgba(180,170,155,0.6);
}

.card-corner-ornament.bottom-left {
  bottom: 6px; left: 6px;
  border-bottom: 1.5px solid rgba(180,170,155,0.6);
  border-left: 1.5px solid rgba(180,170,155,0.6);
}

.card-corner-ornament.bottom-right {
  bottom: 6px; right: 6px;
  border-bottom: 1.5px solid rgba(180,170,155,0.6);
  border-right: 1.5px solid rgba(180,170,155,0.6);
}

.product-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--hasif-cream);
}

.product-info {
  padding: 12px 14px;
}

.product-title {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--hasif-ink);
  margin: 0 0 4px;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  font-family: var(--hasif-font-latin);
  font-size: 0.85rem;
  color: var(--hasif-accent);
  margin: 0;
  font-weight: 500;
}

/* ===== NAV GRID ===== */
.hasif-nav-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
  padding: 0 24px 48px;
  max-width: 900px;
  margin: 0 auto;
}

.hasif-nav-card {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 24px 16px;
  background: transparent;
  border: 1px solid rgba(180,170,155,0.5);
  border-radius: 4px;
  color: var(--hasif-ink-soft);
  transition: all 0.3s ease;
  position: relative;
  text-align: center;
  min-height: 80px;
}

.hasif-nav-card::before,
.hasif-nav-card::after {
  content: '';
  position: absolute;
  width: 10px;
  height: 10px;
  border-color: var(--hasif-dot-color);
  border-style: solid;
  transition: all 0.3s ease;
}

.hasif-nav-card::before {
  top: 5px; right: 5px;
  border-width: 1px 1px 0 0;
}

.hasif-nav-card::after {
  bottom: 5px; left: 5px;
  border-width: 0 0 1px 1px;
}

.hasif-nav-card:hover {
  background: var(--hasif-cream-dark);
  color: var(--hasif-ink);
  border-color: rgba(139,115,85,0.4);
  transform: translateY(-2px);
}

.nav-card-ornament {
  width: 16px;
  height: 2px;
  background: var(--hasif-dot-color);
  border-radius: 1px;
}

.nav-card-label {
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.4;
}

.nav-card-arrow {
  font-size: 0.8rem;
  color: var(--hasif-warm-gray);
  transition: transform 0.3s ease;
}

.hasif-nav-card:hover .nav-card-arrow {
  transform: translateX(-4px);
  color: var(--hasif-accent);
}

/* ===== PROGRESS ===== */
.hasif-progress {
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  z-index: 30;
}

.progress-track {
  width: 1px;
  height: 120px;
  background: rgba(180,170,155,0.3);
  border-radius: 1px;
  overflow: hidden;
}

.progress-fill {
  width: 100%;
  background: var(--hasif-ink-soft);
  border-radius: 1px;
  transition: height 0.1s linear;
  height: 0%;
}

.progress-dots {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.prog-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--hasif-dot-color);
  transition: background 0.3s ease, transform 0.3s ease;
  cursor: pointer;
}

.prog-dot.active {
  background: var(--hasif-ink);
  transform: scale(1.4);
}

@media (max-width: 480px) {
  .hasif-progress { left: 10px; }
}

/* ===== VINYL/BOOK RESPONSIVE ===== */
@media (max-width: 600px) {
  .slide-vinyl, .slide-book {
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  
  .vinyl-record { width: 140px; height: 140px; }
  
  .vinyl-text, .book-text {
    text-align: center;
  }
  
  .right-text { text-align: center; }
  
  .slide-book { padding-bottom: 30px; }
}
</style>

<script>
(function() {
  'use strict';
  
  const TOTAL_SLIDES = 6;
  
  const container = document.getElementById('hasifScrollContainer');
  const slides = document.querySelectorAll('.hasif-slide');
  const progressFill = document.getElementById('hasifProgressFill');
  const progDots = document.querySelectorAll('.prog-dot');
  const logoMark = document.getElementById('hasifLogoMark');
  const finalSlide = document.querySelector('.slide-final');
  
  let currentSlide = 0;
  let isAnimating = false;
  let lastScrollY = window.scrollY;
  
  function getScrollProgress() {
    const rect = container.getBoundingClientRect();
    const containerTop = container.offsetTop;
    const scrolled = window.scrollY - containerTop;
    const maxScroll = container.offsetHeight - window.innerHeight;
    return Math.max(0, Math.min(1, scrolled / maxScroll));
  }
  
  function goToSlide(index, direction) {
    if (index < 0 || index >= TOTAL_SLIDES || isAnimating) return;
    if (index === currentSlide) return;
    
    isAnimating = true;
    
    const prevSlide = slides[currentSlide];
    const nextSlide = slides[index];
    
    // Exit current
    if (prevSlide) {
      prevSlide.classList.remove('active');
      if (direction === 'down') {
        prevSlide.classList.add('exit-up');
      } else {
        prevSlide.classList.add('exit-down');
      }
    }
    
    // Enter next - set initial state
    if (nextSlide) {
      nextSlide.classList.remove('exit-up', 'exit-down');
      
      // Pre-position
      if (direction === 'down') {
        nextSlide.style.transform = 'translateY(30px)';
      } else {
        nextSlide.style.transform = 'translateY(-30px)';
      }
      nextSlide.style.opacity = '0';
      
      // Force reflow
      nextSlide.getBoundingClientRect();
      
      nextSlide.style.transform = '';
      nextSlide.style.opacity = '';
      nextSlide.classList.add('active');
    }
    
    currentSlide = index;
    
    // Update progress dots
    progDots.forEach((d, i) => {
      d.classList.toggle('active', i === index);
    });
    
    // Update progress bar
    progressFill.style.height = ((index / (TOTAL_SLIDES - 1)) * 100) + '%';
    
    // Show/hide logo mark (visible on slides 1+)
    if (index > 0 && index < TOTAL_SLIDES - 1) {
      logoMark.classList.add('visible');
    } else {
      logoMark.classList.remove('visible');
    }
    
    // Clean up
    setTimeout(() => {
      if (prevSlide) {
        prevSlide.classList.remove('exit-up', 'exit-down');
        prevSlide.style.transform = '';
        prevSlide.style.opacity = '';
      }
      isAnimating = false;
    }, 750);
  }
  
  function updateFromScroll() {
    const progress = getScrollProgress();
    const targetSlide = Math.round(progress * (TOTAL_SLIDES - 1));
    const direction = window.scrollY > lastScrollY ? 'down' : 'up';
    lastScrollY = window.scrollY;
    
    if (targetSlide !== currentSlide) {
      goToSlide(targetSlide, direction);
    }
  }
  
  // Initialize
  slides[0].classList.add('active');
  
  // Scroll listener
  let ticking = false;
  window.addEventListener('scroll', () => {
    lastScrollY = window.scrollY;
    if (!ticking) {
      requestAnimationFrame(() => {
        updateFromScroll();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
  
  // Progress dot clicks - scroll to position
  progDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      const containerTop = container.offsetTop;
      const maxScroll = container.offsetHeight - window.innerHeight;
      const targetScroll = containerTop + (i / (TOTAL_SLIDES - 1)) * maxScroll;
      window.scrollTo({ top: targetScroll, behavior: 'smooth' });
    });
  });
  
  // Touch support
  let touchStartY = 0;
  let touchStartScrollY = 0;
  
  document.getElementById('hasifStage').addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
    touchStartScrollY = window.scrollY;
  }, { passive: true });
  
})();
</script>

