{% comment %} Hero Cinematic Slideshow Section {% endcomment %}

<div class="hs-hero" id="HeroSlideshow-{{ section.id }}">

  <div class="hs-track">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}

        {%- comment -%} حساب رابط الزر الأول {%- endcomment -%}
        {%- if block.settings.button_collection != blank -%}
          {%- assign btn1_url = block.settings.button_collection.url -%}
        {%- elsif block.settings.button_link != blank -%}
          {%- assign btn1_url = block.settings.button_link -%}
        {%- else -%}
          {%- assign btn1_url = '' -%}
        {%- endif -%}

        {%- if block.settings.button2_collection != blank -%}
          {%- assign btn2_url = block.settings.button2_collection.url -%}
        {%- elsif block.settings.button2_link != blank -%}
          {%- assign btn2_url = block.settings.button2_link -%}
        {%- else -%}
          {%- assign btn2_url = '' -%}
        {%- endif -%}

        <div class="hs-slide{% if forloop.first %} hs-slide--active{% endif %}" {{ block.shopify_attributes }}>

          <div class="hs-slide__bg">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1600 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 750 }} 750w,
                  {{ block.settings.image | image_url: width: 1100 }} 1100w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w
                "
                sizes="100vw"
                alt="{{ block.settings.image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hs-placeholder' }}
            {%- endif -%}
          </div>

          <div class="hs-slide__overlay"></div>

          <div class="hs-slide__content">
            <div class="hs-slide__inner">
              {%- if block.settings.label != blank -%}
                <p class="hs-slide__label">{{ block.settings.label }}</p>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h2 class="hs-slide__title">{{ block.settings.title }}</h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="hs-slide__desc">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank and btn1_url != '' -%}
                <div class="hs-slide__actions">
                  <a href="{{ btn1_url }}" class="hs-btn hs-btn--primary">
                    {{ block.settings.button_label }}
                  </a>
                  {%- if block.settings.button2_label != blank and btn2_url != '' -%}
                    <a href="{{ btn2_url }}" class="hs-btn hs-btn--ghost">
                      {{ block.settings.button2_label }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hs-slide hs-slide--active">
        <div class="hs-slide__bg">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hs-placeholder' }}
        </div>
        <div class="hs-slide__overlay"></div>
        <div class="hs-slide__content">
          <div class="hs-slide__inner">
            <h2 class="hs-slide__title">أضف شريحة من مخصص القالب</h2>
            <p class="hs-slide__desc">اضغط على "إضافة شريحة" لتخصيص هذا القسم بصورك ونصوصك</p>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hs-nav hs-nav--prev" id="hs-prev-{{ section.id }}" aria-label="السابق">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    <button class="hs-nav hs-nav--next" id="hs-next-{{ section.id }}" aria-label="التالي">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="hs-dots" id="hs-dots-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button class="hs-dot{% if forloop.first %} hs-dot--active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="الشريحة {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<style>
.hs-hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #111;
  height: {% if section.settings.height == 'small' %}50vh{% elsif section.settings.height == 'large' %}90vh{% else %}70vh{% endif %};
  min-height: 360px;
  max-height: 860px;
  direction: rtl;
}

.hs-track {
  position: absolute;
  inset: 0;
}

/* ── Slides ── */
.hs-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.8s ease;
  pointer-events: none;
}
.hs-slide--active {
  opacity: 1;
  pointer-events: auto;
}

/* ── Background ── */
.hs-slide__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hs-slide__bg img,
.hs-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* ── Overlay ── */
.hs-slide__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to left,
    rgba(0,0,0,0.82) 0%,
    rgba(0,0,0,0.50) 40%,
    rgba(0,0,0,0.10) 100%
  );
}

/* ── Content ── */
.hs-slide__content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: none;
}
.hs-slide__inner {
  width: 100%;
  max-width: 560px;
  padding: 3rem 4% 3rem 2%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: auto;
  text-align: right;
}

.hs-slide__label {
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: .1em;
  color: rgba(255,255,255,.7);
  margin: 0 0 .8rem;
  text-transform: uppercase;
}

.hs-slide__title {
  font-size: clamp(2.6rem, 4.5vw, 5.4rem);
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  margin: 0 0 1rem;
  text-shadow: 0 2px 20px rgba(0,0,0,.5);
}

.hs-slide__desc {
  font-size: clamp(1.3rem, 1.5vw, 1.6rem);
  color: rgba(255,255,255,.82);
  line-height: 1.7;
  margin: 0 0 2rem;
}

/* ── Action Buttons ── */
.hs-slide__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
}
.hs-btn {
  display: inline-flex;
  align-items: center;
  padding: .85rem 2.4rem;
  border-radius: 10rem;
  font-size: 1.4rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: transform .15s ease, box-shadow .15s ease;
  white-space: nowrap;
  border: none;
}
.hs-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
}
.hs-btn--primary {
  background: #fff;
  color: #111;
}
.hs-btn--ghost {
  background: rgba(255,255,255,.15);
  color: #fff;
  border: 2px solid rgba(255,255,255,.5);
  backdrop-filter: blur(6px);
}

/* ── Nav Arrows ── */
.hs-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 4.4rem;
  height: 4.4rem;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,.15);
  backdrop-filter: blur(8px);
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s;
  opacity: .75;
}
.hs-nav:hover { background: rgba(255,255,255,.3); opacity: 1; }
.hs-nav svg { width: 2.2rem; height: 2.2rem; }
.hs-nav--prev { right: 1.6rem; }
.hs-nav--next { left: 1.6rem; }

/* ── Dots ── */
.hs-dots {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: .6rem;
  z-index: 10;
}
.hs-dot {
  width: 3rem;
  height: .4rem;
  border-radius: 10rem;
  background: rgba(255,255,255,.35);
  border: none;
  cursor: pointer;
  transition: background .3s, width .3s;
  padding: 0;
}
.hs-dot--active { background: #fff; width: 5rem; }

/* ── Mobile ── */
@media screen and (max-width: 749px) {
  .hs-hero { height: 58vh; }
  .hs-slide__overlay {
    background: linear-gradient(to top, rgba(0,0,0,.88) 0%, rgba(0,0,0,.3) 55%, transparent 100%);
  }
  .hs-slide__content { align-items: flex-end; justify-content: flex-end; }
  .hs-slide__inner { max-width: 100%; padding: 2rem 1.6rem 6rem; }
  .hs-nav { display: none; }
}
</style>

<script>
(function() {
  var sid   = '{{ section.id }}';
  var total = {{ section.blocks.size | default: 1 }};
  var cur   = 0;
  var timer = null;
  var AUTO  = {{ section.settings.auto_rotate | default: true }} === true;
  var SPEED = {{ section.settings.autoplay_speed | default: 5 }} * 1000;

  var hero = document.getElementById('HeroSlideshow-' + sid);
  if (!hero) return;

  function allSlides() { return hero.querySelectorAll('.hs-slide'); }
  function allDots()   { return document.querySelectorAll('#hs-dots-' + sid + ' .hs-dot'); }

  function goTo(idx) {
    allSlides().forEach(function(s, i) { s.classList.toggle('hs-slide--active', i === idx); });
    allDots().forEach(function(d, i)   { d.classList.toggle('hs-dot--active', i === idx); });
    cur = idx;
  }

  function next() { goTo((cur + 1) % total); }
  function prev() { goTo((cur - 1 + total) % total); }

  function startAuto() {
    if (!AUTO || total < 2) return;
    timer = setInterval(next, SPEED);
  }
  function resetAuto() { clearInterval(timer); startAuto(); }

  var btnP = document.getElementById('hs-prev-' + sid);
  var btnN = document.getElementById('hs-next-' + sid);
  if (btnP) btnP.addEventListener('click', function() { prev(); resetAuto(); });
  if (btnN) btnN.addEventListener('click', function() { next(); resetAuto(); });

  allDots().forEach(function(d) {
    d.addEventListener('click', function() { goTo(+this.dataset.index); resetAuto(); });
  });

  var tx = null;
  hero.addEventListener('touchstart', function(e) { tx = e.touches[0].clientX; }, { passive: true });
  hero.addEventListener('touchend', function(e) {
    if (tx === null) return;
    var d = tx - e.changedTouches[0].clientX;
    if (Math.abs(d) > 40) { d > 0 ? next() : prev(); resetAuto(); }
    tx = null;
  }, { passive: true });

  startAuto();
})();
</script>

{% schema %}
{
  "name": "Hero Slideshow",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "ارتفاع القسم",
      "options": [
        { "value": "small",  "label": "صغير (50vh)" },
        { "value": "medium", "label": "متوسط (70vh)" },
        { "value": "large",  "label": "كبير (90vh)" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "تشغيل تلقائي",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "سرعة الانتقال بين الشرائح",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 5,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "شريحة",
      "settings": [
        {
          "type": "header",
          "content": "📷 الصورة"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "اختر صورة الشريحة"
        },
        {
          "type": "header",
          "content": "✏️ النص"
        },
        {
          "type": "text",
          "id": "label",
          "label": "تصنيف صغير (اختياري)",
          "info": "مثال: 🔥 الأكثر مبيعاً"
        },
        {
          "type": "text",
          "id": "title",
          "label": "العنوان الرئيسي"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "وصف قصير"
        },
        {
          "type": "header",
          "content": "🔗 الزر الأول"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "نص الزر",
          "default": "اكتشف الآن"
        },
        {
          "type": "collection",
          "id": "button_collection",
          "label": "اختر كوليكشن (الأولوية)",
          "info": "إذا اخترت كوليكشن سيتجاهل الرابط اليدوي"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "أو أدخل رابط يدوياً"
        },
        {
          "type": "header",
          "content": "🔗 الزر الثاني (اختياري)"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "نص الزر الثاني"
        },
        {
          "type": "collection",
          "id": "button2_collection",
          "label": "اختر كوليكشن (الأولوية)"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "أو أدخل رابط يدوياً"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
