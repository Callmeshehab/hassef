{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ch-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    padding: 40px 20px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    direction: rtl;
    width: 100%;
    box-sizing: border-box;
  }

  .ch-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ─── HEADER ─── */
  .ch-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ch-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 700;
    position: relative;
    display: inline-block;
  }

  .ch-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  /* Palestinian embroidery pixel divider */
  .ch-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 16px;
    margin: 24px 0;
    background-image: repeating-linear-gradient(
      90deg,
      {{ block.settings.accent_color_1 }} 0px, {{ block.settings.accent_color_1 }} 4px,
      transparent 4px, transparent 8px,
      {{ block.settings.accent_color_2 }} 8px, {{ block.settings.accent_color_2 }} 12px,
      transparent 12px, transparent 16px,
      {{ block.settings.accent_color_3 }} 16px, {{ block.settings.accent_color_3 }} 20px,
      transparent 20px, transparent 24px,
      {{ block.settings.accent_color_1 }} 24px, {{ block.settings.accent_color_1 }} 28px,
      transparent 28px, transparent 32px
    );
    opacity: 0.8;
  }

  /* ─── LOGIN NOTICE ─── */
  .ch-login-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 32px;
    text-align: center;
    margin-bottom: 40px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
  }

  .ch-login-{{ ai_gen_id }} h3 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-size: 22px;
  }

  .ch-btn-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text }} !important;
    padding: 12px 32px;
    border-radius: {{ block.settings.button_radius }}px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    transition: transform 0.15s, box-shadow 0.15s;
    cursor: pointer;
    font-family: inherit;
  }

  .ch-btn-{{ ai_gen_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: {{ block.settings.shadow_x | plus: 2 }}px {{ block.settings.shadow_y | plus: 2 }}px 0 {{ block.settings.shadow_color }};
  }

  .ch-btn-outline-{{ ai_gen_id }} {
    background: transparent;
    color: {{ block.settings.title_color }} !important;
  }

  /* ─── TABS ─── */
  .ch-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ch-tab-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg }};
    color: {{ block.settings.tab_text }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    padding: 10px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font-weight: 600;
    font-family: inherit;
    font-size: 14px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    transition: all 0.15s;
  }

  .ch-tab-{{ ai_gen_id }}:hover {
    transform: translate(-1px, -1px);
  }

  .ch-tab-{{ ai_gen_id }}.active {
    background: {{ block.settings.tab_active_bg }};
    color: {{ block.settings.tab_active_text }};
  }

  .ch-tab-panel-{{ ai_gen_id }} { display: none; }
  .ch-tab-panel-{{ ai_gen_id }}.active { display: block; }

  /* ─── FORM CARD ─── */
  .ch-form-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 28px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    margin-bottom: 32px;
  }

  .ch-form-card-{{ ai_gen_id }} h3 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-size: 19px;
  }

  .ch-field-{{ ai_gen_id }} { margin-bottom: 18px; }

  .ch-field-{{ ai_gen_id }} label {
    display: block;
    color: {{ block.settings.text_color }};
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 14px;
  }

  .ch-input-{{ ai_gen_id }},
  .ch-textarea-{{ ai_gen_id }},
  .ch-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 14px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    font-family: inherit;
    font-size: 14px;
    background: #fff;
    color: #333;
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.08);
    box-sizing: border-box;
    direction: rtl;
    transition: border-color 0.2s;
  }

  .ch-input-{{ ai_gen_id }}:focus,
  .ch-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_bg }};
  }

  .ch-textarea-{{ ai_gen_id }} {
    min-height: 96px;
    resize: vertical;
  }

  /* Image upload area */
  .ch-upload-area-{{ ai_gen_id }} {
    border: 2px dashed {{ block.settings.border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    padding: 28px;
    text-align: center;
    cursor: pointer;
    background: #fff;
    transition: background 0.2s;
    position: relative;
  }

  .ch-upload-area-{{ ai_gen_id }}:hover {
    background: {{ block.settings.background_color }};
  }

  .ch-upload-area-{{ ai_gen_id }} input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .ch-upload-icon-{{ ai_gen_id }} {
    font-size: 36px;
    margin-bottom: 8px;
    display: block;
  }

  .ch-upload-preview-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 200px;
    border-radius: {{ block.settings.input_radius }}px;
    margin-top: 12px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    display: none;
  }

  .ch-upload-progress-{{ ai_gen_id }} {
    height: 6px;
    background: #eee;
    border-radius: 3px;
    margin-top: 10px;
    overflow: hidden;
    display: none;
  }

  .ch-upload-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background: {{ block.settings.button_bg }};
    width: 0;
    transition: width 0.3s;
    border-radius: 3px;
  }

  .ch-hint-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.meta_color }};
    margin-top: 4px;
  }

  .ch-submit-{{ ai_gen_id }} {
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    padding: 13px 32px;
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    font-family: inherit;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    transition: transform 0.15s, box-shadow 0.15s;
    width: 100%;
  }

  .ch-submit-{{ ai_gen_id }}:hover:not(:disabled) {
    transform: translate(-2px, -2px);
    box-shadow: {{ block.settings.shadow_x | plus: 2 }}px {{ block.settings.shadow_y | plus: 2 }}px 0 {{ block.settings.shadow_color }};
  }

  .ch-submit-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ch-success-{{ ai_gen_id }} {
    background: #d4edda;
    border: 2px solid #28a745;
    color: #155724;
    padding: 14px;
    border-radius: {{ block.settings.input_radius }}px;
    margin-bottom: 16px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
  }

  .ch-error-{{ ai_gen_id }} {
    background: #f8d7da;
    border: 2px solid #dc3545;
    color: #721c24;
    padding: 14px;
    border-radius: {{ block.settings.input_radius }}px;
    margin-bottom: 16px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
  }

  /* ─── SEARCH BAR ─── */
  .ch-search-wrap-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 24px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .ch-search-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 44px 12px 16px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: 50px;
    font-family: inherit;
    font-size: 14px;
    background: {{ block.settings.card_bg }};
    box-sizing: border-box;
    direction: rtl;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
  }

  .ch-search-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_bg }};
  }

  .ch-search-icon-{{ ai_gen_id }} {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: {{ block.settings.meta_color }};
    pointer-events: none;
  }

  /* ─── MASONRY GRID ─── */
  .ch-masonry-{{ ai_gen_id }} {
    columns: 3;
    column-gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .ch-masonry-{{ ai_gen_id }} { columns: 2; }
  }

  @media (max-width: 580px) {
    .ch-masonry-{{ ai_gen_id }} { columns: 1; }
  }

  .ch-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 18px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    break-inside: avoid;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .ch-card-{{ ai_gen_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: {{ block.settings.shadow_x | plus: 2 }}px {{ block.settings.shadow_y | plus: 2 }}px 0 {{ block.settings.shadow_color }};
  }

  /* Embroidery top stripe */
  .ch-card-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    width: 100%;
    height: 6px;
    margin: -18px -18px 14px;
    width: calc(100% + 36px);
    background: repeating-linear-gradient(
      90deg,
      {{ block.settings.accent_color_1 }} 0 4px,
      {{ block.settings.accent_color_2 }} 4px 8px,
      {{ block.settings.accent_color_3 }} 8px 12px
    );
  }

  .ch-card-img-{{ ai_gen_id }} {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: {{ block.settings.input_radius }}px;
  border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  margin-bottom: 12px;
  display: block;
  cursor: pointer;
}}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    margin-bottom: 12px;
    display: block;
  }

  .ch-card-type-badge-{{ ai_gen_id }} {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 10px;
    background: {{ block.settings.accent_color_1 }};
    color: #fff;
    letter-spacing: 0.5px;
  }

  .ch-card-quote-{{ ai_gen_id }} {
    font-size: 17px;
    color: {{ block.settings.text_color }};
    font-style: italic;
    line-height: 1.65;
    margin-bottom: 10px;
  }

  .ch-card-book-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.meta_color }};
    margin-bottom: 10px;
  }

  .ch-card-text-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 10px;
  }

  .ch-card-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: 17px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 700;
  }

  .ch-card-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px dashed {{ block.settings.border_color }};
    margin-top: 10px;
    font-size: 12px;
    color: {{ block.settings.meta_color }};
    flex-wrap: wrap;
    gap: 8px;
  }

  .ch-card-author-{{ ai_gen_id }} {
    font-weight: 700;
    color: {{ block.settings.title_color }};
  }

  /* ─── LIKE BUTTON ─── */
  .ch-like-btn-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 20px;
    padding: 4px 12px;
    cursor: pointer;
    font-size: 13px;
    font-family: inherit;
    color: {{ block.settings.meta_color }};
    transition: all 0.2s;
  }

  .ch-like-btn-{{ ai_gen_id }}:hover,
  .ch-like-btn-{{ ai_gen_id }}.liked {
    background: #fee;
    border-color: #e05;
    color: #e05;
  }

  .ch-like-btn-{{ ai_gen_id }} svg {
    transition: transform 0.2s;
  }

  .ch-like-btn-{{ ai_gen_id }}.liked svg {
    transform: scale(1.2);
    fill: #e05;
    stroke: #e05;
  }

  /* ─── LOAD MORE ─── */
  .ch-load-more-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 28px;
  }

  /* ─── EMPTY STATE ─── */
  .ch-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 56px 20px;
    color: {{ block.settings.meta_color }};
    font-style: italic;
    font-size: 15px;
  }

  /* ─── LOADING SPINNER ─── */
  .ch-spinner-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    padding: 40px;
  }

  .ch-spinner-{{ ai_gen_id }}::after {
    content: '';
    width: 36px;
    height: 36px;
    border: 3px solid {{ block.settings.border_color }};
    border-top-color: {{ block.settings.button_bg }};
    border-radius: 50%;
    animation: ch-spin-{{ ai_gen_id }} 0.7s linear infinite;
  }

  @keyframes ch-spin-{{ ai_gen_id }} {
    to { transform: rotate(360deg); }
  }

  /* ─── SECTION TITLE ─── */
  .ch-section-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: 30px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0 0 28px;
    font-weight: 700;
  }

  /* ─── BLOG SECTION ─── */
  .ch-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }

  .ch-blog-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_bg }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px 0 {{ block.settings.shadow_color }};
    transition: transform 0.2s, box-shadow 0.2s;
    text-decoration: none;
    display: block;
  }

  .ch-blog-card-{{ ai_gen_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: {{ block.settings.shadow_x | plus: 2 }}px {{ block.settings.shadow_y | plus: 2 }}px 0 {{ block.settings.shadow_color }};
  }

  .ch-blog-img-{{ ai_gen_id }} {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .ch-blog-body-{{ ai_gen_id }} { padding: 18px; }

  .ch-blog-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: 18px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ch-blog-excerpt-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 10px;
  }

  .ch-blog-date-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.meta_color }};
  }

  /* ─── CONFIG MISSING WARNING ─── */
  .ch-config-warn-{{ ai_gen_id }} {
    background: #fff3cd;
    border: 2px solid #ffc107;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    color: #856404;
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .ch-title-{{ ai_gen_id }} { font-size: {{ block.settings.title_size | times: 0.75 | round }}px; }
    .ch-section-title-{{ ai_gen_id }} { font-size: 22px; }
    .ch-tabs-{{ ai_gen_id }} { flex-direction: column; }
    .ch-tab-{{ ai_gen_id }} { width: 100%; text-align: center; }
  }
{% endstyle %}

{% assign supabase_ok = false %}
{% if block.settings.supabase_url != blank and block.settings.supabase_key != blank %}
  {% assign supabase_ok = true %}
{% endif %}

<div class="ch-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ch-container-{{ ai_gen_id }}">

    <!-- HEADER -->
    <div class="ch-header-{{ ai_gen_id }}">
      <h2 class="ch-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      <p class="ch-subtitle-{{ ai_gen_id }}">{{ block.settings.main_subtitle }}</p>
    </div>
    <div class="ch-divider-{{ ai_gen_id }}"></div>

    {% unless supabase_ok %}
      <div class="ch-config-warn-{{ ai_gen_id }}">
        ⚠️ يرجى إدخال Supabase URL و API Key في إعدادات البلوك لتفعيل الفيد التلقائي. راجع التعليقات في أعلى الملف.
      </div>
    {% endunless %}

    <!-- MEMBER / GUEST SUBMISSION SECTION -->
    {% if customer or block.settings.allow_guest_posts %}
      <div id="ch-submit-section-{{ ai_gen_id }}">

        {% unless customer %}
          <!-- Guest name input (shown above tabs) -->
          <div class="ch-form-card-{{ ai_gen_id }}" style="margin-bottom:16px;">
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-guest-name-{{ ai_gen_id }}">اسمك المستعار *</label>
              <input type="text" id="ch-guest-name-{{ ai_gen_id }}"
                     class="ch-input-{{ ai_gen_id }}"
                     placeholder="كيف تريد أن تُعرَّف في المجتمع؟"
                     maxlength="40" required>
            </div>
          </div>
        {% endunless %}

        <!-- TABS -->
        <div class="ch-tabs-{{ ai_gen_id }}" role="tablist" data-ch-tabs="submit-{{ ai_gen_id }}">
          <button class="ch-tab-{{ ai_gen_id }} active"
                  data-ch-tab="photos-submit"
                  data-ch-tabs="submit-{{ ai_gen_id }}"
                  role="tab">{{ block.settings.tab_photos_title }}</button>
          <button class="ch-tab-{{ ai_gen_id }}"
                  data-ch-tab="quotes-submit"
                  data-ch-tabs="submit-{{ ai_gen_id }}"
                  role="tab">{{ block.settings.tab_quotes_title }}</button>
          <button class="ch-tab-{{ ai_gen_id }}"
                  data-ch-tab="comments-submit"
                  data-ch-tabs="submit-{{ ai_gen_id }}"
                  role="tab">{{ block.settings.tab_comments_title }}</button>
        </div>

        <!-- PHOTO FORM -->
        <div class="ch-tab-panel-{{ ai_gen_id }} active"
             data-ch-panel="photos-submit"
             data-ch-tabs="submit-{{ ai_gen_id }}">
          <div class="ch-form-card-{{ ai_gen_id }}">
            <h3>{{ block.settings.form_photos_title }}</h3>
            <div id="ch-photo-msg-{{ ai_gen_id }}"></div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label>الصورة *</label>
              <div class="ch-upload-area-{{ ai_gen_id }}" id="ch-photo-drop-{{ ai_gen_id }}">
                <input type="file" id="ch-photo-file-{{ ai_gen_id }}"
                       accept="image/jpeg,image/png,image/gif,image/webp">
                <span class="ch-upload-icon-{{ ai_gen_id }}">📷</span>
                <div style="font-size:14px;color:{{ block.settings.meta_color }};">
                  اضغط أو اسحب صورة هنا
                </div>
                <div style="font-size:12px;color:{{ block.settings.meta_color }};margin-top:4px;">
                  JPG, PNG, GIF, WEBP — حتى 10MB
                </div>
                <div class="ch-upload-progress-{{ ai_gen_id }}" id="ch-photo-prog-{{ ai_gen_id }}">
                  <div class="ch-upload-progress-bar-{{ ai_gen_id }}"
                       id="ch-photo-prog-bar-{{ ai_gen_id }}"></div>
                </div>
                <img class="ch-upload-preview-{{ ai_gen_id }}"
                     id="ch-photo-preview-{{ ai_gen_id }}" alt="preview">
              </div>
            </div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-photo-title-{{ ai_gen_id }}">عنوان الصورة *</label>
              <input type="text" id="ch-photo-title-{{ ai_gen_id }}"
                     class="ch-input-{{ ai_gen_id }}" maxlength="120" required>
            </div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-photo-desc-{{ ai_gen_id }}">وصف قصير (اختياري)</label>
              <textarea id="ch-photo-desc-{{ ai_gen_id }}"
                        class="ch-textarea-{{ ai_gen_id }}" rows="3"
                        maxlength="400"></textarea>
            </div>
            <button type="button" class="ch-submit-{{ ai_gen_id }}"
                    id="ch-photo-submit-{{ ai_gen_id }}"
                    data-type="photo">مشاركة الالتقاط</button>
          </div>
        </div>

        <!-- QUOTE FORM -->
        <div class="ch-tab-panel-{{ ai_gen_id }}"
             data-ch-panel="quotes-submit"
             data-ch-tabs="submit-{{ ai_gen_id }}">
          <div class="ch-form-card-{{ ai_gen_id }}">
            <h3>{{ block.settings.form_quotes_title }}</h3>
            <div id="ch-quote-msg-{{ ai_gen_id }}"></div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-quote-text-{{ ai_gen_id }}">الاقتباس *</label>
              <textarea id="ch-quote-text-{{ ai_gen_id }}"
                        class="ch-textarea-{{ ai_gen_id }}" rows="4"
                        maxlength="600" required></textarea>
            </div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-quote-book-{{ ai_gen_id }}">اسم الكتاب *</label>
              <input type="text" id="ch-quote-book-{{ ai_gen_id }}"
                     class="ch-input-{{ ai_gen_id }}" maxlength="120" required>
            </div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-quote-author-{{ ai_gen_id }}">اسم المؤلف *</label>
              <input type="text" id="ch-quote-author-{{ ai_gen_id }}"
                     class="ch-input-{{ ai_gen_id }}" maxlength="100" required>
            </div>
            <button type="button" class="ch-submit-{{ ai_gen_id }}"
                    id="ch-quote-submit-{{ ai_gen_id }}"
                    data-type="quote">مشاركة الاقتباس</button>
          </div>
        </div>

        <!-- COMMENT FORM -->
        <div class="ch-tab-panel-{{ ai_gen_id }}"
             data-ch-panel="comments-submit"
             data-ch-tabs="submit-{{ ai_gen_id }}">
          <div class="ch-form-card-{{ ai_gen_id }}">
            <h3>{{ block.settings.form_comments_title }}</h3>
            <div id="ch-comment-msg-{{ ai_gen_id }}"></div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-comment-title-{{ ai_gen_id }}">عنوان التعليق *</label>
              <input type="text" id="ch-comment-title-{{ ai_gen_id }}"
                     class="ch-input-{{ ai_gen_id }}" maxlength="120" required>
            </div>
            <div class="ch-field-{{ ai_gen_id }}">
              <label for="ch-comment-text-{{ ai_gen_id }}">التعليق *</label>
              <textarea id="ch-comment-text-{{ ai_gen_id }}"
                        class="ch-textarea-{{ ai_gen_id }}" rows="5"
                        maxlength="800" required></textarea>
            </div>
            <button type="button" class="ch-submit-{{ ai_gen_id }}"
                    id="ch-comment-submit-{{ ai_gen_id }}"
                    data-type="comment">مشاركة التعليق</button>
          </div>
        </div>

      </div><!-- /submit section -->

    {% else %}
      <!-- NOT LOGGED IN + GUESTS NOT ALLOWED -->
      <div class="ch-login-{{ ai_gen_id }}">
        <h3>{{ block.settings.login_title }}</h3>
        <p style="color:{{ block.settings.text_color }};margin:0 0 20px;">
          {{ block.settings.login_message }}
        </p>
        <a href="/account/login" class="ch-btn-{{ ai_gen_id }}">
          {{ block.settings.login_button_text }}
        </a>
      </div>
    {% endif %}

    <div class="ch-divider-{{ ai_gen_id }}" style="margin:40px 0;"></div>

    <!-- PUBLIC FEED SECTION -->
    {% if block.settings.show_public_posts %}
      <div id="ch-feed-{{ ai_gen_id }}">
        <h2 class="ch-section-title-{{ ai_gen_id }}">{{ block.settings.public_section_title }}</h2>

        <!-- Search -->
        <div class="ch-search-wrap-{{ ai_gen_id }}">
          <svg class="ch-search-icon-{{ ai_gen_id }}" width="16" height="16"
               viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="search" id="ch-search-{{ ai_gen_id }}"
                 class="ch-search-{{ ai_gen_id }}"
                 placeholder="ابحث في المشاركات...">
        </div>

        <!-- Filter Tabs -->
        <div class="ch-tabs-{{ ai_gen_id }}" data-ch-tabs="feed-{{ ai_gen_id }}">
          <button class="ch-tab-{{ ai_gen_id }} active"
                  data-ch-tab="all" data-ch-feed-filter="all">الكل</button>
          <button class="ch-tab-{{ ai_gen_id }}"
                  data-ch-tab="photo-feed" data-ch-feed-filter="photo">
            {{ block.settings.public_tab_photos }}</button>
          <button class="ch-tab-{{ ai_gen_id }}"
                  data-ch-tab="quote-feed" data-ch-feed-filter="quote">
            {{ block.settings.public_tab_quotes }}</button>
          <button class="ch-tab-{{ ai_gen_id }}"
                  data-ch-tab="comment-feed" data-ch-feed-filter="comment">
            {{ block.settings.public_tab_comments }}</button>
        </div>

        <!-- Masonry Grid -->
        <div class="ch-masonry-{{ ai_gen_id }}" id="ch-masonry-{{ ai_gen_id }}">
          <div class="ch-spinner-{{ ai_gen_id }}" id="ch-spinner-{{ ai_gen_id }}"></div>
        </div>

        <!-- Load More -->
        <div class="ch-load-more-{{ ai_gen_id }}" id="ch-load-more-wrap-{{ ai_gen_id }}"
             style="display:none;">
          <button class="ch-btn-{{ ai_gen_id }} ch-btn-outline-{{ ai_gen_id }}"
                  id="ch-load-more-{{ ai_gen_id }}">
            تحميل المزيد
          </button>
        </div>
      </div>
    {% endif %}

    <!-- BLOG SECTION -->
    {% if block.settings.show_blog_section and block.settings.blog != blank %}
      <div class="ch-divider-{{ ai_gen_id }}" style="margin:40px 0;"></div>
      <div>
        <h2 class="ch-section-title-{{ ai_gen_id }}">{{ block.settings.blog_section_title }}</h2>
        <div class="ch-blog-grid-{{ ai_gen_id }}">
          {% for article in block.settings.blog.articles limit: block.settings.blog_posts_count %}
            <a href="{{ article.url }}" class="ch-blog-card-{{ ai_gen_id }}">
              {% if article.image %}
                <img src="{{ article.image | image_url: width: 600 }}"
                     alt="{{ article.title | escape }}"
                     class="ch-blog-img-{{ ai_gen_id }}"
                     loading="lazy" width="600" height="360">
              {% else %}
                <div style="width:100%;height:180px;background:{{ block.settings.border_color }};
                     display:flex;align-items:center;justify-content:center;font-size:40px;">
                  📖
                </div>
              {% endif %}
              <div class="ch-blog-body-{{ ai_gen_id }}">
                <h3 class="ch-blog-title-{{ ai_gen_id }}">{{ article.title }}</h3>
                {% if article.excerpt != blank %}
                  <p class="ch-blog-excerpt-{{ ai_gen_id }}">
                    {{ article.excerpt | strip_html | truncate: 110 }}
                  </p>
                {% endif %}
                <p class="ch-blog-date-{{ ai_gen_id }}">
                  {{ article.published_at | date: "%d %B %Y" }}
                </p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
(function () {
  'use strict';

  /* ── CONFIG (injected from Shopify settings) ── */
  const CFG = {
    genId:         '{{ ai_gen_id }}',
    supabaseUrl:   '{{ block.settings.supabase_url | strip }}',
    supabaseKey:   '{{ block.settings.supabase_key | strip }}',
    imgbbKey:      '{{ block.settings.imgbb_key | strip }}',
    moderation:    {{ block.settings.enable_moderation | json }},
    guestPosts:    {{ block.settings.allow_guest_posts | json }},
    pageSize:      {{ block.settings.posts_per_page }},
    customerName:  '{{ customer.name | default: "" | escape }}',
    customerEmail: '{{ customer.email | default: "" | escape }}',
    isLoggedIn:    {{ customer | json | default: 'null' }} !== null,
  };

  const g  = id => document.getElementById(id);
  const qs = (sel, ctx) => (ctx || document).querySelector(sel);
  const E  = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const LIKED_KEY = 'ch_likes_v1';

  /* ── SUPABASE HELPERS ── */
  const SB = {
    ready: CFG.supabaseUrl && CFG.supabaseKey,

    headers() {
      return {
        'Content-Type':  'application/json',
        'apikey':        CFG.supabaseKey,
        'Authorization': 'Bearer ' + CFG.supabaseKey,
        'Prefer':        'return=representation',
      };
    },

    async insert(row) {
      const r = await fetch(CFG.supabaseUrl + '/rest/v1/posts', {
        method:  'POST',
        headers: this.headers(),
        body:    JSON.stringify(row),
      });
      if (!r.ok) throw new Error(await r.text());
      return r.json();
    },

    async fetch({ type, search, from, to }) {
      let url = CFG.supabaseUrl + '/rest/v1/posts?approved=eq.true&order=created_at.desc';
      if (type && type !== 'all') url += '&type=eq.' + type;
      if (search) url += '&or=(content.ilike.*' + encodeURIComponent(search) + '*,author.ilike.*' + encodeURIComponent(search) + '*,book_name.ilike.*' + encodeURIComponent(search) + '*)';
      url += '&limit=' + (to - from + 1) + '&offset=' + from;
      const r = await fetch(url, {
        headers: { 'apikey': CFG.supabaseKey, 'Authorization': 'Bearer ' + CFG.supabaseKey },
      });
      if (!r.ok) throw new Error(await r.text());
      return r.json();
    },

    async incrementLike(id) {
      const r = await fetch(CFG.supabaseUrl + '/rest/v1/rpc/increment_likes', {
        method:  'POST',
        headers: this.headers(),
        body:    JSON.stringify({ post_id: id }),
      });
      return r.ok;
    },
  };

  /* ── IMGBB UPLOAD ── */
  async function uploadImage(file, onProgress) {
    if (!CFG.imgbbKey) throw new Error('ImgBB key missing');
    return new Promise((resolve, reject) => {
      const fd = new FormData();
      fd.append('image', file);
      const xhr = new XMLHttpRequest();
      xhr.open('POST', 'https://api.imgbb.com/1/upload?key=' + CFG.imgbbKey);
      xhr.upload.onprogress = e => {
        if (e.lengthComputable) onProgress(Math.round(e.loaded / e.total * 90));
      };
      xhr.onload = () => {
        if (xhr.status === 200) {
          const d = JSON.parse(xhr.responseText);
          onProgress(100);
          resolve(d.data.url);
        } else {
          reject(new Error('Upload failed'));
        }
      };
      xhr.onerror = () => reject(new Error('Network error'));
      xhr.send(fd);
    });
  }

  /* ── TAB SWITCHER ── */
  function initTabs(scopeEl, groupKey) {
    const tabs   = scopeEl.querySelectorAll(`.ch-tab-${CFG.genId}[data-ch-tabs="${groupKey}"]`);
    const panels = scopeEl.querySelectorAll(`.ch-tab-panel-${CFG.genId}[data-ch-tabs="${groupKey}"]`);

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.getAttribute('data-ch-tab');
        scopeEl.querySelectorAll(`.ch-tab-panel-${CFG.genId}[data-ch-panel="${target}"]`)
               .forEach(p => p.classList.add('active'));
      });
    });
  }

  /* ── LIKES ── */
  function getLiked() {
    try { return JSON.parse(localStorage.getItem(LIKED_KEY)) || {}; } catch { return {}; }
  }

  function setLiked(id) {
    const l = getLiked(); l[id] = 1;
    try { localStorage.setItem(LIKED_KEY, JSON.stringify(l)); } catch {}
  }

  /* ── RENDER CARD ── */
  function renderCard(post) {
    const liked    = getLiked()[post.id] ? 'liked' : '';
    const dateStr  = new Date(post.created_at).toLocaleDateString('ar-EG', {
      year: 'numeric', month: 'long', day: 'numeric'
    });

    const badges = { photo: '📷 التقاط', quote: '📚 اقتباس', comment: '💬 تعليق' };
    const badge  = badges[post.type] || post.type;

    let inner = `<span class="ch-card-type-badge-${CFG.genId}">${E(badge)}</span>`;

    if (post.type === 'photo') {
      if (post.image_url) {
        inner += `<img src="${E(post.image_url)}" alt="${E(post.content)}"
                       class="ch-card-img-${CFG.genId}" loading="lazy">`;
      }
      if (post.content) inner += `<p class="ch-card-text-${CFG.genId}">${E(post.content)}</p>`;
    } else if (post.type === 'quote') {
      inner += `<p class="ch-card-quote-${CFG.genId}">"${E(post.content)}"</p>`;
      if (post.book_name) {
        inner += `<p class="ch-card-book-${CFG.genId}">
          <strong>${E(post.book_name)}</strong>${post.book_author ? ' — ' + E(post.book_author) : ''}
        </p>`;
      }
    } else {
      if (post.comment_title) {
        inner += `<h4 class="ch-card-title-${CFG.genId}">${E(post.comment_title)}</h4>`;
      }
      inner += `<p class="ch-card-text-${CFG.genId}">${E(post.content)}</p>`;
    }

    inner += `
      <div class="ch-card-footer-${CFG.genId}">
        <div>
          <span class="ch-card-author-${CFG.genId}">✍ ${E(post.author)}</span>
          <span style="margin-right:8px;">${dateStr}</span>
        </div>
        <button class="ch-like-btn-${CFG.genId} ${liked}"
                data-post-id="${post.id}"
                data-liked="${liked ? '1' : '0'}">
          <svg width="14" height="14" viewBox="0 0 24 24"
               fill="${liked ? '#e05' : 'none'}" stroke="#e05" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="ch-like-count">${post.likes_count || 0}</span>
        </button>
      </div>`;

    const div = document.createElement('div');
    div.className = `ch-card-${CFG.genId}`;
    div.dataset.postId   = post.id;
    div.dataset.postType = post.type;
    div.dataset.search   = [post.author, post.content, post.book_name, post.book_author, post.comment_title]
                             .filter(Boolean).join(' ').toLowerCase();
    div.innerHTML = inner;
    return div;
  }

  /* ── FEED MANAGER ── */
  const Feed = {
    offset:      0,
    activeType:  'all',
    searchQuery: '',
    loading:     false,
    exhausted:   false,

    async load(reset) {
      if (!SB.ready) return;
      if (this.loading) return;
      if (!reset && this.exhausted) return;

      this.loading = true;
      const masonry = g('ch-masonry-' + CFG.genId);
      const spinner = g('ch-spinner-' + CFG.genId);
      const lmWrap  = g('ch-load-more-wrap-' + CFG.genId);

      if (reset) {
        this.offset    = 0;
        this.exhausted = false;
        masonry.innerHTML = '';
        const sp = document.createElement('div');
        sp.id        = 'ch-spinner-' + CFG.genId;
        sp.className = 'ch-spinner-' + CFG.genId;
        masonry.appendChild(sp);
        if (lmWrap) lmWrap.style.display = 'none';
      }

      try {
        const rows = await SB.fetch({
          type:   this.activeType,
          search: this.searchQuery,
          from:   this.offset,
          to:     this.offset + CFG.pageSize - 1,
        });

        const sp = g('ch-spinner-' + CFG.genId);
        if (sp) sp.remove();

        if (rows.length === 0 && this.offset === 0) {
          const empty = document.createElement('div');
          empty.className = 'ch-empty-' + CFG.genId;
          empty.textContent = 'لا توجد مشاركات بعد. كن أول من يشارك!';
          masonry.appendChild(empty);
        } else {
          rows.forEach(post => masonry.appendChild(renderCard(post)));
          this.offset += rows.length;
          if (lmWrap) lmWrap.style.display = rows.length < CFG.pageSize ? 'none' : 'block';
          if (rows.length < CFG.pageSize) this.exhausted = true;
        }
      } catch (err) {
        const sp = g('ch-spinner-' + CFG.genId);
        if (sp) sp.remove();
        const errDiv = document.createElement('div');
        errDiv.className = 'ch-error-' + CFG.genId;
        errDiv.textContent = 'تعذّر تحميل المشاركات. يرجى المحاولة لاحقاً.';
        masonry.appendChild(errDiv);
      }

      this.loading = false;
    },
  };

  /* ── SHOW MESSAGE ── */
  function showMsg(el, type, text) {
    el.className = type === 'success' ? 'ch-success-' + CFG.genId : 'ch-error-' + CFG.genId;
    el.textContent = text;
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  /* ── SUBMIT POST ── */
  async function submitPost(type) {
    if (!SB.ready) {
      const msgEl = g('ch-' + (type === 'photo' ? 'photo' : type === 'quote' ? 'quote' : 'comment') + '-msg-' + CFG.genId);
      showMsg(msgEl, 'error', 'لم يتم إعداد قاعدة البيانات بعد. يرجى مراجعة الإعدادات.');
      return;
    }

    let author = CFG.isLoggedIn ? CFG.customerName : '';
    if (!CFG.isLoggedIn) {
      const guestEl = g('ch-guest-name-' + CFG.genId);
      author = guestEl ? guestEl.value.trim() : '';
      if (!author) { guestEl.focus(); return; }
    }

    const btn   = g('ch-' + type + '-submit-' + CFG.genId);
    const msgEl = g('ch-' + type + '-msg-' + CFG.genId);
    msgEl.textContent = '';

    const row = {
      type,
      author,
      approved: !CFG.moderation,
    };

    // Gather fields
    if (type === 'photo') {
      const fileEl = g('ch-photo-file-' + CFG.genId);
      const titleEl = g('ch-photo-title-' + CFG.genId);
      const descEl  = g('ch-photo-desc-' + CFG.genId);
      if (!fileEl.files[0] && !titleEl.value.trim()) {
        showMsg(msgEl, 'error', 'يرجى اختيار صورة وكتابة عنوان.'); return;
      }
      row.comment_title = titleEl.value.trim();
      row.content       = descEl.value.trim();
      if (fileEl.files[0]) {
        btn.disabled    = true;
        btn.textContent = 'جارٍ الرفع...';
        const prog    = g('ch-photo-prog-' + CFG.genId);
        const progBar = g('ch-photo-prog-bar-' + CFG.genId);
        prog.style.display = 'block';
        try {
          row.image_url = await uploadImage(fileEl.files[0], pct => {
            progBar.style.width = pct + '%';
          });
        } catch {
          showMsg(msgEl, 'error', 'فشل رفع الصورة. يرجى التحقق من ImgBB API Key.');
          btn.disabled    = false;
          btn.textContent = 'مشاركة الالتقاط';
          prog.style.display = 'none';
          return;
        }
      }

    } else if (type === 'quote') {
      const qt = g('ch-quote-text-' + CFG.genId).value.trim();
      const bk = g('ch-quote-book-' + CFG.genId).value.trim();
      const ba = g('ch-quote-author-' + CFG.genId).value.trim();
      if (!qt || !bk || !ba) { showMsg(msgEl, 'error', 'يرجى ملء جميع الحقول.'); return; }
      row.content     = qt;
      row.book_name   = bk;
      row.book_author = ba;

    } else if (type === 'comment') {
      const ct = g('ch-comment-title-' + CFG.genId).value.trim();
      const cx = g('ch-comment-text-' + CFG.genId).value.trim();
      if (!ct || !cx) { showMsg(msgEl, 'error', 'يرجى ملء جميع الحقول.'); return; }
      row.comment_title = ct;
      row.content       = cx;
    }

    btn.disabled    = true;
    btn.textContent = 'جارٍ الإرسال...';

    try {
      await SB.insert(row);
      const pending = CFG.moderation
        ? 'شكراً! سيتم مراجعة مشاركتك ونشرها قريباً. ✨'
        : 'تمت مشاركتك بنجاح! 🎉';
      showMsg(msgEl, 'success', pending);

      // Reset form
      if (type === 'photo') {
        g('ch-photo-file-' + CFG.genId).value  = '';
        g('ch-photo-title-' + CFG.genId).value = '';
        g('ch-photo-desc-' + CFG.genId).value  = '';
        const prev = g('ch-photo-preview-' + CFG.genId);
        prev.src = ''; prev.style.display = 'none';
        const prog = g('ch-photo-prog-' + CFG.genId);
        prog.style.display = 'none';
        g('ch-photo-prog-bar-' + CFG.genId).style.width = '0';
      } else if (type === 'quote') {
        ['ch-quote-text-','ch-quote-book-','ch-quote-author-'].forEach(p =>
          { const el = g(p + CFG.genId); if (el) el.value = ''; });
      } else {
        ['ch-comment-title-','ch-comment-text-'].forEach(p =>
          { const el = g(p + CFG.genId); if (el) el.value = ''; });
      }

      // Refresh feed if not under moderation
      if (!CFG.moderation) Feed.load(true);

    } catch (err) {
      showMsg(msgEl, 'error', 'حدث خطأ. يرجى المحاولة مرة أخرى.');
    } finally {
      btn.disabled    = false;
      const labels = { photo:'مشاركة الالتقاط', quote:'مشاركة الاقتباس', comment:'مشاركة التعليق' };
      btn.textContent = labels[type];
    }
  }

  /* ── INIT ── */
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('.ch-' + CFG.genId);
    if (!root) return;

    /* Tabs for submit section */
    initTabs(root, 'submit-' + CFG.genId);

    /* Feed filter tabs */
    root.querySelectorAll('[data-ch-feed-filter]').forEach(tab => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('[data-ch-feed-filter]').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        Feed.activeType = tab.dataset.chFeedFilter;
        Feed.load(true);
      });
    });

    /* Search */
    const searchEl = g('ch-search-' + CFG.genId);
    if (searchEl) {
      let timer;
      searchEl.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          Feed.searchQuery = searchEl.value.trim();
          Feed.load(true);
        }, 350);
      });
    }

    /* Submit buttons */
    ['photo','quote','comment'].forEach(type => {
      const btn = g('ch-' + type + '-submit-' + CFG.genId);
      if (btn) btn.addEventListener('click', () => submitPost(type));
    });

    /* Image preview */
    const fileEl = g('ch-photo-file-' + CFG.genId);
    const preview = g('ch-photo-preview-' + CFG.genId);
    if (fileEl && preview) {
      fileEl.addEventListener('change', () => {
        const file = fileEl.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = e => {
            preview.src          = e.target.result;
            preview.style.display = 'block';
          };
          reader.readAsDataURL(file);
        }
      });
    }

    /* Like buttons (delegated) */
    const masonry = g('ch-masonry-' + CFG.genId);
    if (masonry) {
      masonry.addEventListener('click', async e => {
        const btn = e.target.closest('.ch-like-btn-' + CFG.genId);
        if (!btn) return;
        const id = btn.dataset.postId;
        if (btn.dataset.liked === '1') return;
        btn.dataset.liked = '1';
        btn.classList.add('liked');
        const countEl = btn.querySelector('.ch-like-count');
        countEl.textContent = parseInt(countEl.textContent || 0) + 1;
        setLiked(id);
        await SB.incrementLike(id).catch(() => {});
      });
    }

    /* Load more */
    const lmBtn = g('ch-load-more-' + CFG.genId);
    if (lmBtn) lmBtn.addEventListener('click', () => Feed.load(false));

    /* Initial feed load */
    if (SB.ready) Feed.load(true);
  });


// image zoom
document.addEventListener('click', function(e) {
  const img = e.target.closest('.ch-card-img-{{ ai_gen_id }}');
  if (!img) return;

  const modal = document.getElementById('ch-image-modal-{{ ai_gen_id }}');
  const modalImg = document.getElementById('ch-image-modal-img-{{ ai_gen_id }}');

  modal.style.display = 'flex';
  modalImg.src = img.src;
});

document.getElementById('ch-image-modal-{{ ai_gen_id }}')
?.addEventListener('click', function() {
  this.style.display = 'none';
});

})();
</script>

