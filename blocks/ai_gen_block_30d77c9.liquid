{% doc %}
  @prompt
    بار متحرك يأخذ طابع الريترو لتصفح أقسام الكاسيت المختلفه , حلو بس بدي كل بار متحرك اقدر اعدل النص واربط فيه القسم المراد وإمكانيه تغيير الصوره المصغره بجانب النص , بدي تضيف قسم آخر وكمان امكانيه التحكم في سرعتهن , بدي خيارات اكثر للتحكم في النصوص 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-retro-cassette-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.bar_padding }}px 0;
    overflow: hidden;
    position: relative;
    border-top: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-retro-cassette-bar__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    will-change: transform;
  }

  .ai-retro-cassette-bar__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    background: {{ block.settings.item_background }};
    border: 2px solid {{ block.settings.item_border_color }};
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 4px 4px 0 {{ block.settings.shadow_color }};
  }

  .ai-retro-cassette-bar__item-{{ ai_gen_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 {{ block.settings.shadow_color }};
  }

  .ai-retro-cassette-bar__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    border: 2px solid {{ block.settings.item_border_color }};
  }

  .ai-retro-cassette-bar__icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-retro-cassette-bar__cassette-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: {{ block.settings.cassette_body_color }};
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-retro-cassette-bar__cassette-{{ ai_gen_id }}::before,
  .ai-retro-cassette-bar__cassette-{{ ai_gen_id }}::after {
    content: '';
    width: 10px;
    height: 10px;
    background: {{ block.settings.cassette_reel_color }};
    border: 1px solid {{ block.settings.item_border_color }};
    border-radius: 50%;
  }

  .ai-retro-cassette-bar__label-{{ ai_gen_id }} {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 8px;
    background: {{ block.settings.cassette_label_color }};
    border: 1px solid {{ block.settings.item_border_color }};
    border-radius: 1px;
  }

  .ai-retro-cassette-bar__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
    white-space: nowrap;
    {% if block.settings.text_transform != 'none' %}
      text-transform: {{ block.settings.text_transform }};
    {% endif %}
    {% if block.settings.text_shadow_enabled %}
      text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-retro-cassette-bar__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
    
    .ai-retro-cassette-bar__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

