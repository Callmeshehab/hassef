<script>
  (function() {
    class RetroCassetteBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-retro-cassette-bar__track-{{ ai_gen_id }}');
        this.speed = parseFloat(this.dataset.speed) || 1;
        this.position = 0;
        this.isPaused = false;
        this.isRTL = false;
        this.singleSetWidth = 0;
      }

      connectedCallback() {
        // تحديد اتجاه الصفحة
        this.isRTL = getComputedStyle(document.documentElement).direction === 'rtl'
                     || document.documentElement.dir === 'rtl';

        // انتظر تحميل الصور قبل حساب العرض
        requestAnimationFrame(() => {
          this.calculateWidth();
          this.startAnimation();
          this.setupHoverPause();
        });
      }

      calculateWidth() {
        // عدد العناصر الأصلية = scrollWidth / 10 (لأن اللوب كرر 10 مرات)
        this.singleSetWidth = this.track.scrollWidth / 10;
      }

      startAnimation() {
        const animate = () => {
          if (!this.isPaused) {
            if (this.isRTL) {
              // RTL: نتحرك للأيمن (قيمة موجبة)
              this.position += this.speed;
              if (this.position >= this.singleSetWidth) {
                this.position = 0;
              }
            } else {
              // LTR: نتحرك للأيسر (قيمة سالبة)
              this.position -= this.speed;
              if (Math.abs(this.position) >= this.singleSetWidth) {
                this.position = 0;
              }
            }

            this.track.style.transform = `translateX(${this.position}px)`;
          }

          requestAnimationFrame(animate);
        };

        animate();
      }

      setupHoverPause() {
        this.addEventListener('mouseenter', () => { this.isPaused = true; });
        this.addEventListener('mouseleave', () => { this.isPaused = false; });
      }
    }

    customElements.define('retro-cassette-bar-{{ ai_gen_id }}', RetroCassetteBar{{ ai_gen_id }});
  })();
</script>


