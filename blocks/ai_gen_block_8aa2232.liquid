<script>
  (function() {
    class RetroTvPlayer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.videos = [];
        this.availableVideos = [];
        this.currentVideoIndex = 0;
        this.currentVideo = null;
        this.isPlaying = false;
        this.isMuted = false;
        this.currentVolume = 1;
        this.staticCanvas = null;
        this.staticCtx = null;
        this.staticAnimationId = null;
        this.ENABLE_STATIC = {% if block.settings.enable_static %}true{% else %}false{% endif %};
        this.STATIC_DURATION = {{ block.settings.static_duration }};
      }

      connectedCallback() {
        this.videos = Array.from(this.querySelectorAll('.ai-retro-tv-video-{{ ai_gen_id }}'));
        
        if (this.videos.length === 0) return;

        this.availableVideos = this.videos.filter(video => {
          const sources = video.querySelectorAll('source');
          return sources.length > 0;
        });
        
        if (this.availableVideos.length === 0) return;

        this.currentVideo = this.availableVideos[0];
        this.currentVideoIndex = 0;
        
        this.playPauseBtn = this.querySelector('.ai-retro-tv-play-pause-{{ ai_gen_id }}');
        this.fullscreenBtn = this.querySelector('.ai-retro-tv-fullscreen-{{ ai_gen_id }}');
        this.muteBtn = this.querySelector('.ai-retro-tv-mute-{{ ai_gen_id }}');
        this.playIcon = this.querySelector('.ai-retro-tv-play-icon-{{ ai_gen_id }}');
        this.pauseIcon = this.querySelector('.ai-retro-tv-pause-icon-{{ ai_gen_id }}');
        this.volumeOnIcon = this.querySelector('.ai-retro-tv-volume-on-icon-{{ ai_gen_id }}');
        this.volumeOffIcon = this.querySelector('.ai-retro-tv-volume-off-icon-{{ ai_gen_id }}');
        this.videoDots = Array.from(this.querySelectorAll('.ai-retro-tv-video-dot-{{ ai_gen_id }}'));
        this.navPrevBtn = this.querySelector('.ai-retro-tv-nav-prev-{{ ai_gen_id }}');
        this.navNextBtn = this.querySelector('.ai-retro-tv-nav-next-{{ ai_gen_id }}');
        this.volumeSlider = this.querySelector('.ai-retro-tv-volume-slider-{{ ai_gen_id }}');
        this.staticCanvas = this.querySelector('.ai-retro-tv-static-overlay-{{ ai_gen_id }}');

        if (this.staticCanvas) {
          this.staticCtx = this.staticCanvas.getContext('2d');
          this.resizeStaticCanvas();
          window.addEventListener('resize', () => this.resizeStaticCanvas());
        }

        this.setupEventListeners();
        this.initializeVideo();
      }

      resizeStaticCanvas() {
        if (!this.staticCanvas) return;
        const rect = this.staticCanvas.getBoundingClientRect();
        this.staticCanvas.width = rect.width;
        this.staticCanvas.height = rect.height;
      }

      drawStaticNoise() {
        if (!this.staticCtx || !this.staticCanvas) return;
        
        const width = this.staticCanvas.width;
        const height = this.staticCanvas.height;
        const imageData = this.staticCtx.createImageData(width, height);
        const data = imageData.data;

        for (let i = 0; i < data.length; i += 4) {
          const value = Math.random() * 255;
          data[i] = value;
          data[i + 1] = value;
          data[i + 2] = value;
          data[i + 3] = 255;
        }

        this.staticCtx.putImageData(imageData, 0, 0);
      }

      showStatic() {
        if (!this.ENABLE_STATIC || !this.staticCanvas) return;

        this.staticCanvas.classList.add('active');
        
        const animate = () => {
          this.drawStaticNoise();
          this.staticAnimationId = requestAnimationFrame(animate);
        };
        
        animate();

        setTimeout(() => {
          this.hideStatic();
        }, this.STATIC_DURATION);
      }

      hideStatic() {
        if (!this.staticCanvas) return;
        
        this.staticCanvas.classList.remove('active');
        
        if (this.staticAnimationId) {
          cancelAnimationFrame(this.staticAnimationId);
          this.staticAnimationId = null;
        }
        
        if (this.staticCtx) {
          this.staticCtx.clearRect(0, 0, this.staticCanvas.width, this.staticCanvas.height);
        }
      }

      initializeVideo() {
        if (this.currentVideo) {
          this.currentVideo.muted = {% if block.settings.muted %}true{% else %}false{% endif %};
          this.isMuted = this.currentVideo.muted;
          this.currentVolume = this.currentVideo.volume;
          this.updateMuteIcon(this.isMuted);
          this.updateVolumeSlider(this.currentVolume);

          {% if block.settings.autoplay %}
            const playPromise = this.currentVideo.play();
            if (playPromise !== undefined) {
              playPromise.then(() => {
                this.updatePlayPauseIcon(true);
              }).catch(() => {
                this.currentVideo.muted = true;
                this.isMuted = true;
                this.updateMuteIcon(true);
                this.currentVideo.play().then(() => {
                  this.updatePlayPauseIcon(true);
                }).catch(() => {});
              });
            }
          {% endif %}

          {% if block.settings.auto_advance %}
            this.currentVideo.addEventListener('ended', () => {
              if (this.availableVideos.length > 1) {
                this.nextVideo();
                if (this.currentVideo) {
                  const playPromise = this.currentVideo.play();
                  if (playPromise !== undefined) {
                    playPromise.catch(() => {});
                  }
                }
              }
            });
          {% endif %}
        }
      }

      setupEventListeners() {
        if (this.playPauseBtn) {
          this.playPauseBtn.addEventListener('click', () => this.togglePlayPause());
        }
        
        if (this.fullscreenBtn) {
          this.fullscreenBtn.addEventListener('click', () => this.toggleFullscreen());
        }
        
        if (this.muteBtn) {
          this.muteBtn.addEventListener('click', () => this.toggleMute());
        }
        
        this.availableVideos.forEach((video) => {
          video.addEventListener('play', () => {
            if (video === this.currentVideo) {
              this.updatePlayPauseIcon(true);
            }
          });
          video.addEventListener('pause', () => {
            if (video === this.currentVideo) {
              this.updatePlayPauseIcon(false);
            }
          });
        });

        this.videoDots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const videoIndex = parseInt(dot.getAttribute('data-video'));
            this.switchToVideoByDataIndex(videoIndex);
          });
        });

        if (this.navPrevBtn) {
          this.navPrevBtn.addEventListener('click', () => this.previousVideo());
        }

        if (this.navNextBtn) {
          this.navNextBtn.addEventListener('click', () => this.nextVideo());
        }

        if (this.volumeSlider) {
          this.volumeSlider.addEventListener('input', (e) => this.handleVolumeChange(e));
          this.updateVolumeSliderBackground(this.volumeSlider.value);
        }
      }

      handleVolumeChange(e) {
        const value = e.target.value;
        const volume = value / 100;
        this.setVolume(volume);
        this.updateVolumeSliderBackground(value);
      }

      updateVolumeSliderBackground(value) {
        const fillColor = '{{ block.settings.volume_slider_fill_color }}';
        const bgColor = '{{ block.settings.volume_slider_bg_color }}';
        this.volumeSlider.style.background = `linear-gradient(to right, ${fillColor} 0%, ${fillColor} ${value}%, ${bgColor} ${value}%, ${bgColor} 100%)`;
      }

      setVolume(volume) {
        this.currentVolume = volume;
        
        if (this.currentVideo) {
          this.currentVideo.volume = volume;
          
          if (volume === 0) {
            this.isMuted = true;
            this.currentVideo.muted = true;
            this.updateMuteIcon(true);
          } else {
            this.isMuted = false;
            this.currentVideo.muted = false;
            this.updateMuteIcon(false);
          }
        }
        
        this.updateVolumeSlider(volume);
      }

      updateVolumeSlider(volume) {
        const percentage = volume * 100;
        if (this.volumeSlider) {
          this.volumeSlider.value = percentage;
          this.updateVolumeSliderBackground(percentage);
        }
      }

      toggleMute() {
        if (!this.currentVideo) return;
        
        this.isMuted = !this.isMuted;
        this.currentVideo.muted = this.isMuted;
        
        if (this.isMuted) {
          this.updateVolumeSlider(0);
        } else {
          if (this.currentVolume === 0) {
            this.currentVolume = 0.5;
            this.currentVideo.volume = 0.5;
          }
          this.updateVolumeSlider(this.currentVolume);
        }
        
        this.updateMuteIcon(this.isMuted);
      }

      updateMuteIcon(muted) {
        if (muted) {
          this.volumeOnIcon.style.display = 'none';
          this.volumeOffIcon.style.display = 'block';
        } else {
          this.volumeOnIcon.style.display = 'block';
          this.volumeOffIcon.style.display = 'none';
        }
      }

      previousVideo() {
        if (this.availableVideos.length <= 1) return;
        
        this.currentVideoIndex = this.currentVideoIndex - 1;
        if (this.currentVideoIndex < 0) {
          this.currentVideoIndex = this.availableVideos.length - 1;
        }
        
        this.switchVideo(this.currentVideoIndex);
      }

      nextVideo() {
        if (this.availableVideos.length <= 1) return;
        
        this.currentVideoIndex = this.currentVideoIndex + 1;
        if (this.currentVideoIndex >= this.availableVideos.length) {
          this.currentVideoIndex = 0;
        }
        
        this.switchVideo(this.currentVideoIndex);
      }

      switchToVideoByDataIndex(dataIndex) {
        const targetVideo = this.availableVideos.find(v => {
          return parseInt(v.getAttribute('data-video-index')) === dataIndex;
        });
        
        if (targetVideo) {
          const arrayIndex = this.availableVideos.indexOf(targetVideo);
          this.switchVideo(arrayIndex);
        }
      }

      switchVideo(arrayIndex) {
        if (arrayIndex < 0 || arrayIndex >= this.availableVideos.length) return;
        
        const wasPlaying = this.currentVideo && !this.currentVideo.paused;
        
        this.showStatic();
        
        if (this.currentVideo) {
          this.currentVideo.pause();
          this.currentVideo.currentTime = 0;
          this.currentVideo.style.display = 'none';
        }
        
        this.currentVideo = this.availableVideos[arrayIndex];
        this.currentVideoIndex = arrayIndex;
        this.currentVideo.style.display = 'block';
        this.currentVideo.muted = this.isMuted;
        this.currentVideo.volume = this.currentVolume;
        
        if (wasPlaying) {
          const playPromise = this.currentVideo.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {});
          }
        }
        
        this.videoDots.forEach((dot) => {
          dot.classList.remove('active');
        });
        
        const currentDataIndex = parseInt(this.currentVideo.getAttribute('data-video-index'));
        const activeDot = this.querySelector(`.ai-retro-tv-video-dot-{{ ai_gen_id }}[data-video="${currentDataIndex}"]`);
        if (activeDot) {
          activeDot.classList.add('active');
        }
      }

      togglePlayPause() {
        if (!this.currentVideo) return;
        
        if (this.currentVideo.paused) {
          const playPromise = this.currentVideo.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {});
          }
        } else {
          this.currentVideo.pause();
        }
      }

      updatePlayPauseIcon(playing) {
        this.isPlaying = playing;
        if (playing) {
          this.playIcon.style.display = 'none';
          this.pauseIcon.style.display = 'block';
        } else {
          this.playIcon.style.display = 'block';
          this.pauseIcon.style.display = 'none';
        }
      }

      toggleFullscreen() {
        const container = this.querySelector('.ai-retro-tv-screen-wrapper-{{ ai_gen_id }}');
        
        if (!document.fullscreenElement) {
          if (container.requestFullscreen) {
            container.requestFullscreen();
          } else if (container.webkitRequestFullscreen) {
            container.webkitRequestFullscreen();
          } else if (container.msRequestFullscreen) {
            container.msRequestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          } else if (document.webkitExitFullscreen) {
            document.webkitExitFullscreen();
          } else if (document.msExitFullscreen) {
            document.msExitFullscreen();
          }
        }
      }

      disconnectedCallback() {
        this.hideStatic();
        window.removeEventListener('resize', () => this.resizeStaticCanvas());
      }
    }

    customElements.define('retro-tv-player-{{ ai_gen_id }}', RetroTvPlayer{{ ai_gen_id }});
  })();
</script>

