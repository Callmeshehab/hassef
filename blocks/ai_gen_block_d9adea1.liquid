    { "type": "range", "id": "ch_1_w_3", "label": "عرض وسائط 3 (%)", "min": 20, "max": 100, "default": 100 },
    { "type": "image_picker", "id": "ch_1_img_4", "label": "فصل 1 - صورة 4" },
