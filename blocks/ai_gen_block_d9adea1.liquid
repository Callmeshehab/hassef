    { "type": "text", "id": "ch_3_title", "label": "عنوان الفصل 3" },
    { "type": "textarea", "id": "ch_3_desc", "label": "وصف الفصل 3" },
    { "type": "html", "id": "ch_3_content", "label": "محتوى الفصل 3 الكامل" },
    { "type": "image_picker", "id": "ch_3_img_1", "label": "فصل 3 - صورة 1" },
    { "type": "url", "id": "ch_3_vid_1", "label": "فصل 3 - فيديو 1" },
    { "type": "range", "id": "ch_3_w_1", "label": "عرض وسائط 1 (%)", "min": 20, "max": 100, "default": 100 },
    { "type": "image_picker", "id": "ch_3_img_2", "label": "فصل 3 - صورة 2" },
    { "type": "url", "id": "ch_3_vid_2", "label": "فصل 3 - فيديو 2" },
    { "type": "range", "id": "ch_3_w_2", "label": "عرض وسائط 2 (%)", "min": 20, "max": 100, "default": 100 },
    { "type": "image_picker", "id": "ch_3_img_3", "label": "فصل 3 - صورة 3" },
