    { "type": "range", "id": "ch_1_w_2", "label": "عرض وسائط 2 (%)", "min": 20, "max": 100, "default": 100 },
    { "type": "image_picker", "id": "ch_1_img_3", "label": "فصل 1 - صورة 3" },
