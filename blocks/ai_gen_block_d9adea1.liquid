    { "type": "range", "id": "ch_1_w_1", "label": "عرض وسائط 1 (%)", "min": 20, "max": 100, "default": 100 },
    { "type": "image_picker", "id": "ch_1_img_2", "label": "فصل 1 - صورة 2" },
