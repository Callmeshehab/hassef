<script>
  (function() {
    class RetroTvPlayer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-retro-tv-video-{{ ai_gen_id }}');
        this.playPauseBtn = this.querySelector('.ai-retro-tv-play-pause-{{ ai_gen_id }}');
        this.playIcon = this.querySelector('.ai-retro-tv-play-icon-{{ ai_gen_id }}, .ai-retro-tv-custom-play-icon-{{ ai_gen_id }}');
        this.pauseIcon = this.querySelector('.ai-retro-tv-pause-icon-{{ ai_gen_id }}, .ai-retro-tv-custom-pause-icon-{{ ai_gen_id }}');
        this.muteBtn = this.querySelector('.ai-retro-tv-mute-{{ ai_gen_id }}');
        this.volumeIcon = this.querySelector('.ai-retro-tv-volume-icon-{{ ai_gen_id }}, .ai-retro-tv-custom-volume-icon-{{ ai_gen_id }}');
        this.muteIcon = this.querySelector('.ai-retro-tv-mute-icon-{{ ai_gen_id }}, .ai-retro-tv-custom-mute-icon-{{ ai_gen_id }}');
        this.volumeSlider = this.querySelector('.ai-retro-tv-volume-slider-{{ ai_gen_id }}');
        this.volumeFill = this.querySelector('.ai-retro-tv-volume-slider-fill-{{ ai_gen_id }}');
        this.fullscreenBtn = this.querySelector('.ai-retro-tv-fullscreen-{{ ai_gen_id }}');
        this.screenWrapper = this.querySelector('.ai-retro-tv-screen-wrapper-{{ ai_gen_id }}');

        if (!this.video) return;

        this.setupEventListeners();
        this.updateVolumeDisplay(70);
      }

      updateVolumeDisplay(volume) {
        if (!this.volumeFill || !this.video) return;
        
        this.volumeFill.style.width = volume + '%';
        
        if (volume == 0) {
          this.video.muted = true;
          if (this.volumeIcon) this.volumeIcon.style.display = 'none';
          if (this.muteIcon) this.muteIcon.style.display = 'block';
        } else {
          this.video.muted = false;
          this.video.volume = volume / 100;
          if (this.volumeIcon) this.volumeIcon.style.display = 'block';
          if (this.muteIcon) this.muteIcon.style.display = 'none';
        }
      }

      setupEventListeners() {
        if (this.playPauseBtn) {
          this.playPauseBtn.addEventListener('click', () => {
            if (this.video.paused) {
              this.video.play();
              if (this.playIcon) this.playIcon.style.display = 'none';
              if (this.pauseIcon) this.pauseIcon.style.display = 'block';
            } else {
              this.video.pause();
              if (this.playIcon) this.playIcon.style.display = 'block';
              if (this.pauseIcon) this.pauseIcon.style.display = 'none';
            }
          });
        }

        if (this.muteBtn) {
          this.muteBtn.addEventListener('click', () => {
            const currentVolume = parseInt(this.volumeSlider.value);
            
            if (currentVolume === 0 || this.video.muted) {
              this.volumeSlider.value = 70;
              this.updateVolumeDisplay(70);
            } else {
              this.volumeSlider.value = 0;
              this.updateVolumeDisplay(0);
            }
          });
        }

        if (this.volumeSlider) {
          this.volumeSlider.addEventListener('input', (e) => {
            const volume = parseInt(e.target.value);
            this.updateVolumeDisplay(volume);
          });
        }

        if (this.fullscreenBtn) {
          this.fullscreenBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) {
              if (this.screenWrapper.requestFullscreen) {
                this.screenWrapper.requestFullscreen();
              } else if (this.screenWrapper.webkitRequestFullscreen) {
                this.screenWrapper.webkitRequestFullscreen();
              } else if (this.screenWrapper.msRequestFullscreen) {
                this.screenWrapper.msRequestFullscreen();
              }
            } else {
              if (document.exitFullscreen) {
                document.exitFullscreen();
              } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
              } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
              }
            }
          });
        }

        this.video.addEventListener('ended', () => {
          if (this.playIcon) this.playIcon.style.display = 'block';
          if (this.pauseIcon) this.pauseIcon.style.display = 'none';
        });
      }
    }

    customElements.define('retro-tv-player-{{ ai_gen_id }}', RetroTvPlayer{{ ai_gen_id }});
  })();
</script>

