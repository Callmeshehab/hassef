{% doc %}
  @prompt
    المطلوب ببساطة:
    
    عندي صورة PNG لإطار تلفاز قديم والشاشة مفرغة.
    
    أريد:
    	•	وضع مشغل فيديو داخل فتحة الشاشة فقط.
    	•	الفيديو يملأ الشاشة بالضبط بدون ما يطلع خارج الإطار.
    	•	يكون في المنتصف تمامًا.
    
    ⸻
    
    مهم جدًا:
    	•	صورة التلفاز والمشغل يكونوا داخل حاوية واحدة.
    	•	لما أكبر صورة التلفاز:
    	•	الفيديو يكبر معها تلقائيًا.
    	•	يظل داخل حدود الشاشة.
    	•	ما يخترب التناسق.
    
    يعني يكونوا مربوطين ببعض برمجيًا.
    
    ⸻
    
    أريد أيضًا:
    	•	أتحكم في حجم صورة التلفاز.
    	•	أتحكم في مكان الفيديو داخل الشاشة إذا احتجت.
    	•	المشغل يكون Responsive ويعمل على الموبايل.
    	•	لا يستخدم قياسات ثابتة بالبكسل، بل نسب مئوية.
    
    ⸻
    
    النتيجة النهائية:
    
    إذا كبرت التلفاز → الفيديو يكبر معه تلقائيًا
    إذا صغرت التلفاز → الفيديو يصغر معه
    ودائمًا يبقى مضبوط داخل الشاشة.
    , بدي زرين زر منفصلين للصوت وزر للتكبير وأنا اللي احدد موضعهم بدقه وكمان إطار تحت المشغل يكون فيه زرين للتقليب وصور مصغره للمقاطع الأخرى اللي رح أضيفهم مع أمكانيه اختيار اي فيديو منهم من الصوره المصغره بالضغط عليه او بزر التقليب وإضافة ما يقارب 10 مقاطع إضافيه غير الأساسية وكمان أتحكم بلون الأزرار وسمكها وكل شيء, بدي كل مقطع ارفعه من الجهاز وكمان الصوره المصغره تتحدد تلقائي من الفيديو المرفوع ولكن اترك الخيار ايضاً عادي كخيار أني يمكن ارفع وبالنسبه للمشغل حط خيار إظهار أدوات التحكم في المشغل المدمج, بدي تحوط مل القسم هذا بحواف أنا احدد سمكه وبرضو خيار لإمكانيه تحديد حواف لقسم الصور المصغره وبدي عن لما أوصل لأخر فيديو مصغر ظاهر تظهر الجديد مع التقليب مش بس القائمة اللي ظاهره, ممتاز بس الزر بتاع التكبير المنعزل لا يشتغل اطلاقاً أنا بدي تعدل الزر لكي يشغل الفيديو بوضع التكبير باي طريقه ممكنه للزائر وبدي اعدل موضع كل زر فيهم بشكل منفصل , حلو بس بدي المشغل خلف الإطار يعني الإطار ظاهر عليه لكي يحتويه
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tv-frame-container-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.main_container_padding }}px;
    border: {{ block.settings.main_container_border_width }}px solid {{ block.settings.main_container_border_color }};
    border-radius: {{ block.settings.main_container_border_radius }}px;
    background-color: {{ block.settings.main_container_bg_color }};
  }

  .ai-tv-frame-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-tv-video-container-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.video_position_top }}%;
    left: {{ block.settings.video_position_left }}%;
    width: {{ block.settings.video_width }}%;
    height: {{ block.settings.video_height }}%;
    transform: translate(-50%, -50%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .ai-tv-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tv-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
  }

  .ai-tv-frame-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    z-index: 2;
    pointer-events: none;
  }

  .ai-tv-frame-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .ai-tv-frame-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-tv-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-tv-mute-btn-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.mute_button_position_top }}%;
    left: {{ block.settings.mute_button_position_left }}%;
    transform: translate(-50%, -50%);
    z-index: 10;
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: {{ block.settings.button_radius }}px;
    background-color: {{ block.settings.button_bg_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    color: {{ block.settings.button_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-tv-mute-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-tv-mute-btn-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.button_size }}px * 0.5);
    height: calc({{ block.settings.button_size }}px * 0.5);
  }

  .ai-tv-fullscreen-btn-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.fullscreen_button_position_top }}%;
    left: {{ block.settings.fullscreen_button_position_left }}%;
    transform: translate(-50%, -50%);
    z-index: 10;
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: {{ block.settings.button_radius }}px;
    background-color: {{ block.settings.button_bg_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    color: {{ block.settings.button_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-tv-fullscreen-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-tv-fullscreen-btn-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.button_size }}px * 0.5);
    height: calc({{ block.settings.button_size }}px * 0.5);
  }

  .ai-tv-thumbnails-section-{{ ai_gen_id }} {
    margin-top: {{ block.settings.thumbnails_margin_top }}px;
    padding: {{ block.settings.thumbnails_padding }}px;
    background-color: {{ block.settings.thumbnails_bg_color }};
    border-radius: {{ block.settings.thumbnails_radius }}px;
    border: {{ block.settings.thumbnails_border_width }}px solid {{ block.settings.thumbnails_border_color }};
  }

  .ai-tv-thumbnails-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: {{ block.settings.thumbnails_gap }}px;
  }

  .ai-tv-nav-btn-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: {{ block.settings.nav_button_radius }}px;
    background-color: {{ block.settings.nav_button_bg_color }};
    border: {{ block.settings.nav_button_border_width }}px solid {{ block.settings.nav_button_border_color }};
    color: {{ block.settings.nav_button_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-tv-nav-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg_color }};
  }

  .ai-tv-nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-tv-nav-btn-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  .ai-tv-thumbnails-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-tv-thumbnails-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.thumbnails_gap }}px;
    transition: transform 0.3s ease;
  }

  .ai-tv-thumbnail-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.thumbnail_width }}px;
    height: {{ block.settings.thumbnail_height }}px;
    border-radius: {{ block.settings.thumbnail_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: {{ block.settings.thumbnail_border_width }}px solid {{ block.settings.thumbnail_border_color }};
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-tv-thumbnail-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    border-color: {{ block.settings.thumbnail_hover_border_color }};
  }

  .ai-tv-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.thumbnail_active_border_color }};
    border-width: {{ block.settings.thumbnail_active_border_width }}px;
  }

  .ai-tv-thumbnail-{{ ai_gen_id }} img,
  .ai-tv-thumbnail-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tv-thumbnail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 12px;
  }

  .ai-tv-thumbnail-play-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .ai-tv-thumbnail-play-icon-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  .ai-tv-fullscreen-container-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .ai-tv-fullscreen-container-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-tv-fullscreen-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-tv-fullscreen-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.2);
    border: 2px solid #fff;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    transition: all 0.3s ease;
  }

  .ai-tv-fullscreen-close-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.4);
    transform: scale(1.1);
  }

  .ai-tv-fullscreen-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-tv-frame-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tv-mute-btn-{{ ai_gen_id }},
    .ai-tv-fullscreen-btn-{{ ai_gen_id }} {
      width: calc({{ block.settings.button_size }}px * 0.8);
      height: calc({{ block.settings.button_size }}px * 0.8);
    }

    .ai-tv-thumbnail-{{ ai_gen_id }} {
      width: calc({{ block.settings.thumbnail_width }}px * 0.8);
      height: calc({{ block.settings.thumbnail_height }}px * 0.8);
    }
  }
{% endstyle %}

<tv-frame-video-{{ ai_gen_id }}
  class="ai-tv-frame-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tv-frame-wrapper-{{ ai_gen_id }}">
    <div class="ai-tv-video-container-{{ ai_gen_id }}">
      {% if block.settings.video_1 %}
        <video
          class="ai-tv-video-{{ ai_gen_id }}"
          loop
          muted
          playsinline
          {% if block.settings.show_native_controls %}controls{% endif %}
          data-video-index="0"
        >
          <source src="{{ block.settings.video_1.sources[1].url }}" type="video/mp4">
          المتصفح لا يدعم تشغيل الفيديو
        </video>
      {% else %}
        <div class="ai-tv-video-placeholder-{{ ai_gen_id }}">
          أضف فيديو
        </div>
      {% endif %}
    </div>

    {% if block.settings.tv_frame_image %}
      <img
        src="{{ block.settings.tv_frame_image | image_url: width: 2000 }}"
        alt="{{ block.settings.tv_frame_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.tv_frame_image.width }}"
        height="{{ block.settings.tv_frame_image.height }}"
        class="ai-tv-frame-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-tv-frame-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-tv-empty-state-{{ ai_gen_id }}">
          أضف صورة إطار التلفاز
        </div>
      </div>
    {% endif %}

    <button
      class="ai-tv-mute-btn-{{ ai_gen_id }}"
      aria-label="كتم الصوت"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path class="ai-tv-sound-wave-{{ ai_gen_id }}" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
    </button>

    <button
      class="ai-tv-fullscreen-btn-{{ ai_gen_id }}"
      aria-label="ملء الشاشة"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
      </svg>
    </button>
  </div>

  <div class="ai-tv-thumbnails-section-{{ ai_gen_id }}">
    <div class="ai-tv-thumbnails-header-{{ ai_gen_id }}">
      <button
        class="ai-tv-nav-btn-{{ ai_gen_id }} ai-tv-prev-btn-{{ ai_gen_id }}"
        aria-label="السابق"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-tv-nav-btn-{{ ai_gen_id }} ai-tv-next-btn-{{ ai_gen_id }}"
        aria-label="التالي"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-tv-thumbnails-wrapper-{{ ai_gen_id }}">
      <div class="ai-tv-thumbnails-track-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign custom_thumbnail_key = 'custom_thumbnail_' | append: i
            assign video = block.settings[video_key]
            assign custom_thumbnail = block.settings[custom_thumbnail_key]
          %}

          {% if video %}
            <div class="ai-tv-thumbnail-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-video-index="{{ i | minus: 1 }}" data-video-url="{{ video.sources[1].url }}">
              {% if custom_thumbnail %}
                <img
                  src="{{ custom_thumbnail | image_url: width: 200 }}"
                  alt="فيديو {{ i }}"
                  loading="lazy"
                >
              {% else %}
                <video muted playsinline>
                  <source src="{{ video.sources[1].url }}" type="video/mp4">
                </video>
              {% endif %}
              <div class="ai-tv-thumbnail-play-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-tv-fullscreen-container-{{ ai_gen_id }}">
    <video
      class="ai-tv-fullscreen-video-{{ ai_gen_id }}"
      controls
      playsinline
    ></video>
    <button
      class="ai-tv-fullscreen-close-{{ ai_gen_id }}"
      aria-label="إغلاق"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</tv-frame-video-{{ ai_gen_id }}>

<script>
  (function() {
    class TvFrameVideo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentVideoIndex = 0;
        this.scrollOffset = 0;
        this.visibleThumbnails = 3;
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-tv-video-{{ ai_gen_id }}');
        this.muteBtn = this.querySelector('.ai-tv-mute-btn-{{ ai_gen_id }}');
        this.fullscreenBtn = this.querySelector('.ai-tv-fullscreen-btn-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-tv-prev-btn-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-tv-next-btn-{{ ai_gen_id }}');
        this.thumbnails = this.querySelectorAll('.ai-tv-thumbnail-{{ ai_gen_id }}');
        this.thumbnailsTrack = this.querySelector('.ai-tv-thumbnails-track-{{ ai_gen_id }}');
        this.thumbnailsWrapper = this.querySelector('.ai-tv-thumbnails-wrapper-{{ ai_gen_id }}');
        this.fullscreenContainer = this.querySelector('.ai-tv-fullscreen-container-{{ ai_gen_id }}');
        this.fullscreenVideo = this.querySelector('.ai-tv-fullscreen-video-{{ ai_gen_id }}');
        this.fullscreenCloseBtn = this.querySelector('.ai-tv-fullscreen-close-{{ ai_gen_id }}');

        if (this.video) {
          this.setupVideo();
          this.setupControls();
          this.setupThumbnails();
          this.loadThumbnailVideos();
          this.calculateVisibleThumbnails();
          this.video.play().catch(() => {});
        }

        window.addEventListener('resize', () => {
          this.calculateVisibleThumbnails();
        });
      }

      setupVideo() {
        this.video.addEventListener('loadedmetadata', () => {
          this.adjustVideoSize();
        });

        window.addEventListener('resize', () => {
          this.adjustVideoSize();
        });
      }

      adjustVideoSize() {
        const container = this.querySelector('.ai-tv-video-container-{{ ai_gen_id }}');
        if (!container || !this.video) return;

        const containerWidth = container.offsetWidth;
        const containerHeight = container.offsetHeight;
        const videoAspectRatio = this.video.videoWidth / this.video.videoHeight;
        const containerAspectRatio = containerWidth / containerHeight;

        if (videoAspectRatio > containerAspectRatio) {
          this.video.style.width = 'auto';
          this.video.style.height = '100%';
        } else {
          this.video.style.width = '100%';
          this.video.style.height = 'auto';
        }
      }

      setupControls() {
        this.muteBtn.addEventListener('click', () => {
          this.video.muted = !this.video.muted;
          const soundWave = this.muteBtn.querySelector('.ai-tv-sound-wave-{{ ai_gen_id }}');
          if (this.video.muted) {
            soundWave.style.display = 'none';
          } else {
            soundWave.style.display = 'block';
          }
        });

        this.fullscreenBtn.addEventListener('click', () => {
          this.openFullscreen();
        });

        this.fullscreenCloseBtn.addEventListener('click', () => {
          this.closeFullscreen();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.fullscreenContainer.classList.contains('active')) {
            this.closeFullscreen();
          }
        });

        this.prevBtn.addEventListener('click', () => {
          this.navigateVideo(-1);
        });

        this.nextBtn.addEventListener('click', () => {
          this.navigateVideo(1);
        });
      }

      openFullscreen() {
        if (!this.video) return;

        this.fullscreenVideo.src = this.video.src;
        this.fullscreenVideo.currentTime = this.video.currentTime;
        this.fullscreenVideo.muted = this.video.muted;
        this.fullscreenContainer.classList.add('active');
        this.fullscreenVideo.play().catch(() => {});

        document.body.style.overflow = 'hidden';
      }

      closeFullscreen() {
        this.fullscreenContainer.classList.remove('active');
        this.fullscreenVideo.pause();
        this.fullscreenVideo.src = '';

        if (this.video) {
          this.video.currentTime = this.fullscreenVideo.currentTime;
        }

        document.body.style.overflow = '';
      }

      setupThumbnails() {
        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            const videoIndex = parseInt(thumbnail.dataset.videoIndex);
            this.switchVideo(videoIndex);
          });
        });

        this.updateNavigationButtons();
      }

      loadThumbnailVideos() {
        this.thumbnails.forEach((thumbnail) => {
          const video = thumbnail.querySelector('video');
          if (video) {
            video.currentTime = 1;
            video.addEventListener('loadeddata', () => {
              video.pause();
            });
          }
        });
      }

      calculateVisibleThumbnails() {
        if (!this.thumbnailsWrapper || this.thumbnails.length === 0) return;

        const wrapperWidth = this.thumbnailsWrapper.offsetWidth;
        const thumbnailWidth = this.thumbnails[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.thumbnailsTrack).gap) || 10;

        this.visibleThumbnails = Math.floor(wrapperWidth / (thumbnailWidth + gap));
        if (this.visibleThumbnails < 1) this.visibleThumbnails = 1;
      }

      navigateVideo(direction) {
        const newIndex = this.currentVideoIndex + direction;
        if (newIndex >= 0 && newIndex < this.thumbnails.length) {
          this.switchVideo(newIndex);
          this.scrollToThumbnail(newIndex);
        }
      }

      scrollToThumbnail(index) {
        if (!this.thumbnailsTrack || this.thumbnails.length === 0) return;

        const thumbnail = this.thumbnails[index];
        const thumbnailWidth = thumbnail.offsetWidth;
        const gap = parseInt(getComputedStyle(this.thumbnailsTrack).gap) || 10;
        const itemWidth = thumbnailWidth + gap;

        if (index >= this.scrollOffset + this.visibleThumbnails) {
          this.scrollOffset = index - this.visibleThumbnails + 1;
        } else if (index < this.scrollOffset) {
          this.scrollOffset = index;
        }

        const maxScroll = Math.max(0, this.thumbnails.length - this.visibleThumbnails);
        this.scrollOffset = Math.min(this.scrollOffset, maxScroll);
        this.scrollOffset = Math.max(0, this.scrollOffset);

        const translateX = -(this.scrollOffset * itemWidth);
        this.thumbnailsTrack.style.transform = `translateX(${translateX}px)`;
      }

      switchVideo(index) {
        if (index < 0 || index >= this.thumbnails.length) return;

        this.currentVideoIndex = index;
        const thumbnail = this.thumbnails[index];
        const videoUrl = thumbnail.dataset.videoUrl;

        this.video.src = videoUrl;
        this.video.load();
        this.video.play().catch(() => {});

        this.thumbnails.forEach((t) => t.classList.remove('active'));
        thumbnail.classList.add('active');

        this.updateNavigationButtons();
      }

      updateNavigationButtons() {
        this.prevBtn.disabled = this.currentVideoIndex === 0;
        this.nextBtn.disabled = this.currentVideoIndex === this.thumbnails.length - 1;
      }
    }

    customElements.define('tv-frame-video-{{ ai_gen_id }}', TvFrameVideo{{ ai_gen_id }});
  })();
</script>

