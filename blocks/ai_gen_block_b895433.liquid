{% doc %}
  @prompt
    <div style="max-width:1000px;margin:auto">
    
    <object 
    data="magazine.pdf" 
    type="application/pdf" 
    width="100%" 
    height="800px"
    style="border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,.2);">
    
    </object>
    
    </div>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-viewer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-pdf-viewer-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: 0 {{ block.settings.shadow_vertical_offset }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pdf-viewer-object-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.viewer_height }}px;
    border: none;
    display: block;
  }

  .ai-pdf-viewer-fallback-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pdf-viewer-fallback-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-pdf-viewer-fallback-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-pdf-viewer-fallback-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-pdf-viewer-empty-state-{{ ai_gen_id }} {
    padding: 60px 20px;
    text-align: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-pdf-viewer-empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  .ai-pdf-viewer-empty-message-{{ ai_gen_id }} {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-pdf-viewer-object-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_viewer_height }}px;
    }
  }
{% endstyle %}

<pdf-viewer-{{ ai_gen_id }} class="ai-pdf-viewer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.pdf_url != blank %}
    <div class="ai-pdf-viewer-container-{{ ai_gen_id }}">
      <object
        data="{{ block.settings.pdf_url }}"
        type="application/pdf"
        class="ai-pdf-viewer-object-{{ ai_gen_id }}"
        aria-label="{{ block.settings.pdf_title }}"
      >
        <div class="ai-pdf-viewer-fallback-{{ ai_gen_id }}">
          <p class="ai-pdf-viewer-fallback-title-{{ ai_gen_id }}">
            {% if block.settings.fallback_message != blank %}
              {{ block.settings.fallback_message }}
            {% else %}
              Your browser doesn't support PDF viewing
            {% endif %}
          </p>
          <a
            href="{{ block.settings.pdf_url }}"
            class="ai-pdf-viewer-fallback-link-{{ ai_gen_id }}"
            download
          >
            {% if block.settings.download_button_text != blank %}
              {{ block.settings.download_button_text }}
            {% else %}
              Download PDF
            {% endif %}
          </a>
        </div>
      </object>
    </div>
  {% else %}
    <div class="ai-pdf-viewer-empty-state-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      <p class="ai-pdf-viewer-empty-message-{{ ai_gen_id }}">
        Next, add a PDF URL to display the document
      </p>
    </div>
  {% endif %}
</pdf-viewer-{{ ai_gen_id }}>

<script>
  (function() {
    class PdfViewer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const objectElement = this.querySelector('.ai-pdf-viewer-object-{{ ai_gen_id }}');
        if (objectElement) {
          objectElement.addEventListener('load', () => {
            console.log('PDF loaded successfully');
          });
        }
      }
    }

    customElements.define('pdf-viewer-{{ ai_gen_id }}', PdfViewer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "PDF viewer",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "PDF document"
    },
    {
      "type": "text",
      "id": "pdf_url",
      "label": "PDF URL",
      "info": "Enter the full URL to your PDF file (e.g., https://example.com/magazine.pdf)"
    },
    {
      "type": "text",
      "id": "pdf_title",
      "label": "PDF title",
      "default": "PDF Document"
    },
    {
      "type": "header",
      "content": "Viewer settings"
    },
    {
      "type": "range",
      "id": "viewer_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "mobile_viewer_height",
      "label": "Mobile height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "shadow_vertical_offset",
      "label": "Shadow vertical offset",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Fallback settings"
    },
    {
      "type": "text",
      "id": "fallback_message",
      "label": "Fallback message",
      "default": "Your browser doesn't support PDF viewing"
    },
    {
      "type": "text",
      "id": "download_button_text",
      "label": "Download button text",
      "default": "Download PDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3d081b"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#910f3f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#f2efdd"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#3d081b"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "PDF viewer"
    }
  ]
}
{% endschema %}
