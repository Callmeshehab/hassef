{% doc %}
  @prompt
    شركاء الحصيف , بدي شعارات الشركاء تتحرك كانها استعراض 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-partners-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
    overflow: hidden;
  }

  .ai-partners-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_heading }}px;
    font-weight: 600;
  }

  .ai-partners-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.spacing_below_subheading }}px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    width: max-content;
  }

  @keyframes ai-scroll-ltr-{{ ai_gen_id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - {{ block.settings.grid_gap | divided_by: 2 }}px)); }
  }

  @keyframes ai-scroll-rtl-{{ ai_gen_id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(50% + {{ block.settings.grid_gap | divided_by: 2 }}px)); }
  }

  .ai-carousel-track-{{ ai_gen_id }}.ai-scroll-ltr-{{ ai_gen_id }} {
    animation: ai-scroll-ltr-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-carousel-track-{{ ai_gen_id }}.ai-scroll-rtl-{{ ai_gen_id }} {
    animation: ai-scroll-rtl-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-carousel-track-{{ ai_gen_id }}.ai-paused-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-partner-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
    width: {{ block.settings.item_width }}px;
  }

  .ai-partner-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-partner-logo-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.spacing_below_logo }}px;
  }

  .ai-partner-logo-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale({{ block.settings.logo_grayscale }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .ai-partner-item-{{ ai_gen_id }}:hover .ai-partner-logo-{{ ai_gen_id }} {
    filter: grayscale(0%);
    opacity: 1;
  }

  .ai-partner-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-partner-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-partner-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.partner_name_size }}px;
    color: {{ block.settings.partner_name_color }};
    font-weight: 600;
    margin: 0 0 8px;
  }

  .ai-partner-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.partner_description_size }}px;
    color: {{ block.settings.partner_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-partners-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-partners-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-partner-item-{{ ai_gen_id }} {
      width: {{ block.settings.item_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<partners-carousel-{{ ai_gen_id }} class="ai-partners-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-partners-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <div class="ai-partners-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
  {% endif %}

  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign logo_key = 'partner_' | append: i | append: '_logo'
          assign name_key = 'partner_' | append: i | append: '_name'
          assign description_key = 'partner_' | append: i | append: '_description'
          assign url_key = 'partner_' | append: i | append: '_url'

          assign partner_logo = block.settings[logo_key]
          assign partner_name = block.settings[name_key]
          assign partner_description = block.settings[description_key]
          assign partner_url = block.settings[url_key]
        %}

        {% if partner_logo != blank or partner_name != blank %}
          <div class="ai-partner-item-{{ ai_gen_id }}">
            {% if partner_url != blank %}
              <a href="{{ partner_url }}" style="text-decoration: none; color: inherit; width: 100%;">
            {% endif %}

            <div class="ai-partner-logo-wrapper-{{ ai_gen_id }}">
              {% if partner_logo %}
                <img
                  src="{{ partner_logo | image_url: width: 400 }}"
                  alt="{{ partner_name | escape }}"
                  class="ai-partner-logo-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.logo_height }}"
                >
              {% else %}
                <div class="ai-partner-logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if partner_name != blank %}
              <h3 class="ai-partner-name-{{ ai_gen_id }}">{{ partner_name }}</h3>
            {% endif %}

            {% if partner_description != blank %}
              <p class="ai-partner-description-{{ ai_gen_id }}">{{ partner_description }}</p>
            {% endif %}

            {% if partner_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% for i in (1..6) %}
        {% liquid
          assign logo_key = 'partner_' | append: i | append: '_logo'
          assign name_key = 'partner_' | append: i | append: '_name'
          assign description_key = 'partner_' | append: i | append: '_description'
          assign url_key = 'partner_' | append: i | append: '_url'

          assign partner_logo = block.settings[logo_key]
          assign partner_name = block.settings[name_key]
          assign partner_description = block.settings[description_key]
          assign partner_url = block.settings[url_key]
        %}

        {% if partner_logo != blank or partner_name != blank %}
          <div class="ai-partner-item-{{ ai_gen_id }}" aria-hidden="true">
            {% if partner_url != blank %}
              <a href="{{ partner_url }}" style="text-decoration: none; color: inherit; width: 100%;" tabindex="-1">
            {% endif %}

            <div class="ai-partner-logo-wrapper-{{ ai_gen_id }}">
              {% if partner_logo %}
                <img
                  src="{{ partner_logo | image_url: width: 400 }}"
                  alt="{{ partner_name | escape }}"
                  class="ai-partner-logo-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.logo_height }}"
                >
              {% else %}
                <div class="ai-partner-logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if partner_name != blank %}
              <h3 class="ai-partner-name-{{ ai_gen_id }}">{{ partner_name }}</h3>
            {% endif %}

            {% if partner_description != blank %}
              <p class="ai-partner-description-{{ ai_gen_id }}">{{ partner_description }}</p>
            {% endif %}

            {% if partner_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</partners-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PartnersCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.pauseOnHover = {{ block.settings.pause_on_hover }};
        this.autoScroll = {{ block.settings.auto_scroll }};
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        if (!this.track) return;

        if (this.autoScroll) {
          const isRTL = document.documentElement.dir === 'rtl'
                     || getComputedStyle(document.documentElement).direction === 'rtl';

          if (isRTL) {
            this.track.classList.add('ai-scroll-rtl-{{ ai_gen_id }}');
          } else {
            this.track.classList.add('ai-scroll-ltr-{{ ai_gen_id }}');
          }
        }

        if (this.pauseOnHover) {
          this.track.addEventListener('mouseenter', () => {
            this.track.classList.add('ai-paused-{{ ai_gen_id }}');
          });
          this.track.addEventListener('mouseleave', () => {
            this.track.classList.remove('ai-paused-{{ ai_gen_id }}');
          });
        }
      }
    }

    customElements.define('partners-carousel-{{ ai_gen_id }}', PartnersCarousel{{ ai_gen_id }});
  })();
</script>

