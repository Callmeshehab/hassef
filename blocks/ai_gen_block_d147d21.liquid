{% comment %}
╔══════════════════════════════════════════════════════════════╗
║         ركن أصدقاء الحصيف — النسخة الاحترافية v2           ║
║                                                              ║
║  دليل الإعداد (مرة واحدة فقط):                              ║
║                                                              ║
║  ١. Supabase                                                 ║
║     - أنشئ حساباً على https://supabase.com                  ║
║     - أنشئ مشروعاً جديداً                                   ║
║     - افتح SQL Editor وشغّل هذا الكود:                      ║
║                                                              ║
║  create table posts (                                        ║
║    id uuid default gen_random_uuid() primary key,           ║
║    type text not null,                                       ║
║    author text not null,                                     ║
║    content text,                                             ║
║    image_url text,                                           ║
║    book_name text,                                           ║
║    book_author text,                                         ║
║    comment_title text,                                       ║
║    approved boolean default false,                           ║
║    likes_count integer default 0,                            ║
║    created_at timestamptz default now()                      ║
║  );                                                          ║
║                                                              ║
║  alter table posts enable row level security;                ║
║                                                              ║
║  create policy "Anyone can read approved posts"              ║
║    on posts for select                                       ║
║    using (approved = true);                                  ║
║                                                              ║
║  create policy "Anyone can insert posts"                     ║
║    on posts for insert                                       ║
║    with check (true);                                        ║
║                                                              ║
║  create policy "Service role can update"                     ║
║    on posts for update                                       ║
║    using (true);                                             ║
║                                                              ║
║     - اذهب إلى Settings > API                               ║
║     - انسخ: Project URL و anon public key                   ║
║     - ضعهما في إعدادات البلوك في Shopify                    ║
║                                                              ║
║  ٢. ImgBB                                                    ║
║     - أنشئ حساباً على https://imgbb.com                     ║
║     - اذهب إلى API > Get API Key                            ║
║     - انسخ الـ Key وضعه في إعدادات البلوك                  ║
║                                                              ║
║  ٣. Moderation                                               ║
║     - لمراجعة المشاركات: اذهب إلى Supabase > Table Editor  ║
║     - غيّر approved من false إلى true للمشاركات التي تريدها║
║                                                              ║
