{% doc %}
  @prompt
    قسم لعرض أشرطة الكاسيت الرائجة بنفس هوية قسم المقالات الفلسطيني الريترو
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cassette-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
    position: relative;
  }

  .ai-cassette-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  /* ── HEADER ── */
  .ai-cassette-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
    position: relative;
  }

  .ai-cassette-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: 700;
    position: relative;
    display: inline-block;
  }

  .ai-cassette-title-{{ ai_gen_id }}::before,
  .ai-cassette-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 50%;
    width: {{ block.settings.title_decoration_width }}px;
    height: {{ block.settings.title_decoration_height }}px;
    transform: translateY(-50%);
  }

  .ai-cassette-title-{{ ai_gen_id }}::before {
    right: calc(100% + {{ block.settings.title_decoration_spacing }}px);
    background: repeating-linear-gradient(90deg, {{ block.settings.accent_color }} 0px, {{ block.settings.accent_color }} 8px, transparent 8px, transparent 12px);
  }

  .ai-cassette-title-{{ ai_gen_id }}::after {
    left: calc(100% + {{ block.settings.title_decoration_spacing }}px);
    background: repeating-linear-gradient(90deg, {{ block.settings.accent_color }} 0px, {{ block.settings.accent_color }} 8px, transparent 8px, transparent 12px);
  }

  .ai-cassette-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  /* ── SCROLL MODE ── */
  .ai-cassette-scroll-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    margin-bottom: {{ block.settings.grid_margin_bottom }}px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.accent_color }} transparent;
  }

  .ai-cassette-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar { height: 8px; }
  .ai-cassette-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track { background: transparent; }
  .ai-cassette-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb { background: {{ block.settings.accent_color }}; border-radius: 4px; }

  .ai-cassette-grid-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    min-width: min-content;
  }

  .ai-cassette-grid-scroll-{{ ai_gen_id }}[data-count="1"] {
    justify-content: center;
    min-width: unset;
  }

  /* ── GRID MODE ── */
  .ai-cassette-grid-wrap-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.grid_margin_bottom }}px;
  }

  .ai-cassette-grid-multi-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.grid_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  /* ── SLIDER MODE ── */
  .ai-cassette-slider-outer-{{ ai_gen_id }} {
    overflow: hidden;
    margin-bottom: {{ block.settings.grid_margin_bottom }}px;
    position: relative;
  }

  .ai-cassette-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* نقاط التنقل */
  .ai-cassette-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    margin-bottom: {{ block.settings.grid_margin_bottom }}px;
  }

  .ai-cassette-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: {{ block.settings.card_border_color }};
    opacity: 0.25;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s, width 0.3s, background 0.3s;
  }

  .ai-cassette-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    width: 24px;
    background: {{ block.settings.accent_color }};
  }

  /* ── CARD (مشترك) ── */
  .ai-cassette-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    position: relative;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-cassette-grid-scroll-{{ ai_gen_id }} .ai-cassette-card-{{ ai_gen_id }},
  .ai-cassette-slider-track-{{ ai_gen_id }} .ai-cassette-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    width: {{ block.settings.card_width }}px;
  }

  .ai-cassette-card-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.card_hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_x | times: 1.5 }}px {{ block.settings.card_shadow_y | times: 1.5 }}px {{ block.settings.card_shadow_blur | times: 1.5 }}px {{ block.settings.card_shadow_color }};
  }

  /* نمط التطريز */
  .ai-cassette-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: {{ block.settings.pattern_height }}px;
    background: repeating-linear-gradient(
      90deg,
      {{ block.settings.pattern_color_1 }} 0px,
      {{ block.settings.pattern_color_1 }} {{ block.settings.pattern_stripe_width }}px,
      {{ block.settings.pattern_color_2 }} {{ block.settings.pattern_stripe_width }}px,
      {{ block.settings.pattern_color_2 }} {{ block.settings.pattern_stripe_width | times: 2 }}px,
      {{ block.settings.pattern_color_3 }} {{ block.settings.pattern_stripe_width | times: 2 }}px,
      {{ block.settings.pattern_color_3 }} {{ block.settings.pattern_stripe_width | times: 3 }}px
    );
    z-index: 2;
  }

  /* ── IMAGE ── */
/* ── IMAGE ── */
.ai-cassette-image-wrapper-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  /* إزالة الـ aspect-ratio الثابت عشان الصورة تبقى حسب أبعادها الأصلية */
  height: auto;
  overflow: hidden;
  /* اختياري: لو عايز تحافظ على شكل الكاسيت أكتر، استخدم padding-bottom بدل aspect-ratio */
  /* padding-bottom: 125%; */ /* ≈ نسبة كاسيت حقيقي (طول أكبر من العرض) */
}

.ai-cassette-image-{{ ai_gen_id }} {
  position: relative;     /* غير absolute عشان ياخد الارتفاع الطبيعي */
  width: 100%;
  height: auto;           /* مهم جداً */
  object-fit: contain;    /* بدل cover → عشان الصورة تبقى كاملة بدون قص */
  display: block;
}

  .ai-cassette-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.image_placeholder_bg }};
  }

  /* بادج */
  .ai-cassette-trending-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.pattern_height | plus: 10 }}px;
    {% if block.settings.badge_position == 'right' %}right{% else %}left{% endif %}: 12px;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.badge_color }};
    font-size: {{ block.settings.badge_size }}px;
    font-weight: 800;
    padding: 3px 10px;
    border: 2px solid {{ block.settings.card_border_color }};
    border-radius: 3px;
    z-index: 3;
    box-shadow: 2px 2px 0 {{ block.settings.card_border_color }};
  }

  /* ── CONTENT ── */
  .ai-cassette-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding_top }}px {{ block.settings.card_padding_horizontal }}px {{ block.settings.card_padding_bottom }}px;
    position: relative;
  }

  .ai-cassette-content-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: {{ block.settings.card_padding_horizontal }}px;
    right: {{ block.settings.card_padding_horizontal }}px;
    height: {{ block.settings.content_divider_height }}px;
    background: repeating-linear-gradient(90deg, {{ block.settings.accent_color }} 0px, {{ block.settings.accent_color }} 4px, transparent 4px, transparent 8px);
  }

  .ai-cassette-rank-{{ ai_gen_id }} {
    font-size: {{ block.settings.rank_size }}px;
    color: {{ block.settings.accent_color }};
    margin: 0 0 {{ block.settings.rank_margin_bottom }}px;
    font-weight: 800;
    letter-spacing: {{ block.settings.date_letter_spacing }}px;
  }

  .ai-cassette-tape-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.tape_title_size }}px;
    color: {{ block.settings.tape_title_color }};
    margin: 0 0 {{ block.settings.tape_title_margin_bottom }}px;
    font-weight: 700;
    line-height: {{ block.settings.tape_title_line_height }};
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.tape_title_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-cassette-tape-title-{{ ai_gen_id }} a { color: inherit; text-decoration: none; }
  .ai-cassette-tape-title-{{ ai_gen_id }} a:hover { color: {{ block.settings.accent_color }}; }

  .ai-cassette-artist-{{ ai_gen_id }} {
    font-size: {{ block.settings.artist_size }}px;
    color: {{ block.settings.artist_color }};
    margin: 0 0 {{ block.settings.artist_margin_bottom }}px;
    line-height: {{ block.settings.excerpt_line_height }};
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.excerpt_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* زر التشغيل — نفس أسلوب "اقرأ المزيد" */
  .ai-cassette-play-link-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.play_btn_size }}px;
    color: {{ block.settings.play_btn_color }};
    text-decoration: none;
    font-weight: {{ block.settings.play_btn_weight }};
    cursor: pointer;
    transition: color 0.3s ease;
    position: relative;
    letter-spacing: {{ block.settings.play_btn_letter_spacing }}px;
  }

  .ai-cassette-play-link-{{ ai_gen_id }}:hover { color: {{ block.settings.play_btn_hover_color }}; }

  .ai-cassette-play-link-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: {{ block.settings.play_btn_underline_offset }}px;
    left: 0;
    width: 0;
    height: {{ block.settings.play_btn_underline_height }}px;
    background: {{ block.settings.play_btn_hover_color }};
    transition: width 0.3s ease;
  }

  .ai-cassette-play-link-{{ ai_gen_id }}:hover::after { width: 100%; }

  /* ── زر عرض المزيد ── */
  .ai-cassette-view-all-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.view_all_margin_top }}px;
  }

  .ai-cassette-view-all-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.view_all_icon_gap }}px;
    font-size: {{ block.settings.view_all_font_size }}px;
    color: {{ block.settings.view_all_text_color }};
    background: {{ block.settings.view_all_bg_color }};
    padding: {{ block.settings.view_all_padding_vertical }}px {{ block.settings.view_all_padding_horizontal }}px;
    border-radius: {{ block.settings.view_all_border_radius }}px;
    text-decoration: none;
    font-weight: {{ block.settings.view_all_font_weight }};
    border: {{ block.settings.view_all_border_width }}px solid {{ block.settings.view_all_border_color }};
    transition: all 0.3s ease;
    box-shadow: {{ block.settings.view_all_shadow_x }}px {{ block.settings.view_all_shadow_y }}px 0 {{ block.settings.view_all_shadow_color }};
  }

  .ai-cassette-view-all-link-{{ ai_gen_id }}:hover {
    transform: translate({{ block.settings.view_all_hover_translate }}px, {{ block.settings.view_all_hover_translate }}px);
    box-shadow: {{ block.settings.view_all_shadow_x | divided_by: 2 }}px {{ block.settings.view_all_shadow_y | divided_by: 2 }}px 0 {{ block.settings.view_all_shadow_color }};
    background: {{ block.settings.view_all_hover_bg }};
    color: {{ block.settings.view_all_hover_text }};
  }

  .ai-cassette-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.subtitle_color }};
    font-size: 16px;
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    .ai-cassette-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }
    .ai-cassette-title-{{ ai_gen_id }}::before,
    .ai-cassette-title-{{ ai_gen_id }}::after { display: none; }
    .ai-cassette-grid-multi-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.grid_columns_mobile }}, 1fr);
    }
    .ai-cassette-grid-scroll-{{ ai_gen_id }} .ai-cassette-card-{{ ai_gen_id }},
    .ai-cassette-slider-track-{{ ai_gen_id }} .ai-cassette-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
      width: {{ block.settings.card_width_mobile }}px;
    }
    .ai-cassette-title-{{ ai_gen_id }} { font-size: {{ block.settings.title_size_mobile }}px; }
    .ai-cassette-tape-title-{{ ai_gen_id }} { font-size: {{ block.settings.tape_title_size_mobile }}px; }
  }
{% endstyle %}

{%- assign display_mode = block.settings.display_mode -%}

<cassette-section-{{ ai_gen_id }}
  class="ai-cassette-{{ ai_gen_id }}"
  data-mode="{{ display_mode }}"
  data-auto="{{ block.settings.auto_scroll }}"
  data-speed="{{ block.settings.scroll_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-cassette-container-{{ ai_gen_id }}">

    {% if block.settings.show_header %}
      <div class="ai-cassette-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-cassette-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-cassette-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% assign products = block.settings.collection.products %}
      {% assign tapes_count = block.settings.tapes_count %}

      {% if products.size > 0 %}

        {%- comment -%} ── وضع السكرول ── {%- endcomment -%}
        {% if display_mode == 'scroll' %}
          {% assign actual_count = products.size %}
          {% if actual_count > tapes_count %}{% assign actual_count = tapes_count %}{% endif %}
          <div class="ai-cassette-scroll-wrapper-{{ ai_gen_id }}">
            <div class="ai-cassette-grid-scroll-{{ ai_gen_id }}" data-count="{{ actual_count }}">
              {% for product in products limit: tapes_count %}
                {%- assign r = forloop.index -%}
                <article class="ai-cassette-card-{{ ai_gen_id }}">
                  {% if block.settings.show_trending_badge %}
                    <div class="ai-cassette-trending-badge-{{ ai_gen_id }}">{{ block.settings.badge_prefix }}{{ r }}</div>
                  {% endif %}
                  <div class="ai-cassette-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="ai-cassette-image-{{ ai_gen_id }}" loading="lazy" width="600" height="400">
                    {% else %}
                      <div class="ai-cassette-placeholder-{{ ai_gen_id }}">
                        <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" width="70%" style="opacity:.25"><rect x="4" y="4" width="112" height="72" rx="6" stroke="{{ block.settings.accent_color }}" stroke-width="4" fill="none"/><circle cx="38" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="82" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="38" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><circle cx="82" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><path d="M52 42 Q60 36 68 42" stroke="{{ block.settings.accent_color }}" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-cassette-content-{{ ai_gen_id }}">
                    {% if block.settings.show_rank %}<div class="ai-cassette-rank-{{ ai_gen_id }}">{{ block.settings.rank_prefix }}{{ r }}</div>{% endif %}
                    <h3 class="ai-cassette-tape-title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                    {% if block.settings.show_artist %}
                      {% if product.metafields.custom.artist != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.metafields.custom.artist }}</div>
                      {% elsif product.description != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.description | strip_html | truncate: 100 }}</div>
                      {% endif %}
                    {% endif %}
                    {% if block.settings.show_play_btn %}<a href="{{ product.url }}" class="ai-cassette-play-link-{{ ai_gen_id }}">{{ block.settings.play_btn_text }}</a>{% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>

        {%- comment -%} ── وضع الشبكة ── {%- endcomment -%}
        {% elsif display_mode == 'grid' %}
          <div class="ai-cassette-grid-wrap-{{ ai_gen_id }}">
            <div class="ai-cassette-grid-multi-{{ ai_gen_id }}">
              {% for product in products limit: tapes_count %}
                {%- assign r = forloop.index -%}
                <article class="ai-cassette-card-{{ ai_gen_id }}">
                  {% if block.settings.show_trending_badge %}
                    <div class="ai-cassette-trending-badge-{{ ai_gen_id }}">{{ block.settings.badge_prefix }}{{ r }}</div>
                  {% endif %}
                  <div class="ai-cassette-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="ai-cassette-image-{{ ai_gen_id }}" loading="lazy" width="600" height="400">
                    {% else %}
                      <div class="ai-cassette-placeholder-{{ ai_gen_id }}">
                        <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" width="70%" style="opacity:.25"><rect x="4" y="4" width="112" height="72" rx="6" stroke="{{ block.settings.accent_color }}" stroke-width="4" fill="none"/><circle cx="38" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="82" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="38" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><circle cx="82" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><path d="M52 42 Q60 36 68 42" stroke="{{ block.settings.accent_color }}" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-cassette-content-{{ ai_gen_id }}">
                    {% if block.settings.show_rank %}<div class="ai-cassette-rank-{{ ai_gen_id }}">{{ block.settings.rank_prefix }}{{ r }}</div>{% endif %}
                    <h3 class="ai-cassette-tape-title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                    {% if block.settings.show_artist %}
                      {% if product.metafields.custom.artist != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.metafields.custom.artist }}</div>
                      {% elsif product.description != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.description | strip_html | truncate: 100 }}</div>
                      {% endif %}
                    {% endif %}
                    {% if block.settings.show_play_btn %}<a href="{{ product.url }}" class="ai-cassette-play-link-{{ ai_gen_id }}">{{ block.settings.play_btn_text }}</a>{% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>

        {%- comment -%} ── وضع السلايدر التلقائي ── {%- endcomment -%}
        {% elsif display_mode == 'slider' %}
          <div class="ai-cassette-slider-outer-{{ ai_gen_id }}" id="cs-outer-{{ ai_gen_id }}">
            <div class="ai-cassette-slider-track-{{ ai_gen_id }}" id="cs-track-{{ ai_gen_id }}">
              {% for product in products limit: tapes_count %}
                {%- assign r = forloop.index -%}
                <article class="ai-cassette-card-{{ ai_gen_id }}">
                  {% if block.settings.show_trending_badge %}
                    <div class="ai-cassette-trending-badge-{{ ai_gen_id }}">{{ block.settings.badge_prefix }}{{ r }}</div>
                  {% endif %}
                  <div class="ai-cassette-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="ai-cassette-image-{{ ai_gen_id }}" loading="lazy" width="600" height="400">
                    {% else %}
                      <div class="ai-cassette-placeholder-{{ ai_gen_id }}">
                        <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" width="70%" style="opacity:.25"><rect x="4" y="4" width="112" height="72" rx="6" stroke="{{ block.settings.accent_color }}" stroke-width="4" fill="none"/><circle cx="38" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="82" cy="42" r="14" stroke="{{ block.settings.accent_color }}" stroke-width="3" fill="none"/><circle cx="38" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><circle cx="82" cy="42" r="5" fill="{{ block.settings.accent_color }}" fill-opacity=".4"/><path d="M52 42 Q60 36 68 42" stroke="{{ block.settings.accent_color }}" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-cassette-content-{{ ai_gen_id }}">
                    {% if block.settings.show_rank %}<div class="ai-cassette-rank-{{ ai_gen_id }}">{{ block.settings.rank_prefix }}{{ r }}</div>{% endif %}
                    <h3 class="ai-cassette-tape-title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                    {% if block.settings.show_artist %}
                      {% if product.metafields.custom.artist != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.metafields.custom.artist }}</div>
                      {% elsif product.description != blank %}
                        <div class="ai-cassette-artist-{{ ai_gen_id }}">{{ product.description | strip_html | truncate: 100 }}</div>
                      {% endif %}
                    {% endif %}
                    {% if block.settings.show_play_btn %}<a href="{{ product.url }}" class="ai-cassette-play-link-{{ ai_gen_id }}">{{ block.settings.play_btn_text }}</a>{% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
          {% if block.settings.show_dots %}
            <div class="ai-cassette-dots-{{ ai_gen_id }}" id="cs-dots-{{ ai_gen_id }}">
              {% for product in products limit: tapes_count %}
                <button class="ai-cassette-dot-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="شريط {{ forloop.index }}"></button>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}

        {% if block.settings.show_view_all %}
          <div class="ai-cassette-view-all-{{ ai_gen_id }}">
            <a href="/collections/all" class="ai-cassette-view-all-link-{{ ai_gen_id }}">
              {{ block.settings.view_all_text }}
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 15L12 10L7 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
              </svg>
            </a>
          </div>
        {% endif %}

      {% else %}
        <div class="ai-cassette-empty-{{ ai_gen_id }}">لا توجد كاسيتات في هذه المجموعة حالياً</div>
      {% endif %}

    {% else %}
      <div class="ai-cassette-empty-{{ ai_gen_id }}">الرجاء اختيار مجموعة لعرض الكاسيتات الرائجة</div>
    {% endif %}

  </div>
</cassette-section-{{ ai_gen_id }}>

<script>
(function() {
  var GEN = '{{ ai_gen_id }}';
  var MODE  = '{{ display_mode }}';
  var AUTO  = {{ block.settings.auto_scroll }};
  var SPEED = {{ block.settings.scroll_speed }};

  if (MODE !== 'slider') return;

  function initSlider() {
    var outer  = document.getElementById('cs-outer-' + GEN);
    var track  = document.getElementById('cs-track-' + GEN);
    var dotsEl = document.getElementById('cs-dots-' + GEN);
    if (!outer || !track) return;

    var cards  = track.querySelectorAll('.ai-cassette-card-' + GEN);
    var total  = cards.length;
    if (total < 2) return;

    var current = 0;
    var timer   = null;
    var paused  = false;

    function gap() {
      return parseInt(getComputedStyle(track).gap) || 0;
    }

    function cardW() {
      return cards[0] ? cards[0].offsetWidth + gap() : 0;
    }

    function goTo(idx) {
      current = ((idx % total) + total) % total;
      track.style.transform = 'translateX(-' + (current * cardW()) + 'px)';
      if (dotsEl) {
        dotsEl.querySelectorAll('.ai-cassette-dot-' + GEN).forEach(function(d, i) {
          d.classList.toggle('active', i === current);
        });
      }
    }

    function next() { if (!paused) goTo(current + 1); }

    function startAuto() { if (AUTO) timer = setInterval(next, SPEED); }
    function stopAuto()  { clearInterval(timer); }

    outer.addEventListener('mouseenter', function() { paused = true; });
    outer.addEventListener('mouseleave', function() { paused = false; });

    if (dotsEl) {
      dotsEl.querySelectorAll('.ai-cassette-dot-' + GEN).forEach(function(dot) {
        dot.addEventListener('click', function() {
          stopAuto();
          goTo(parseInt(dot.dataset.index));
          startAuto();
        });
      });
    }

    var startX = 0;
    outer.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
    outer.addEventListener('touchend', function(e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) { stopAuto(); goTo(diff > 0 ? current + 1 : current - 1); startAuto(); }
    }, { passive: true });

    goTo(0);
    startAuto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlider);
  } else {
    initSlider();
  }
})();
</script>

