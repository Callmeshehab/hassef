{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-retro-tv-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-retro-tv-wrapper-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.frame_color }};
    padding-top: {{ block.settings.frame_top }}px;
    padding-right: {{ block.settings.frame_right }}px;
    padding-bottom: {{ block.settings.frame_bottom }}px;
    padding-left: {{ block.settings.frame_left }}px;
    border-radius: {{ block.settings.frame_border_radius }}px;
    overflow: visible;
  }

  .ai-retro-tv-screen-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.screen_border_radius }}px;
    overflow: hidden;
  }

  .ai-retro-tv-screen-wrapper-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: {{ block.settings.inner_border_width }}px solid {{ block.settings.inner_border_color }};
    border-radius: {{ block.settings.screen_border_radius }}px;
    pointer-events: none;
    z-index: 3;
  }

  .ai-retro-tv-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-retro-tv-video-{{ ai_gen_id }}:fullscreen,
  .ai-retro-tv-video-{{ ai_gen_id }}:-webkit-full-screen {
    object-fit: contain;
  }

  .ai-retro-tv-static-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .ai-retro-tv-static-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-retro-tv-static-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-retro-tv-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    background-color: {{ block.settings.nav_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: background-color 0.3s ease;
    {% unless block.settings.show_nav_buttons %}
      display: none;
    {% endunless %}
  }

  .ai-retro-tv-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-retro-tv-nav-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_icon_size }}px;
    height: {{ block.settings.nav_icon_size }}px;
    fill: {{ block.settings.nav_icon_color }};
  }

  .ai-retro-tv-nav-prev-{{ ai_gen_id }} {
    left: {{ block.settings.nav_horizontal_position }}px;
  }

  .ai-retro-tv-nav-next-{{ ai_gen_id }} {
    right: {{ block.settings.nav_horizontal_position }}px;
  }

  .ai-retro-tv-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.controls_gap }}px;
    margin-top: {{ block.settings.controls_margin_top }}px;
    padding: {{ block.settings.controls_padding }}px;
    background-color: {{ block.settings.controls_bg_color }};
    border-radius: {{ block.settings.controls_border_radius }}px;
  }

  .ai-retro-tv-control-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-retro-tv-control-button-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-retro-tv-control-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.control_icon_size }}px;
    height: {{ block.settings.control_icon_size }}px;
    fill: {{ block.settings.control_icon_color }};
  }

  .ai-retro-tv-play-button-{{ ai_gen_id }} {
    order: {{ block.settings.play_button_order }};
  }

  .ai-retro-tv-fullscreen-button-{{ ai_gen_id }} {
    order: {{ block.settings.fullscreen_button_order }};
  }

  .ai-retro-tv-mute-button-{{ ai_gen_id }} {
    order: {{ block.settings.mute_button_order }};
  }

  .ai-retro-tv-volume-slider-{{ ai_gen_id }} {
    order: {{ block.settings.volume_order }};
    width: {{ block.settings.volume_slider_width }}px;
    height: {{ block.settings.volume_slider_height }}px;
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(to right, {{ block.settings.volume_slider_fill }} 0%, {{ block.settings.volume_slider_fill }} var(--volume-percent), {{ block.settings.volume_slider_bg }} var(--volume-percent), {{ block.settings.volume_slider_bg }} 100%);
    border-radius: {{ block.settings.volume_slider_radius }}px;
    outline: none;
    cursor: pointer;
  }

  .ai-retro-tv-volume-slider-{{ ai_gen_id }}::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: {{ block.settings.volume_thumb_size }}px;
    height: {{ block.settings.volume_thumb_size }}px;
    background: {{ block.settings.volume_thumb_color }};
    border-radius: 50%;
    cursor: pointer;
  }

  .ai-retro-tv-volume-slider-{{ ai_gen_id }}::-moz-range-thumb {
    width: {{ block.settings.volume_thumb_size }}px;
    height: {{ block.settings.volume_thumb_size }}px;
    background: {{ block.settings.volume_thumb_color }};
    border-radius: 50%;
    cursor: pointer;
    border: none;
  }

  .ai-retro-tv-thumbnails-section-{{ ai_gen_id }} {
    margin-top: {{ block.settings.thumbnails_distance }}px;
    {% unless block.settings.show_thumbnails %}
      display: none;
    {% endunless %}
  }

  .ai-retro-tv-thumbnails-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.thumbnails_section_width }}%;
    margin: 0 auto;
  }

  .ai-retro-tv-thumbnails-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.thumbnails_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .ai-retro-tv-thumbnails-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-retro-tv-thumbnail-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.thumbnail_width }}px;
    height: {{ block.settings.thumbnail_height }}px;
    border: {{ block.settings.thumbnail_border_width }}px solid {{ block.settings.thumbnail_border_color }};
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .ai-retro-tv-thumbnail-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.thumbnail_hover_border }};
  }

  .ai-retro-tv-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.thumbnail_active_border }};
    border-width: {{ block.settings.thumbnail_active_border_width }}px;
  }

  .ai-retro-tv-thumbnail-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .ai-retro-tv-thumb-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.thumb_nav_size }}px;
    height: {{ block.settings.thumb_nav_size }}px;
    background-color: {{ block.settings.thumb_nav_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-retro-tv-thumb-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.thumb_nav_hover_bg }};
  }

  .ai-retro-tv-thumb-nav-{{ ai_gen_id }} svg {
    width: {{ block.settings.thumb_nav_icon_size }}px;
    height: {{ block.settings.thumb_nav_icon_size }}px;
    fill: {{ block.settings.thumb_nav_icon_color }};
  }

  .ai-retro-tv-thumb-prev-{{ ai_gen_id }} {
    left: -{{ block.settings.thumb_nav_gap }}px;
  }

  .ai-retro-tv-thumb-next-{{ ai_gen_id }} {
    right: -{{ block.settings.thumb_nav_gap }}px;
  }
{% endstyle %}

<retro-tv-player-{{ ai_gen_id }}
  class="ai-retro-tv-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-autoplay="{{ block.settings.autoplay }}"
  data-muted="{{ block.settings.muted }}"
  data-loop="{{ block.settings.loop }}"
  data-auto-play-next="{{ block.settings.auto_play_next }}"
  data-static-enabled="{{ block.settings.enable_static }}"
  data-static-duration="{{ block.settings.static_duration }}"
>
  <div class="ai-retro-tv-wrapper-{{ ai_gen_id }}">
    <button class="ai-retro-tv-nav-button-{{ ai_gen_id }} ai-retro-tv-nav-prev-{{ ai_gen_id }}" aria-label="Previous video">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>

    <div class="ai-retro-tv-screen-wrapper-{{ ai_gen_id }}">
      {% liquid
        assign videos = ''
        for i in (1..15)
          assign video_key = 'video_' | append: i
          assign url_key = 'video_url_' | append: i
          assign video = block.settings[video_key]
          assign url = block.settings[url_key]
          
          if video != blank or url != blank
            if videos != ''
              assign videos = videos | append: ','
            endif
            if url != blank
              assign videos = videos | append: url
            else
              assign videos = videos | append: video
            endif
          endif
        endfor
      %}

      {% assign video_array = videos | split: ',' %}
      {% for video_src in video_array %}
        <video
          class="ai-retro-tv-video-{{ ai_gen_id }}"
          {% if forloop.first %}style="display: block;"{% else %}style="display: none;"{% endif %}
          playsinline
          webkit-playsinline
          {% if block.settings.show_native_controls %}controls{% endif %}
          {% if block.settings.autoplay and forloop.first %}autoplay{% endif %}
          {% if block.settings.muted %}muted{% endif %}
          {% if block.settings.loop and video_array.size == 1 %}loop{% endif %}
          preload="metadata"
        >
          <source src="{{ video_src }}" type="video/mp4">
        </video>
      {% endfor %}

      <div class="ai-retro-tv-static-{{ ai_gen_id }}">
        {% if block.settings.custom_static_video != blank or block.settings.custom_static_url != blank %}
          <video class="ai-retro-tv-static-video-{{ ai_gen_id }}" autoplay loop muted playsinline>
            <source src="{% if block.settings.custom_static_url != blank %}{{ block.settings.custom_static_url }}{% else %}{{ block.settings.custom_static_video }}{% endif %}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    </div>

    <button class="ai-retro-tv-nav-button-{{ ai_gen_id }} ai-retro-tv-nav-next-{{ ai_gen_id }}" aria-label="Next video">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
    </button>

    <div class="ai-retro-tv-controls-{{ ai_gen_id }}">
      <button class="ai-retro-tv-control-button-{{ ai_gen_id }} ai-retro-tv-play-button-{{ ai_gen_id }}" aria-label="Play/Pause">
        <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg class="pause-icon" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <button class="ai-retro-tv-control-button-{{ ai_gen_id }} ai-retro-tv-fullscreen-button-{{ ai_gen_id }}" aria-label="Fullscreen">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      </button>

      <button class="ai-retro-tv-control-button-{{ ai_gen_id }} ai-retro-tv-mute-button-{{ ai_gen_id }}" aria-label="Mute/Unmute">
        <svg class="volume-on" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        <svg class="volume-off" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
      </button>

      <input
        type="range"
        class="ai-retro-tv-volume-slider-{{ ai_gen_id }}"
        min="0"
        max="100"
        value="{% if block.settings.muted %}0{% else %}70{% endif %}"
        style="--volume-percent: {% if block.settings.muted %}0%{% else %}70%{% endif %};"
        aria-label="Volume"
      >
    </div>
  </div>

  {% if block.settings.show_thumbnails %}
    <div class="ai-retro-tv-thumbnails-section-{{ ai_gen_id }}">
      <div class="ai-retro-tv-thumbnails-wrapper-{{ ai_gen_id }}">
        <button class="ai-retro-tv-thumb-nav-{{ ai_gen_id }} ai-retro-tv-thumb-prev-{{ ai_gen_id }}" aria-label="Scroll left">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>

        <div class="ai-retro-tv-thumbnails-container-{{ ai_gen_id }}">
          {% for video_src in video_array %}
            <div class="ai-retro-tv-thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
              <video class="ai-retro-tv-thumbnail-video-{{ ai_gen_id }}" src="{{ video_src }}#t=0.5" preload="metadata" muted playsinline></video>
            </div>
          {% endfor %}
        </div>

        <button class="ai-retro-tv-thumb-nav-{{ ai_gen_id }} ai-retro-tv-thumb-next-{{ ai_gen_id }}" aria-label="Scroll right">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>
    </div>
  {% endif %}
</retro-tv-player-{{ ai_gen_id }}>

<script>
  (function() {
    class RetroTVPlayer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videos = [];
        this.thumbnails = [];
        this.currentVideo = null;
        this.settings = {
          autoplay: this.dataset.autoplay === 'true',
          muted: this.dataset.muted === 'true',
          loop: this.dataset.loop === 'true',
          autoPlayNext: this.dataset.autoPlayNext === 'true',
          staticEnabled: this.dataset.staticEnabled === 'true',
          staticDuration: parseFloat(this.dataset.staticDuration) * 1000
        };
      }

      connectedCallback() {
        this.videos = Array.from(this.querySelectorAll('.ai-retro-tv-video-{{ ai_gen_id }}'));
        this.thumbnails = Array.from(this.querySelectorAll('.ai-retro-tv-thumbnail-{{ ai_gen_id }}'));
        this.currentVideo = this.videos[0];
        
        this.playButton = this.querySelector('.ai-retro-tv-play-button-{{ ai_gen_id }}');
        this.fullscreenButton = this.querySelector('.ai-retro-tv-fullscreen-button-{{ ai_gen_id }}');
        this.muteButton = this.querySelector('.ai-retro-tv-mute-button-{{ ai_gen_id }}');
        this.volumeSlider = this.querySelector('.ai-retro-tv-volume-slider-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-retro-tv-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-retro-tv-nav-next-{{ ai_gen_id }}');
        this.thumbPrevButton = this.querySelector('.ai-retro-tv-thumb-prev-{{ ai_gen_id }}');
        this.thumbNextButton = this.querySelector('.ai-retro-tv-thumb-next-{{ ai_gen_id }}');
        this.staticOverlay = this.querySelector('.ai-retro-tv-static-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.initializePlayer();
      }

      setupEventListeners() {
        if (this.playButton) {
          this.playButton.addEventListener('click', () => this.togglePlay());
        }

        if (this.fullscreenButton) {
          this.fullscreenButton.addEventListener('click', () => this.toggleFullscreen());
        }

        if (this.muteButton) {
          this.muteButton.addEventListener('click', () => this.toggleMute());
        }

        if (this.volumeSlider) {
          this.volumeSlider.addEventListener('input', (e) => this.updateVolume(e.target.value));
        }

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousVideo());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextVideo());
        }

        if (this.thumbPrevButton) {
          this.thumbPrevButton.addEventListener('click', () => this.scrollThumbnails(-1));
        }

        if (this.thumbNextButton) {
          this.thumbNextButton.addEventListener('click', () => this.scrollThumbnails(1));
        }

        this.thumbnails.forEach((thumb, index) => {
          thumb.addEventListener('click', () => this.switchToVideo(index));
        });

        this.videos.forEach(video => {
          video.addEventListener('play', () => this.updatePlayButton(true));
          video.addEventListener('pause', () => this.updatePlayButton(false));
          video.addEventListener('ended', () => this.handleVideoEnded());
        });
      }

      initializePlayer() {
        if (this.currentVideo) {
          if (this.settings.muted) {
            this.currentVideo.muted = true;
            this.updateMuteButton(true);
          }
          
          if (this.settings.autoplay) {
            this.currentVideo.play().catch(e => console.log('Autoplay prevented:', e));
          }
        }
      }

      togglePlay() {
        if (!this.currentVideo) return;

        try {
          if (this.currentVideo.paused) {
            this.currentVideo.play().catch(e => console.log('Play error:', e));
          } else {
            this.currentVideo.pause();
          }
        } catch (e) {
          console.log('Toggle play error:', e);
        }
      }

      updatePlayButton(isPlaying) {
        const playIcon = this.playButton?.querySelector('.play-icon');
        const pauseIcon = this.playButton?.querySelector('.pause-icon');
        
        if (playIcon && pauseIcon) {
          playIcon.style.display = isPlaying ? 'none' : 'block';
          pauseIcon.style.display = isPlaying ? 'block' : 'none';
        }
      }

      toggleFullscreen() {
        if (!this.currentVideo) return;

        try {
          if (document.fullscreenElement || document.webkitFullscreenElement) {
            if (document.exitFullscreen) {
              document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
              document.webkitExitFullscreen();
            }
          } else {
            if (this.currentVideo.requestFullscreen) {
              this.currentVideo.requestFullscreen();
            } else if (this.currentVideo.webkitRequestFullscreen) {
              this.currentVideo.webkitRequestFullscreen();
            } else if (this.currentVideo.webkitEnterFullscreen) {
              this.currentVideo.webkitEnterFullscreen();
            }
          }
        } catch (e) {
          console.log('Fullscreen error:', e);
        }
      }

      toggleMute() {
        if (!this.currentVideo) return;

        this.currentVideo.muted = !this.currentVideo.muted;
        this.updateMuteButton(this.currentVideo.muted);
        
        if (this.volumeSlider) {
          this.volumeSlider.value = this.currentVideo.muted ? 0 : this.currentVideo.volume * 100;
          this.volumeSlider.style.setProperty('--volume-percent', this.volumeSlider.value + '%');
        }
      }

      updateMuteButton(isMuted) {
        const volumeOn = this.muteButton?.querySelector('.volume-on');
        const volumeOff = this.muteButton?.querySelector('.volume-off');
        
        if (volumeOn && volumeOff) {
          volumeOn.style.display = isMuted ? 'none' : 'block';
          volumeOff.style.display = isMuted ? 'block' : 'none';
        }
      }

      updateVolume(value) {
        if (!this.currentVideo) return;

        const volume = value / 100;
        this.currentVideo.volume = volume;
        this.currentVideo.muted = volume === 0;
        this.updateMuteButton(volume === 0);
        this.volumeSlider.style.setProperty('--volume-percent', value + '%');
      }

      handleVideoEnded() {
        if (this.settings.autoPlayNext && this.videos.length > 1) {
          this.nextVideo();
        }
      }

      previousVideo() {
        const newIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.videos.length - 1;
        this.switchToVideo(newIndex);
      }

      nextVideo() {
        const newIndex = this.currentIndex < this.videos.length - 1 ? this.currentIndex + 1 : 0;
        this.switchToVideo(newIndex);
      }

      switchToVideo(index) {
        if (index === this.currentIndex || !this.videos[index]) return;

        const wasPlaying = this.currentVideo && !this.currentVideo.paused;

        if (this.settings.staticEnabled) {
          this.showStatic();
          setTimeout(() => {
            this.performSwitch(index, wasPlaying);
            this.hideStatic();
          }, this.settings.staticDuration);
        } else {
          this.performSwitch(index, wasPlaying);
        }
      }

      performSwitch(index, wasPlaying) {
        if (this.currentVideo) {
          this.currentVideo.pause();
          this.currentVideo.style.display = 'none';
        }

        this.currentIndex = index;
        this.currentVideo = this.videos[index];
        this.currentVideo.style.display = 'block';

        this.thumbnails.forEach((thumb, i) => {
          thumb.classList.toggle('active', i === index);
        });

        this.scrollToActiveThumbnail();

        if (wasPlaying || this.settings.autoplay) {
          this.currentVideo.play().catch(e => console.log('Play error:', e));
        }
      }

      showStatic() {
        if (this.staticOverlay) {
          this.staticOverlay.classList.add('active');
        }
      }

      hideStatic() {
        if (this.staticOverlay) {
          this.staticOverlay.classList.remove('active');
        }
      }

      scrollThumbnails(direction) {
        const container = this.querySelector('.ai-retro-tv-thumbnails-container-{{ ai_gen_id }}');
        if (!container) return;

        const scrollAmount = 200;
        container.scrollBy({
          left: direction * scrollAmount,
          behavior: 'smooth'
        });
      }

      scrollToActiveThumbnail() {
        const container = this.querySelector('.ai-retro-tv-thumbnails-container-{{ ai_gen_id }}');
        const activeThumbnail = this.thumbnails[this.currentIndex];
        
        if (container && activeThumbnail) {
          const containerRect = container.getBoundingClientRect();
          const thumbRect = activeThumbnail.getBoundingClientRect();
          const scrollLeft = thumbRect.left - containerRect.left + container.scrollLeft - (containerRect.width / 2) + (thumbRect.width / 2);
          
          container.scrollTo({
            left: scrollLeft,
            behavior: 'smooth'
          });
        }
      }
    }

    customElements.define('retro-tv-player-{{ ai_gen_id }}', RetroTVPlayer{{ ai_gen_id }});
  })();
</script>

