{% doc %}
  @prompt
    بار متحرك يأخذ طابع الريترو لتصفح أقسام الكاسيت المختلفه , حلو بس بدي كل بار متحرك اقدر اعدل النص واربط فيه القسم المراد وإمكانيه تغيير الصوره المصغره بجانب النص , بدي تضيف قسم آخر وكمان امكانيه التحكم في سرعتهن , بدي خيارات اكثر للتحكم في النصوص
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-retro-cassette-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(135deg, {{ block.settings.background_color_1 }} 0%, {{ block.settings.background_color_2 }} 100%);
    padding: {{ block.settings.bar_padding }}px 0;
    position: relative;
    border-top: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-retro-cassette-bar__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    animation: ai-retro-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-retro-cassette-bar-{{ ai_gen_id }}:hover .ai-retro-cassette-bar__track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  @keyframes ai-retro-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-retro-cassette-bar__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.text_image_gap }}px;
    padding: {{ block.settings.item_padding }}px {{ block.settings.item_padding | times: 1.5 }}px;
    background-color: {{ block.settings.item_background }};
    border: {{ block.settings.item_border_thickness }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ai-retro-cassette-bar__item-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
    box-shadow: {{ block.settings.shadow_x | times: 1.5 }}px {{ block.settings.shadow_y | times: 1.5 }}px {{ block.settings.shadow_blur | times: 1.5 }}px {{ block.settings.shadow_color }};
  }

  .ai-retro-cassette-bar__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
    flex-shrink: 0;
  }

  .ai-retro-cassette-bar__image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    background-color: {{ block.settings.placeholder_bg }};
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-retro-cassette-bar__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-retro-cassette-bar__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    font-style: {{ block.settings.text_style }};
  }

  @media screen and (max-width: 749px) {
    .ai-retro-cassette-bar__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }

    .ai-retro-cassette-bar__image-{{ ai_gen_id }},
    .ai-retro-cassette-bar__image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<retro-cassette-bar-{{ ai_gen_id }} class="ai-retro-cassette-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-retro-cassette-bar__track-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% for j in (1..6) %}
        {% liquid
          assign item_enabled_key = 'item_' | append: j | append: '_enabled'
          assign item_text_key = 'item_' | append: j | append: '_text'
          assign item_link_key = 'item_' | append: j | append: '_link'
          assign item_image_key = 'item_' | append: j | append: '_image'

          assign item_enabled = block.settings[item_enabled_key]
          assign item_text = block.settings[item_text_key]
          assign item_link = block.settings[item_link_key]
          assign item_image = block.settings[item_image_key]
        %}

        {% if item_enabled %}
          <a
            href="{{ item_link }}"
            class="ai-retro-cassette-bar__item-{{ ai_gen_id }}"
          >
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 200 }}"
                alt="{{ item_text | escape }}"
                class="ai-retro-cassette-bar__image-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-retro-cassette-bar__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <span class="ai-retro-cassette-bar__text-{{ ai_gen_id }}">{{ item_text }}</span>
          </a>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</retro-cassette-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class RetroCassetteBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-retro-cassette-bar__track-{{ ai_gen_id }}');
        this.setupAnimation();
      }

      setupAnimation() {
        if (!this.track) return;

        const items = this.track.querySelectorAll('.ai-retro-cassette-bar__item-{{ ai_gen_id }}');
        if (items.length === 0) return;

        this.track.addEventListener('mouseenter', () => {
          this.track.style.animationPlayState = 'paused';
        });

        this.track.addEventListener('mouseleave', () => {
          this.track.style.animationPlayState = 'running';
        });
      }
    }

    customElements.define('retro-cassette-bar-{{ ai_gen_id }}', RetroCassetteBar{{ ai_gen_id }});
  })();
</script>

