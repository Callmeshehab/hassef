    },
    {
      "type": "checkbox",
      "id": "hide_progress_bar",
      "label": "إخفاء شريط التقدم",
      "default": false
    },
    {
      "type": "range",
      "id": "progress_bar_vertical_position",
      "label": "الموضع العمودي",
      "min": -20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "progress_bar_width",
      "label": "طول شريط التقدم",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "progress_bar_height",
      "label": "ارتفاع شريط التقدم",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "progress_handle_size",
      "label": "حجم زر السحب",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "progress_bar_color",
      "label": "لون شريط التقدم",
      "default": "#ff8c42"
    },
    {
      "type": "header",
      "content": "وحدة التحكم"
    },
    {
      "type": "checkbox",
