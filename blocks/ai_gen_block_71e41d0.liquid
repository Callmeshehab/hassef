      "label": "سمك الإطار السفلي",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "frame_left_thickness",
      "label": "سمك الإطار الأيسر",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
