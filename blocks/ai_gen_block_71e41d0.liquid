      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "tv_width_mobile",
      "label": "عرض التلفاز على الموبايل",
      "min": 80,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 95
    },
    {
      "type": "header",
      "content": "إطار التلفاز"
