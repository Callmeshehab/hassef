{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-retro-tv-player-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-retro-tv-player__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-retro-tv-player__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
  }

  .ai-retro-tv-player__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-retro-tv-player__container-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.player_width }}px;
    height: {{ block.settings.player_height }}px;
    margin: 0 auto;
    max-width: 100%;
  }

  .ai-retro-tv-player__tv-frame-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale({{ block.settings.tv_scale }});
    width: {{ block.settings.tv_width }}px;
    height: {{ block.settings.tv_height }}px;
    pointer-events: none;
    z-index: 2;
  }

  .ai-retro-tv-player__tv-frame-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-retro-tv-player__video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.video_position_y }}%;
    left: {{ block.settings.video_position_x }}%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.video_width }}%;
    height: {{ block.settings.video_height }}%;
    border: {{ block.settings.frame_thickness }}px solid {{ block.settings.frame_color }};
    border-radius: {{ block.settings.frame_radius }}px;
    overflow: hidden;
    background: #000;
    z-index: 1;
  }

  .ai-retro-tv-player__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-retro-tv-player__static-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .ai-retro-tv-player__static-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-retro-tv-player__static-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-retro-tv-player__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.controls_position_y }}px;
    left: {{ block.settings.controls_position_x }}%;
    transform: translateX(-50%);
    display: flex;
    gap: {{ block.settings.controls_gap }}px;
    z-index: 4;
    {% if block.settings.show_controls %}
      opacity: 1;
      pointer-events: auto;
    {% else %}
      opacity: 0;
      pointer-events: none;
    {% endif %}
  }

  .ai-retro-tv-player__control-btn-{{ ai_gen_id }} {
    background: {{ block.settings.control_button_bg }};
    color: {{ block.settings.control_button_color }};
    border: none;
    width: {{ block.settings.control_button_size }}px;
    height: {{ block.settings.control_button_size }}px;
    border-radius: {{ block.settings.control_button_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s;
  }

  .ai-retro-tv-player__control-btn-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-retro-tv-player__control-btn-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    fill: currentColor;
  }

  .ai-retro-tv-player__thumbnails-{{ ai_gen_id }} {
    margin-top: 30px;
    padding: {{ block.settings.thumbnails_padding }}px;
    background: {{ block.settings.thumbnails_bg }};
    border: {{ block.settings.thumbnails_border_thickness }}px solid {{ block.settings.thumbnails_border_color }};
    border-radius: {{ block.settings.thumbnails_radius }}px;
  }

  .ai-retro-tv-player__thumbnails-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-retro-tv-player__thumbnails-track-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    transition: transform 0.3s ease;
  }

  .ai-retro-tv-player__thumbnail-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.3s;
    background: #000;
  }

  .ai-retro-tv-player__thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.frame_color }};
  }

  .ai-retro-tv-player__thumbnail-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.frame_color }};
    opacity: 0.8;
  }

  .ai-retro-tv-player__thumbnail-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .ai-retro-tv-player__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 15px;
  }

  .ai-retro-tv-player__nav-btn-{{ ai_gen_id }} {
    background: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: {{ block.settings.nav_button_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s;
  }

  .ai-retro-tv-player__nav-btn-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-retro-tv-player__nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-retro-tv-player__nav-btn-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .ai-retro-tv-player__container-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .ai-retro-tv-player__thumbnail-{{ ai_gen_id }} {
      width: 80px;
      height: 80px;
    }
  }
{% endstyle %}

<retro-tv-player-{{ ai_gen_id }} class="ai-retro-tv-player-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.description != blank %}
    <div class="ai-retro-tv-player__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-retro-tv-player__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-retro-tv-player__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-retro-tv-player__container-{{ ai_gen_id }}">
    {% if block.settings.tv_frame_image %}
      <div class="ai-retro-tv-player__tv-frame-{{ ai_gen_id }}">
        <img src="{{ block.settings.tv_frame_image | image_url: width: 1000 }}" alt="TV Frame">
      </div>
    {% endif %}

    <div class="ai-retro-tv-player__video-wrapper-{{ ai_gen_id }}">
      <video
        class="ai-retro-tv-player__video-{{ ai_gen_id }}"
        playsinline
        controls
        data-main-video
      ></video>

      <div class="ai-retro-tv-player__static-{{ ai_gen_id }}" data-static-overlay>
        {% if block.settings.use_custom_static and block.settings.static_video != blank %}
          <video class="ai-retro-tv-player__static-video-{{ ai_gen_id }}" autoplay loop muted playsinline data-static-video>
            <source src="{{ block.settings.static_video.sources[0].url }}" type="{{ block.settings.static_video.sources[0].mime_type }}">
          </video>
        {% else %}
          <canvas class="ai-retro-tv-player__static-video-{{ ai_gen_id }}" data-static-canvas></canvas>
        {% endif %}
      </div>

      {% if block.settings.show_controls %}
        <div class="ai-retro-tv-player__controls-{{ ai_gen_id }}">
          <button class="ai-retro-tv-player__control-btn-{{ ai_gen_id }}" data-play-pause aria-label="تشغيل/إيقاف">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" data-play-icon>
              <path d="M8 5v14l11-7z"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" data-pause-icon style="display: none;">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
          </button>
          <button class="ai-retro-tv-player__control-btn-{{ ai_gen_id }}" data-fullscreen aria-label="ملء الشاشة">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-retro-tv-player__thumbnails-{{ ai_gen_id }}">
    <div class="ai-retro-tv-player__thumbnails-wrapper-{{ ai_gen_id }}">
      <div class="ai-retro-tv-player__thumbnails-track-{{ ai_gen_id }}" data-thumbnails-track>
        {% for i in (1..10) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign video_file = block.settings[video_key] %}
          {% if video_file != blank %}
            <div 
              class="ai-retro-tv-player__thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" 
              data-video-index="{{ forloop.index0 }}"
              data-video-url="{{ video_file.sources[0].url }}"
            >
              <video muted playsinline loop>
                <source src="{{ video_file.sources[0].url }}" type="{{ video_file.sources[0].mime_type }}">
              </video>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-retro-tv-player__nav-{{ ai_gen_id }}">
      <button class="ai-retro-tv-player__nav-btn-{{ ai_gen_id }}" data-nav-prev aria-label="السابق">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>
      <button class="ai-retro-tv-player__nav-btn-{{ ai_gen_id }}" data-nav-next aria-label="التالي">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  </div>
</retro-tv-player-{{ ai_gen_id }}>

<script>
(function() {
  class RetroTvPlayer{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.videos = [];
      this.isTransitioning = false;
    }

    connectedCallback() {
      this.mainVideo = this.querySelector('[data-main-video]');
      this.staticOverlay = this.querySelector('[data-static-overlay]');
      this.staticCanvas = this.querySelector('[data-static-canvas]');
      this.playPauseBtn = this.querySelector('[data-play-pause]');
      this.playIcon = this.querySelector('[data-play-icon]');
      this.pauseIcon = this.querySelector('[data-pause-icon]');
      this.fullscreenBtn = this.querySelector('[data-fullscreen]');
      this.thumbnails = this.querySelectorAll('.ai-retro-tv-player__thumbnail-{{ ai_gen_id }}');
      this.thumbnailsTrack = this.querySelector('[data-thumbnails-track]');
      this.navPrev = this.querySelector('[data-nav-prev]');
      this.navNext = this.querySelector('[data-nav-next]');

      this.collectVideos();
      this.setupEventListeners();
      this.initStaticEffect();
      
      if (this.videos.length > 0) {
        this.loadVideo(0, false);
      }
      
      this.updateNavButtons();
    }

    collectVideos() {
      this.thumbnails.forEach((thumb) => {
        const videoUrl = thumb.getAttribute('data-video-url');
        if (videoUrl) {
          this.videos.push(videoUrl);
          const thumbVideo = thumb.querySelector('video');
          if (thumbVideo) {
            thumbVideo.currentTime = Math.random() * 2;
          }
        }
      });
    }

    setupEventListeners() {
      if (this.playPauseBtn) {
        this.playPauseBtn.addEventListener('click', () => this.togglePlayPause());
      }

      if (this.fullscreenBtn) {
        this.fullscreenBtn.addEventListener('click', () => this.toggleFullscreen());
      }

      this.thumbnails.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
          if (!this.isTransitioning) {
            this.loadVideo(index, true);
          }
        });
      });

      if (this.navPrev) {
        this.navPrev.addEventListener('click', () => this.navigate(-1));
      }

      if (this.navNext) {
        this.navNext.addEventListener('click', () => this.navigate(1));
      }

      let startX = 0;
      if (this.thumbnailsTrack) {
        this.thumbnailsTrack.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.thumbnailsTrack.addEventListener('touchend', (e) => {
          const endX = e.changedTouches[0].clientX;
          const diff = startX - endX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.navigate(1);
            } else {
              this.navigate(-1);
            }
          }
        });
      }

      if (this.mainVideo) {
        this.mainVideo.addEventListener('play', () => {
          this.updatePlayPauseIcon(false);
        });

        this.mainVideo.addEventListener('pause', () => {
          this.updatePlayPauseIcon(true);
        });
      }
    }

    updatePlayPauseIcon(showPlay) {
      if (this.playIcon && this.pauseIcon) {
        if (showPlay) {
          this.playIcon.style.display = 'block';
          this.pauseIcon.style.display = 'none';
        } else {
          this.playIcon.style.display = 'none';
          this.pauseIcon.style.display = 'block';
        }
      }
    }

    initStaticEffect() {
      if (!this.staticCanvas) return;

      const ctx = this.staticCanvas.getContext('2d');
      const width = this.staticCanvas.width = 320;
      const height = this.staticCanvas.height = 240;

      const drawStatic = () => {
        const imageData = ctx.createImageData(width, height);
        for (let i = 0; i < imageData.data.length; i += 4) {
          const color = Math.random() * 255;
          imageData.data[i] = color;
          imageData.data[i + 1] = color;
          imageData.data[i + 2] = color;
          imageData.data[i + 3] = 255;
        }
        ctx.putImageData(imageData, 0, 0);
      };

      this.staticInterval = setInterval(drawStatic, 50);
    }

    async loadVideo(index, showStatic) {
      if (index < 0 || index >= this.videos.length || this.isTransitioning) return;

      this.isTransitioning = true;
      this.currentIndex = index;

      this.thumbnails.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });

      if (showStatic) {
        this.showStatic();
        await new Promise(resolve => setTimeout(resolve, {{ block.settings.static_duration }} * 1000));
        this.hideStatic();
      }

      this.mainVideo.src = this.videos[index];
      this.mainVideo.load();

      this.mainVideo.onloadeddata = () => {
        {% if block.settings.autoplay %}
          this.mainVideo.play().catch(err => {
            console.log('تعذر التشغيل التلقائي');
          });
        {% endif %}
        this.isTransitioning = false;
      };

      this.updateNavButtons();
    }

    showStatic() {
      if (this.staticOverlay) {
        this.staticOverlay.classList.add('active');
      }
    }

    hideStatic() {
      if (this.staticOverlay) {
        this.staticOverlay.classList.remove('active');
      }
    }

    togglePlayPause() {
      if (this.mainVideo.paused) {
        this.mainVideo.play();
      } else {
        this.mainVideo.pause();
      }
    }

    toggleFullscreen() {
      if (!document.fullscreenElement) {
        this.mainVideo.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    }

    navigate(direction) {
      const newIndex = this.currentIndex + direction;
      if (newIndex >= 0 && newIndex < this.videos.length) {
        this.loadVideo(newIndex, true);
      }
    }

    updateNavButtons() {
      if (this.navPrev) {
        this.navPrev.disabled = this.currentIndex === 0;
      }
      if (this.navNext) {
        this.navNext.disabled = this.currentIndex === this.videos.length - 1;
      }
    }

    disconnectedCallback() {
      if (this.staticInterval) {
        clearInterval(this.staticInterval);
      }
    }
  }

  customElements.define('retro-tv-player-{{ ai_gen_id }}', RetroTvPlayer{{ ai_gen_id }});
})();
</script>

