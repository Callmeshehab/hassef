{% doc %}
  @prompt
    قسم تصفح الكاسيتات حسب المطرب — model-viewer 3D حقيقي مع هوية التطريز الفلسطيني
    يدعم ملفات GLB مع تحكم كامل بالدوران والأبعاد والنصوص الجانبية
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- comment -%}
╔══════════════════════════════════════════════════════════════════╗
║  تعليمات الإضافة                                                ║
║  ─────────────────────────────────────────────────────────────  ║
║  1. ارفع ملفات .glb عبر:                                        ║
║     Shopify Admin → Content → Files → Upload files              ║
║     ثم انسخ الرابط المباشر للملف                               ║
║                                                                  ║
║  2. في إعدادات كل فنان، الصق رابط .glb في حقل "رابط ملف GLB"  ║
║                                                                  ║
║  3. مكتبة model-viewer تُحمَّل تلقائياً من CDN                  ║
║     لا حاجة لتثبيت أي شيء                                      ║
╚══════════════════════════════════════════════════════════════════╝
{%- endcomment -%}

{%- comment -%} model-viewer script — يُحمَّل مرة واحدة فقط {%- endcomment -%}
<script>
  if (!customElements.get('model-viewer')) {
    var s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js';
    document.head.appendChild(s);
  }
</script>

{% style %}

/* ══════════════════════════════════════
   SECTION
══════════════════════════════════════ */
.ai-ar-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  min-height: {{ block.settings.section_min_h }}px;
  padding: {{ block.settings.pad_top }}px {{ block.settings.pad_h }}px {{ block.settings.pad_bottom }}px;
  background: {{ block.settings.bg_color }};
  position: relative;
  overflow: hidden;
}

/* شريط التطريز أعلى وأسفل */
.ai-ar-{{ ai_gen_id }}::before,
.ai-ar-{{ ai_gen_id }}::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: {{ block.settings.pattern_h }}px;
  background: repeating-linear-gradient(
    90deg,
    {{ block.settings.p1 }} 0px, {{ block.settings.p1 }} {{ block.settings.p_stripe }}px,
    {{ block.settings.p2 }} {{ block.settings.p_stripe }}px, {{ block.settings.p2 }} {{ block.settings.p_stripe | times: 2 }}px,
    {{ block.settings.p3 }} {{ block.settings.p_stripe | times: 2 }}px, {{ block.settings.p3 }} {{ block.settings.p_stripe | times: 3 }}px
  );
  z-index: 10;
  pointer-events: none;
}
.ai-ar-{{ ai_gen_id }}::before { top: 0; }
.ai-ar-{{ ai_gen_id }}::after  { bottom: 0; }

/* ambient glow */
.ai-ar-glow-{{ ai_gen_id }} {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 55% 45% at 50% 50%, {{ block.settings.accent }}1a 0%, transparent 70%),
    radial-gradient(ellipse 28% 35% at 15% 85%, {{ block.settings.p1 }}0f 0%, transparent 60%),
    radial-gradient(ellipse 28% 35% at 85% 15%, {{ block.settings.p3 }}0f 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.ai-ar-container-{{ ai_gen_id }} {
  max-width: {{ block.settings.container_w }}px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* ══════════════════════════════════════
   HEADER
══════════════════════════════════════ */
.ai-ar-header-{{ ai_gen_id }} {
  text-align: center;
  margin-bottom: {{ block.settings.header_mb }}px;
}

.ai-ar-title-{{ ai_gen_id }} {
  font-size: {{ block.settings.title_size }}px;
  color: {{ block.settings.title_color }};
  font-weight: 700;
  margin: 0 0 10px;
  position: relative;
  display: inline-block;
}

.ai-ar-title-{{ ai_gen_id }}::before,
.ai-ar-title-{{ ai_gen_id }}::after {
  content: '';
  position: absolute;
  top: 50%;
  width: {{ block.settings.deco_w }}px;
  height: {{ block.settings.deco_h }}px;
  transform: translateY(-50%);
  background: repeating-linear-gradient(90deg, {{ block.settings.accent }} 0px, {{ block.settings.accent }} 8px, transparent 8px, transparent 12px);
}
.ai-ar-title-{{ ai_gen_id }}::before { right: calc(100% + {{ block.settings.deco_gap }}px); }
.ai-ar-title-{{ ai_gen_id }}::after  { left:  calc(100% + {{ block.settings.deco_gap }}px); }

.ai-ar-subtitle-{{ ai_gen_id }} {
  font-size: {{ block.settings.subtitle_size }}px;
  color: {{ block.settings.accent }};
  margin: 0;
}

/* ══════════════════════════════════════
   THREE-COLUMN STAGE
══════════════════════════════════════ */
.ai-ar-stage-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: {{ block.settings.side_w }}px 1fr {{ block.settings.side_w }}px;
  gap: {{ block.settings.stage_gap }}px;
  align-items: center;
  min-height: {{ block.settings.stage_h }}px;
}

/* ── عمود جانبي ── */
.ai-ar-side-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  height: 100%;
}

.ai-ar-side-line-{{ ai_gen_id }} {
  width: {{ block.settings.deco_h }}px;
  flex: 1;
  max-height: 100px;
  background: repeating-linear-gradient(
    180deg,
    {{ block.settings.accent }} 0px, {{ block.settings.accent }} 5px,
    transparent 5px, transparent 9px
  );
  opacity: 0.35;
}

.ai-ar-side-text-{{ ai_gen_id }} {
  writing-mode: vertical-rl;
  font-size: {{ block.settings.side_font }}px;
  font-weight: 800;
  letter-spacing: {{ block.settings.side_spacing }}px;
  color: {{ block.settings.title_color }};
  opacity: 0.3;
  text-transform: uppercase;
  transition: opacity 0.4s;
  white-space: nowrap;
}

.ai-ar-side-{{ ai_gen_id }}[data-side="right"] .ai-ar-side-text-{{ ai_gen_id }} {
  transform: rotate(180deg);
}

/* نصوص إضافية يمين ويسار */
.ai-ar-side-extra-{{ ai_gen_id }} {
  font-size: {{ block.settings.side_extra_font }}px;
  color: {{ block.settings.accent }};
  font-weight: 700;
  text-align: center;
  line-height: 1.5;
  opacity: 0.85;
  padding: 0 4px;
  writing-mode: vertical-rl;
}

.ai-ar-side-{{ ai_gen_id }}[data-side="right"] .ai-ar-side-extra-{{ ai_gen_id }} {
  transform: rotate(180deg);
}

/* ══════════════════════════════════════
   CENTER COLUMN
══════════════════════════════════════ */
.ai-ar-center-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

/* اسم الفنان */
.ai-ar-name-{{ ai_gen_id }} {
  font-size: {{ block.settings.name_size }}px;
  font-weight: 900;
  color: {{ block.settings.title_color }};
  letter-spacing: 2px;
  text-transform: uppercase;
  text-align: center;
  margin-bottom: {{ block.settings.name_mb }}px;
  min-height: 1.3em;
  transition: opacity 0.35s ease, transform 0.35s ease;
  position: relative;
}

.ai-ar-name-{{ ai_gen_id }}.is-switching {
  opacity: 0;
  transform: translateY(-8px);
}

.ai-ar-name-{{ ai_gen_id }}::after {
  content: '';
  display: block;
  width: 55%;
  margin: 8px auto 0;
  height: 2px;
  background: repeating-linear-gradient(90deg, {{ block.settings.accent }} 0px, {{ block.settings.accent }} 4px, transparent 4px, transparent 8px);
}

/* وصف الفنان */
.ai-ar-sub-{{ ai_gen_id }} {
  font-size: {{ block.settings.sub_size }}px;
  color: {{ block.settings.accent }};
  font-weight: 600;
  text-align: center;
  margin-bottom: {{ block.settings.sub_mb }}px;
  min-height: 1.2em;
  transition: opacity 0.35s ease;
}

.ai-ar-sub-{{ ai_gen_id }}.is-switching { opacity: 0; }

/* ══════════════════════════════════════
   MODEL VIEWER WRAPPER
══════════════════════════════════════ */
.ai-ar-model-wrap-{{ ai_gen_id }} {
  position: relative;
  width: {{ block.settings.model_w }}px;
  height: {{ block.settings.model_h }}px;
  {% unless block.settings.show_frame %}
  background: transparent;
  {% else %}
  background: {{ block.settings.card_bg }};
  border: {{ block.settings.frame_border_w }}px solid {{ block.settings.frame_border_color }};
  border-radius: {{ block.settings.frame_radius }}px;
  box-shadow: {{ block.settings.frame_shadow_x }}px {{ block.settings.frame_shadow_y }}px {{ block.settings.frame_shadow_blur }}px {{ block.settings.frame_shadow_color }};
  overflow: hidden;
  {% endunless %}
  transition: box-shadow 0.5s ease;
}

/* شريط التطريز أعلى الإطار */
{% if block.settings.show_frame %}
.ai-ar-model-wrap-{{ ai_gen_id }}::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: {{ block.settings.pattern_h }}px;
  background: repeating-linear-gradient(
    90deg,
    {{ block.settings.p1 }} 0px, {{ block.settings.p1 }} {{ block.settings.p_stripe }}px,
    {{ block.settings.p2 }} {{ block.settings.p_stripe }}px, {{ block.settings.p2 }} {{ block.settings.p_stripe | times: 2 }}px,
    {{ block.settings.p3 }} {{ block.settings.p_stripe | times: 2 }}px, {{ block.settings.p3 }} {{ block.settings.p_stripe | times: 3 }}px
  );
  z-index: 5;
  pointer-events: none;
}
{% endif %}

/* حلقة التوهج */
.ai-ar-ring-{{ ai_gen_id }} {
  position: absolute;
  bottom: {{ block.settings.ring_offset | times: -1 }}px;
  left: 50%;
  transform: translateX(-50%);
  width: {{ block.settings.model_w | times: 0.65 | round }}px;
  height: {{ block.settings.ring_h }}px;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, {{ block.settings.accent }}55 0%, transparent 70%);
  filter: blur({{ block.settings.ring_blur }}px);
  pointer-events: none;
  z-index: -1;
  animation: ai-ar-pulse-{{ ai_gen_id }} 3s ease-in-out infinite;
}

@keyframes ai-ar-pulse-{{ ai_gen_id }} {
  0%, 100% { opacity: 0.6; transform: translateX(-50%) scaleX(1); }
  50%       { opacity: 1;   transform: translateX(-50%) scaleX(1.15); }
}

/* model-viewer نفسه */
.ai-ar-viewer-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  --progress-bar-color: {{ block.settings.accent }};
  --progress-mask: transparent;
  background: transparent;
}

/* placeholder عند عدم وجود GLB */
.ai-ar-placeholder-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: {{ block.settings.placeholder_bg }};
  border-radius: inherit;
}

.ai-ar-placeholder-{{ ai_gen_id }} svg { opacity: 0.2; }

.ai-ar-placeholder-{{ ai_gen_id }} p {
  font-size: 12px;
  color: {{ block.settings.accent }};
  font-weight: 700;
  opacity: 0.5;
  margin: 0;
  text-align: center;
  padding: 0 16px;
  line-height: 1.5;
}

/* ══════════════════════════════════════
   NAV CONTROLS
══════════════════════════════════════ */
.ai-ar-nav-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  gap: {{ block.settings.nav_gap }}px;
  margin-top: {{ block.settings.nav_mt }}px;
}

.ai-ar-nav-btn-{{ ai_gen_id }} {
  width: {{ block.settings.nav_btn_w }}px;
  height: {{ block.settings.nav_btn_w }}px;
  border-radius: {{ block.settings.nav_btn_r }}px;
  background: {{ block.settings.card_bg }};
  border: {{ block.settings.frame_border_w }}px solid {{ block.settings.frame_border_color }};
  color: {{ block.settings.title_color }};
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  box-shadow: 3px 3px 0 {{ block.settings.frame_border_color }};
  flex-shrink: 0;
}

.ai-ar-nav-btn-{{ ai_gen_id }}:hover {
  background: {{ block.settings.accent }};
  color: {{ block.settings.bg_color }};
  border-color: {{ block.settings.accent }};
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 {{ block.settings.frame_border_color }};
}

.ai-ar-nav-btn-{{ ai_gen_id }}:active {
  transform: translate(3px, 3px);
  box-shadow: none;
}

.ai-ar-dots-{{ ai_gen_id }} {
  display: flex;
  gap: 7px;
  align-items: center;
}

.ai-ar-dot-{{ ai_gen_id }} {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  background: {{ block.settings.frame_border_color }};
  opacity: 0.25;
  cursor: pointer;
  border: none;
  padding: 0;
  transition: opacity 0.3s, width 0.3s, background 0.3s;
}

.ai-ar-dot-{{ ai_gen_id }}.active {
  opacity: 1;
  width: 22px;
  background: {{ block.settings.accent }};
}

/* ══════════════════════════════════════
   CTA BUTTON
══════════════════════════════════════ */
.ai-ar-cta-wrap-{{ ai_gen_id }} {
  margin-top: {{ block.settings.cta_mt }}px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.ai-ar-cta-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: {{ block.settings.cta_font }}px;
  font-weight: {{ block.settings.cta_weight }};
  color: {{ block.settings.cta_color }};
  background: {{ block.settings.cta_bg }};
  padding: {{ block.settings.cta_pv }}px {{ block.settings.cta_ph }}px;
  border-radius: {{ block.settings.cta_r }}px;
  text-decoration: none;
  border: {{ block.settings.frame_border_w }}px solid {{ block.settings.frame_border_color }};
  box-shadow: {{ block.settings.cta_sx }}px {{ block.settings.cta_sy }}px 0 {{ block.settings.frame_border_color }};
  transition: all 0.3s ease;
  cursor: pointer;
  letter-spacing: 0.5px;
}

.ai-ar-cta-{{ ai_gen_id }}:hover {
  background: {{ block.settings.cta_hover_bg }};
  color: {{ block.settings.cta_hover_color }};
  transform: translate({{ block.settings.cta_sx | divided_by: 2 }}px, {{ block.settings.cta_sy | divided_by: 2 }}px);
  box-shadow: {{ block.settings.cta_sx | divided_by: 2 }}px {{ block.settings.cta_sy | divided_by: 2 }}px 0 {{ block.settings.frame_border_color }};
}

.ai-ar-cta-hint-{{ ai_gen_id }} {
  font-size: 12px;
  color: {{ block.settings.accent }};
  opacity: 0.65;
  font-weight: 600;
  text-align: center;
}

/* ══════════════════════════════════════
   THUMBNAILS
══════════════════════════════════════ */
.ai-ar-thumbs-{{ ai_gen_id }} {
  display: flex;
  gap: {{ block.settings.thumb_gap }}px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: {{ block.settings.thumbs_mt }}px;
}

.ai-ar-thumb-{{ ai_gen_id }} {
  width: {{ block.settings.thumb_w }}px;
  height: {{ block.settings.thumb_w }}px;
  border-radius: {{ block.settings.thumb_r }}px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  position: relative;
  background: {{ block.settings.placeholder_bg }};
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-ar-thumb-{{ ai_gen_id }}:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 14px {{ block.settings.frame_shadow_color }};
}

.ai-ar-thumb-{{ ai_gen_id }}.active {
  border-color: {{ block.settings.accent }};
  box-shadow: 0 0 0 2px {{ block.settings.accent }}44;
}

.ai-ar-thumb-img-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(0.5);
  transition: filter 0.3s;
}

.ai-ar-thumb-{{ ai_gen_id }}.active .ai-ar-thumb-img-{{ ai_gen_id }},
.ai-ar-thumb-{{ ai_gen_id }}:hover .ai-ar-thumb-img-{{ ai_gen_id }} { filter: grayscale(0); }

.ai-ar-thumb-label-{{ ai_gen_id }} {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: {{ block.settings.frame_border_color }}cc;
  color: {{ block.settings.bg_color }};
  font-size: 9px;
  font-weight: 800;
  text-align: center;
  padding: 2px 0;
  line-height: 1.4;
  letter-spacing: 0.5px;
}

/* ══════════════════════════════════════
   MOBILE
══════════════════════════════════════ */
@media screen and (max-width: 749px) {
  .ai-ar-{{ ai_gen_id }} {
    padding: {{ block.settings.pad_top | divided_by: 2 }}px {{ block.settings.pad_h | divided_by: 2 | round }}px {{ block.settings.pad_bottom | divided_by: 2 }}px;
  }
  .ai-ar-stage-{{ ai_gen_id }} {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .ai-ar-side-{{ ai_gen_id }} { display: none; }
  .ai-ar-title-{{ ai_gen_id }}::before,
  .ai-ar-title-{{ ai_gen_id }}::after { display: none; }
  .ai-ar-model-wrap-{{ ai_gen_id }} {
    width: {{ block.settings.model_w_mobile }}px;
    height: {{ block.settings.model_h_mobile }}px;
  }
}

{% endstyle %}

{%- comment -%} بناء مصفوفة الفنانين {%- endcomment -%}
{% assign artist_list = '' %}
{% for i in (1..10) %}
  {%- assign nk = 'a' | append: i | append: '_name' -%}
  {%- if block.settings[nk] != blank -%}
    {%- assign artist_list = artist_list | append: i | append: ',' -%}
  {%- endif -%}
{% endfor %}
{% assign artist_ids = artist_list | split: ',' | compact %}

<div class="ai-ar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ar-glow-{{ ai_gen_id }}"></div>

  <div class="ai-ar-container-{{ ai_gen_id }}">

    {%- if block.settings.show_header -%}
      <div class="ai-ar-header-{{ ai_gen_id }}">
        {%- if block.settings.section_title != blank -%}
          <h2 class="ai-ar-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {%- endif -%}
        {%- if block.settings.section_subtitle != blank -%}
          <p class="ai-ar-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ai-ar-stage-{{ ai_gen_id }}">

      {%- comment -%} عمود يسار {%- endcomment -%}
      <div class="ai-ar-side-{{ ai_gen_id }}" data-side="left">
        <div class="ai-ar-side-line-{{ ai_gen_id }}"></div>
        {%- if block.settings.left_label != blank -%}
          <span class="ai-ar-side-text-{{ ai_gen_id }}">{{ block.settings.left_label }}</span>
        {%- endif -%}
        {%- if block.settings.left_extra != blank -%}
          <span class="ai-ar-side-extra-{{ ai_gen_id }}">{{ block.settings.left_extra }}</span>
        {%- endif -%}
        <div class="ai-ar-side-line-{{ ai_gen_id }}"></div>
      </div>

      {%- comment -%} المنتصف {%- endcomment -%}
      <div class="ai-ar-center-{{ ai_gen_id }}">

        <div class="ai-ar-name-{{ ai_gen_id }}" id="ar-name-{{ ai_gen_id }}">
          {{ block.settings.a1_name | default: '...' }}
        </div>
        <div class="ai-ar-sub-{{ ai_gen_id }}" id="ar-sub-{{ ai_gen_id }}">
          {{ block.settings.a1_sub }}
        </div>

        <div class="ai-ar-model-wrap-{{ ai_gen_id }}" id="ar-wrap-{{ ai_gen_id }}">

          {%- comment -%} عرض الفنانين الـ 10 كـ model-viewer مخفية ← يظهر النشط فقط {%- endcomment -%}
          {% for i in (1..10) %}
            {%- assign nk  = 'a' | append: i | append: '_name' -%}
            {%- assign glk = 'a' | append: i | append: '_glb' -%}
            {%- assign imk = 'a' | append: i | append: '_thumb' -%}
            {%- assign n_val  = block.settings[nk] -%}
            {%- assign gl_val = block.settings[glk] -%}
            {%- assign im_val = block.settings[imk] -%}
            {%- if n_val != blank -%}
              <div
                class="ai-ar-viewer-slot-{{ ai_gen_id }}"
                data-slot="{{ i | minus: 1 }}"
                style="position:absolute;inset:0;transition:opacity 0.5s ease,transform 0.5s cubic-bezier(0.23,1,0.32,1);{% if i != 1 %}opacity:0;pointer-events:none;transform:scale(0.92) translateY(12px);{% endif %}"
              >
                {%- if gl_val != blank -%}
                  <model-viewer
                    class="ai-ar-viewer-{{ ai_gen_id }}"
                    src="{{ gl_val }}"
                    {% if im_val %}poster="{{ im_val | image_url: width: 600 }}"{% endif %}
                    {% if block.settings.auto_rotate %}auto-rotate{% endif %}
                    auto-rotate-delay="{{ block.settings.rotate_delay }}"
                    rotation-per-second="{{ block.settings.rotate_speed }}deg"
                    camera-controls
                    touch-action="pan-y"
                    interaction-prompt="none"
                    shadow-intensity="{{ block.settings.shadow_intensity }}"
                    shadow-softness="{{ block.settings.shadow_softness }}"
                    exposure="{{ block.settings.exposure }}"
                    environment-image="{{ block.settings.env_image }}"
                    min-camera-orbit="{{ block.settings.orbit_min }}"
                    max-camera-orbit="{{ block.settings.orbit_max }}"
                    min-field-of-view="{{ block.settings.fov_min }}deg"
                    max-field-of-view="{{ block.settings.fov_max }}deg"
                    camera-orbit="{{ block.settings.cam_theta }}deg {{ block.settings.cam_phi }}deg {{ block.settings.cam_radius }}%"
                    style="background:transparent;width:100%;height:100%;"
                    loading="lazy"
                    reveal="auto"
                  >
                    <div slot="progress-bar" style="display:none"></div>
                  </model-viewer>
                {%- else -%}
                  <div class="ai-ar-placeholder-{{ ai_gen_id }}">
                    <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="50%">
                      <circle cx="60" cy="44" r="28" stroke="{{ block.settings.accent }}" stroke-width="3.5" fill="none"/>
