<script>
(function() {
  'use strict';
  var GEN   = '{{ ai_gen_id }}';
  var SPEED = {{ block.settings.transition_speed }};
  var AUTO  = {{ block.settings.auto_advance }};
  var AUTO_DELAY = {{ block.settings.auto_delay }};

  /* بيانات الفنانين */
  var ARTISTS = [];
  {% for i in (1..10) %}
    {%- assign nk  = 'a' | append: i | append: '_name' -%}
    {%- assign sk  = 'a' | append: i | append: '_sub' -%}
    {%- assign uk  = 'a' | append: i | append: '_url' -%}
    {%- if block.settings[nk] != blank -%}
  ARTISTS.push({
    index: {{ i | minus: 1 }},
    name:  {{ block.settings[nk] | json }},
    sub:   {{ block.settings[sk] | default: '' | json }},
    url:   {{ block.settings[uk] | default: '#' | json }}
  });
    {%- endif -%}
  {% endfor %}

  if (!ARTISTS.length) return;

  var total   = ARTISTS.length;
  var current = 0;
  var isAnim  = false;
  var timer   = null;

  var nameEl  = document.getElementById('ar-name-'  + GEN);
  var subEl   = document.getElementById('ar-sub-'   + GEN);
  var ctaEl   = document.getElementById('ar-cta-'   + GEN);
  var prevBtn = document.getElementById('ar-prev-'  + GEN);
  var nextBtn = document.getElementById('ar-next-'  + GEN);
  var dotsEl  = document.getElementById('ar-dots-'  + GEN);
  var thumbsEl= document.getElementById('ar-thumbs-'+ GEN);
  var wrap    = document.getElementById('ar-wrap-'  + GEN);

  var slots  = wrap  ? wrap.querySelectorAll('.ai-ar-viewer-slot-'  + GEN) : [];
  var dots   = dotsEl   ? dotsEl.querySelectorAll('.ai-ar-dot-'   + GEN) : [];
  var thumbs = thumbsEl ? thumbsEl.querySelectorAll('.ai-ar-thumb-' + GEN) : [];

  /* ── الانتقال إلى فنان ── */
  function goTo(idx) {
    if (isAnim || idx === current) return;
    isAnim = true;

    var prev = current;
    current  = ((idx % total) + total) % total;

    /* الـ slot السابق: اخفِ */
    if (slots[prev]) {
      slots[prev].style.opacity        = '0';
      slots[prev].style.transform      = 'scale(0.92) translateY(12px)';
      slots[prev].style.pointerEvents  = 'none';
    }

    /* الـ slot الجديد: أظهر بعد تأخير بسيط */
    setTimeout(function() {
      if (slots[current]) {
        slots[current].style.opacity       = '1';
        slots[current].style.transform     = 'scale(1) translateY(0)';
        slots[current].style.pointerEvents = 'auto';
      }
    }, SPEED * 0.3);

    /* تبديل النص */
    if (nameEl) {
      nameEl.classList.add('is-switching');
      setTimeout(function() {
        nameEl.textContent = ARTISTS[current].name;
        nameEl.classList.remove('is-switching');
      }, 200);
    }
    if (subEl) {
      subEl.classList.add('is-switching');
      setTimeout(function() {
        subEl.textContent = ARTISTS[current].sub;
        subEl.classList.remove('is-switching');
      }, 220);
    }
    if (ctaEl) ctaEl.href = ARTISTS[current].url || '#';

    /* نقاط + صور مصغّرة */
    dots.forEach(function(d,i)   { d.classList.toggle('active', i === current); });
    thumbs.forEach(function(t,i) { t.classList.toggle('active', i === current); });

    setTimeout(function() { isAnim = false; }, SPEED);
  }

  /* ── تشغيل تلقائي ── */
  function startAuto() {
    if (!AUTO) return;
    timer = setInterval(function() { goTo((current + 1) % total); }, AUTO_DELAY);
  }
  function stopAuto() { clearInterval(timer); }

  /* ── أحداث ── */
  if (prevBtn) prevBtn.addEventListener('click', function() { stopAuto(); goTo((current - 1 + total) % total); startAuto(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { stopAuto(); goTo((current + 1) % total); startAuto(); });

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() { stopAuto(); goTo(parseInt(dot.dataset.index)); startAuto(); });
  });

  thumbs.forEach(function(t) {
    t.addEventListener('click', function() { stopAuto(); goTo(parseInt(t.dataset.index)); startAuto(); });
  });

  /* swipe */
  var sx = 0;
  if (wrap) {
    wrap.addEventListener('touchstart', function(e) { sx = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend',   function(e) {
      var diff = sx - e.changedTouches[0].clientX;
      if (false) { stopAuto(); goTo(diff > 0 ? (current+1)%total : (current-1+total)%total); startAuto(); }
    }, { passive: true });
    /* pause auto on hover */
    wrap.addEventListener('mouseenter', stopAuto);
    wrap.addEventListener('mouseleave', startAuto);
  }

  /* keyboard */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft')  { stopAuto(); goTo((current-1+total)%total); startAuto(); }
    if (e.key === 'ArrowRight') { stopAuto(); goTo((current+1)%total);       startAuto(); }
  });

  startAuto();
})();
</script>

