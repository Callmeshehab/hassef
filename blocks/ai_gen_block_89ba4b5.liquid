{% doc %}
  @prompt
    بدي قسم أحط فيه عن الحصيف يأخذ طابع ريترو هيك انيق يعبر عن متجري وهو متجر بيع ريترو 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-retro-about-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-retro-about-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-retro-about-pattern-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: {{ block.settings.pattern_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-retro-about-pattern-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 10px,
        {{ block.settings.pattern_color }} 10px,
        {{ block.settings.pattern_color }} 11px
      ),
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 10px,
        {{ block.settings.pattern_color }} 10px,
        {{ block.settings.pattern_color }} 11px
      );
  }

  .ai-retro-about-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-retro-about-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 
      3px 3px 0 {{ block.settings.title_shadow_color }},
      6px 6px 0 {{ block.settings.title_shadow_color | color_modify: 'alpha', 0.3 }};
  }

  .ai-retro-about-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-style: italic;
  }

  .ai-retro-about-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-retro-about-image-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-retro-about-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    box-shadow: 
      10px 10px 0 {{ block.settings.image_shadow_color }},
      20px 20px 0 {{ block.settings.image_shadow_color | color_modify: 'alpha', 0.3 }};
    transform: rotate({{ block.settings.image_rotation }}deg);
  }

  .ai-retro-about-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    box-shadow: 
      10px 10px 0 {{ block.settings.image_shadow_color }},
      20px 20px 0 {{ block.settings.image_shadow_color | color_modify: 'alpha', 0.3 }};
    transform: rotate({{ block.settings.image_rotation }}deg);
    position: relative;
  }

  .ai-retro-about-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-retro-about-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }

  .ai-retro-about-text-{{ ai_gen_id }} p {
    margin: 0 0 20px;
  }

  .ai-retro-about-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-retro-about-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 20px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 3px solid {{ block.settings.badge_border_color }};
    transform: rotate(-3deg);
    margin-top: 20px;
    box-shadow: 4px 4px 0 {{ block.settings.badge_shadow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-retro-about-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px;
    }

    .ai-retro-about-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-retro-about-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
      text-shadow: 
        2px 2px 0 {{ block.settings.title_shadow_color }},
        4px 4px 0 {{ block.settings.title_shadow_color | color_modify: 'alpha', 0.3 }};
    }

    .ai-retro-about-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-retro-about-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-retro-about-image-{{ ai_gen_id }},
    .ai-retro-about-image-placeholder-{{ ai_gen_id }} {
      box-shadow: 
        6px 6px 0 {{ block.settings.image_shadow_color }},
        12px 12px 0 {{ block.settings.image_shadow_color | color_modify: 'alpha', 0.3 }};
    }
  }
{% endstyle %}

<retro-about-{{ ai_gen_id }} class="ai-retro-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-retro-about-pattern-{{ ai_gen_id }}"></div>
  
  <div class="ai-retro-about-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-retro-about-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-retro-about-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-retro-about-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-retro-about-content-{{ ai_gen_id }}">
      <div class="ai-retro-about-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-retro-about-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-retro-about-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div>
        {% if block.settings.description != blank %}
          <div class="ai-retro-about-text-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        {% if block.settings.show_badge and block.settings.badge_text != blank %}
          <div class="ai-retro-about-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</retro-about-{{ ai_gen_id }}>

<script>
  (function() {
    class RetroAbout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('retro-about-{{ ai_gen_id }}', RetroAbout{{ ai_gen_id }});
  })();
</script>

