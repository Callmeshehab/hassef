{% doc %}
  @prompt
    مختارات هذا الأسبوع — Apple Editorial & Product Showcase Block
    Frameless Circular Browse Button + High Contrast Text Titles & Prices + Single Editorial Card + 2-by-2 Product Stack
{% enddoc %}

{%- assign ai_gen_id = block.id | replace: '_', '' | downcase -%}
{%- assign locale_code = request.locale.iso_code | downcase | split: '-' | first | default: 'ar' -%}
{%- assign is_rtl = false -%}
{%- if 'ar,he,fa,ur' contains locale_code -%}
  {%- assign is_rtl = true -%}
{%- endif -%}

{% style %}
/* ── MAIN BLOCK WRAPPER ── */
.wp-block-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  max-width: 100%;

  margin-top: {{ block.settings.margin_top }}px;
  margin-right: 0;
  margin-bottom: {{ block.settings.margin_bottom }}px;
  margin-left: 0;

  padding-top: {{ block.settings.padding_vertical }}px;
  padding-right: {{ block.settings.carousel_right_offset }}px;
  padding-bottom: {{ block.settings.padding_vertical }}px;
  padding-left: 0;

  background-color: {{ block.settings.background_color }};
  border-radius: {{ block.settings.block_radius }}px;
  box-sizing: border-box;
  background-color: {{ block.settings.background_color }};
  border-radius: {{ block.settings.block_radius }}px;
  box-sizing: border-box;
  /* Direction and text-align inherited from html[dir] */
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "IBM Plex Sans Arabic", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
  position: relative;
  overflow: hidden;
}

/* Header */
.wp-header-{{ ai_gen_id }} {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: {{ block.settings.header_gap }}px;
  padding: 0 2px;
}

.wp-titles-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.wp-subtitle-wrap-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  width: fit-content;
}

.wp-flame-{{ ai_gen_id }} {
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
  transform-origin: 50% 90%;
  animation: wp-flame-flicker-{{ ai_gen_id }} 1.4s ease-in-out infinite;
}

.wp-flame-outer-{{ ai_gen_id }} {
  fill: {{ block.settings.accent_color }};
  transform-origin: center bottom;
  animation: wp-flame-pulse-{{ ai_gen_id }} 1.1s ease-in-out infinite;
}

.wp-flame-inner-{{ ai_gen_id }} {
  fill: #F4B942;
  transform-origin: center bottom;
  animation: wp-flame-inner-{{ ai_gen_id }} 0.8s ease-in-out infinite alternate;
}

@keyframes wp-flame-flicker-{{ ai_gen_id }} {
  0%, 100% {
    transform: rotate(-2deg) scale(1);
  }

  25% {
    transform: rotate(2deg) scale(1.04, 0.98);
  }

  50% {
    transform: rotate(-1deg) scale(0.96, 1.05);
  }

  75% {
    transform: rotate(2deg) scale(1.03, 0.97);
  }
}

@keyframes wp-flame-pulse-{{ ai_gen_id }} {
  0%, 100% {
    transform: scaleY(1);
  }

  50% {
    transform: scaleY(1.06) scaleX(0.97);
  }
}

@keyframes wp-flame-inner-{{ ai_gen_id }} {
  from {
    transform: translateY(1px) scale(0.94);
  }

  to {
    transform: translateY(-0.5px) scale(1.04);
  }
}
.wp-subtitle-{{ ai_gen_id }} {
  font-size: {{ block.settings.subtitle_size }}px;
  font-weight: 600;
  color: {{ block.settings.accent_color }};
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.wp-title-{{ ai_gen_id }} {
  font-size: {{ block.settings.block_title_size }}px;
  font-weight: 700;
  color: {{ block.settings.title_color }};
  margin: 0;
  line-height: 1.2;
}

.wp-view-all-{{ ai_gen_id }} {
  font-size: 14px;
  font-weight: 600;
  color: {{ block.settings.accent_color }};
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: opacity 0.2s ease;
}

.wp-view-all-{{ ai_gen_id }}:hover {
  opacity: 0.8;
}

/* ── CAROUSEL TRACK ── */
.wp-carousel-container-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  /* Direction inherited */
}

.wp-track-{{ ai_gen_id }} {
  display: flex;
  gap: {{ block.settings.slide_gap }}px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;

  padding-top: 4px;
  padding-right: {{ block.settings.carousel_right_offset }}px;
  padding-bottom: 12px;
  padding-left: 0;

  align-items: stretch;
  /* Direction inherited */
}

.wp-track-{{ ai_gen_id }}::-webkit-scrollbar {
  display: none;
}

/* ── LARGE EDITORIAL CARD (Renders ONLY ONCE at start) ── */
.wp-editorial-card-{{ ai_gen_id }} {
  flex: 0 0 calc({{ block.settings.editorial_width }}px - {{ block.settings.carousel_right_offset }}px);
  width: calc({{ block.settings.editorial_width }}px - {{ block.settings.carousel_right_offset }}px);
  scroll-snap-align: start;
  position: relative;
  border-radius: {{ block.settings.card_radius }}px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: {{ block.settings.editorial_padding }}px;
  box-sizing: border-box;
  text-decoration: none;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  border: 1px solid rgba(0, 0, 0, 0.05);
  background-size: cover;
  background-position: center;
}

.wp-editorial-card-{{ ai_gen_id }}:hover {
  transform: none;
  box-shadow: none;
}
.wp-editorial-card-{{ ai_gen_id }}:active {
  transform: none;
  box-shadow: none;
}
.wp-editorial-overlay-{{ ai_gen_id }} {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.wp-editorial-content-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.wp-editorial-label-{{ ai_gen_id }} {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.85;
}

.wp-editorial-heading-{{ ai_gen_id }} {
  font-size: {{ block.settings.editorial_heading_size }}px;
  font-weight: 700;
  line-height: 1.22;
  margin: 0;
  letter-spacing: -0.015em;
}

.wp-editorial-desc-{{ ai_gen_id }} {
  font-size: 13px;
  line-height: 1.45;
  opacity: 0.9;
  margin: 0;
}

.wp-editorial-img-wrap-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0;
}

.wp-editorial-img-{{ ai_gen_id }} {
  max-width: 85%;
  max-height: 150px;
  object-fit: contain;
  transition: transform 0.4s ease;
}

.wp-editorial-card-{{ ai_gen_id }}:hover .wp-editorial-img-{{ ai_gen_id }} {
  transform: scale(1.06);
}

.wp-editorial-cta-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  margin-top: auto;
  padding-top: 8px;
}

/* ── STACKED PRODUCTS COLUMN (2 Products Stacked) ── */
.wp-products-col-{{ ai_gen_id }} {
  flex: 0 0 {{ block.settings.col_width }}px;
  width: {{ block.settings.col_width }}px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: {{ block.settings.card_gap }}px;
  justify-content: space-between;
}

/* ── PRODUCT CARD ── */
.wp-product-card-{{ ai_gen_id }} {
  flex: 1;
  border-radius: {{ block.settings.card_radius }}px;
  padding: 12px 14px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  text-decoration: none;
  border: 1px solid rgba(0, 0, 0, 0.05);
  background-color: {{ block.settings.fixed_card_bg }};
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
}

.wp-product-card-{{ ai_gen_id }}:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.wp-product-header-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 6px;
  text-align: start !important;
}

.wp-product-title-{{ ai_gen_id }} {
  font-size: {{ block.settings.card_title_size }}px !important;
  font-weight: 700 !important;
  color: #171717 !important;
  margin: 0 !important;
  line-height: 1.3 !important;
  opacity: 1 !important;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box !important;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  visibility: visible !important;
  text-align: start !important;
}

.wp-product-img-wrap-{{ ai_gen_id }} {
  width: {{ block.settings.img_width_percent }}%;
  height: {{ block.settings.img_height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4px auto;
}

.wp-product-img-{{ ai_gen_id }} {
  max-width: 100%;
  max-height: 100%;
  object-fit: {{ block.settings.img_fit }};
  transition: transform 0.3s ease;
}

.wp-product-card-{{ ai_gen_id }}:hover .wp-product-img-{{ ai_gen_id }} {
  transform: scale(1.06);
}

.wp-product-footer-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  /* Direction inherited */
}

.wp-product-price-{{ ai_gen_id }} {
  font-size: {{ block.settings.card_price_size }}px !important;
  font-weight: 700 !important;
  color: #171717 !important;
  display: flex;
  align-items: baseline;
  gap: 4px;
  opacity: 1 !important;
  visibility: visible !important;
  text-align: start !important;
}

.wp-product-compare-{{ ai_gen_id }} {
  font-size: 11px;
  color: #a3a3a3;
  text-decoration: line-through;
  font-weight: 400;
}

.wp-add-btn-{{ ai_gen_id }} {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #ffffff;
  color: #171717;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  padding: 0;
  outline: none;
}

.wp-add-btn-{{ ai_gen_id }}:hover {
  background: {{ block.settings.accent_color }};
  color: #ffffff;
  border-color: {{ block.settings.accent_color }};
  transform: scale(1.12);
}

.wp-add-btn-{{ ai_gen_id }}.is-loading {
  opacity: 0.6;
  pointer-events: none;
}

.wp-add-btn-{{ ai_gen_id }}.is-added {
  background: #22c55e;
  color: #ffffff;
  border-color: #22c55e;
}

/* ── FRAMELESS CIRCULAR BROWSE MORE BUTTON AT END ── */
.wp-browse-col-{{ ai_gen_id }} {
  flex: 0 0 110px;
  width: 110px;
  scroll-snap-align: start;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wp-browse-btn-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background: transparent;
  border: none;
  gap: 8px;
  cursor: pointer;
  padding: 0;
  transition: transform 0.3s ease;
}

.wp-browse-btn-{{ ai_gen_id }}:hover {
  transform: scale(1.08);
}

.wp-browse-circle-{{ ai_gen_id }} {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: {{ block.settings.accent_color }};
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  transition: background 0.3s ease, transform 0.3s ease;
}

.wp-browse-btn-{{ ai_gen_id }}:hover .wp-browse-circle-{{ ai_gen_id }} {
  background: #171717;
  transform: scale(1.06);
}

.wp-browse-title-{{ ai_gen_id }} {
  font-size: 13px;
  font-weight: 700;
  color: {{ block.settings.accent_color }};
  margin: 0;
  white-space: nowrap;
}

/* ── PAGINATION DOTS ── */
.wp-dots-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: {{ block.settings.dots_margin_top }}px;
}

.wp-dot-{{ ai_gen_id }} {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.wp-dot-{{ ai_gen_id }}.is-active {
  background: {{ block.settings.accent_color }};
  width: 22px;
  border-radius: 4px;
}

/* Mobile Responsive */
@media screen and (max-width: 749px) {
  .wp-editorial-card-{{ ai_gen_id }} {
    flex: 0 0 240px;
    width: 240px;
  }
  .wp-products-col-{{ ai_gen_id }} {
    flex: 0 0 220px;
    width: 220px;
  }
}
{% endstyle %}

{%- comment -%} Determine Product Objects (Pickers 1-6 or Product List) {%- endcomment -%}
{%- assign p1 = block.settings.product_1 | default: block.settings.products[0] -%}
{%- assign p2 = block.settings.product_2 | default: block.settings.products[1] -%}
{%- assign p3 = block.settings.product_3 | default: block.settings.products[2] -%}
{%- assign p4 = block.settings.product_4 | default: block.settings.products[3] -%}
{%- assign p5 = block.settings.product_5 | default: block.settings.products[4] -%}
{%- assign p6 = block.settings.product_6 | default: block.settings.products[5] -%}

{%- assign img1 = block.settings.image_1 -%}
{%- assign img2 = block.settings.image_2 -%}
{%- assign img3 = block.settings.image_3 -%}
{%- assign img4 = block.settings.image_4 -%}
{%- assign img5 = block.settings.image_5 -%}
{%- assign img6 = block.settings.image_6 -%}

{%- comment -%} High Contrast Text Colors per product card {%- endcomment -%}
{%- assign raw_card_text = block.settings.card_text_color | downcase | default: '#171717' -%}
{%- if raw_card_text == blank or raw_card_text == 'transparent' or raw_card_text == '#ffffff' or raw_card_text == '#fff' or raw_card_text == 'rgba(0,0,0,0)' -%}
  {%- assign raw_card_text = '#171717' -%}
{%- endif -%}

{%- assign txt_c1 = raw_card_text -%}
{%- assign txt_c2 = raw_card_text -%}
{%- assign txt_c3 = raw_card_text -%}
{%- assign txt_c4 = raw_card_text -%}
{%- assign txt_c5 = raw_card_text -%}
{%- assign txt_c6 = raw_card_text -%}

{%- if block.settings.enable_auto_colors -%}
  {%- if block.settings.color_1 != blank and block.settings.color_1 != '#ffffff' -%}{%- assign txt_c1 = block.settings.color_1 -%}{%- endif -%}
  {%- if block.settings.color_2 != blank and block.settings.color_2 != '#ffffff' -%}{%- assign txt_c2 = block.settings.color_2 -%}{%- endif -%}
  {%- if block.settings.color_3 != blank and block.settings.color_3 != '#ffffff' -%}{%- assign txt_c3 = block.settings.color_3 -%}{%- endif -%}
  {%- if block.settings.color_4 != blank and block.settings.color_4 != '#ffffff' -%}{%- assign txt_c4 = block.settings.color_4 -%}{%- endif -%}
  {%- if block.settings.color_5 != blank and block.settings.color_5 != '#ffffff' -%}{%- assign txt_c5 = block.settings.color_5 -%}{%- endif -%}
  {%- if block.settings.color_1 != blank and block.settings.color_1 != '#ffffff' -%}{%- assign txt_c6 = block.settings.color_1 -%}{%- endif -%}
{%- endif -%}

<div class="wp-block-{{ ai_gen_id }}" id="WpBlock-{{ ai_gen_id }}">
  {%- if block.settings.title != blank -%}
    <div class="wp-header-{{ ai_gen_id }}">
      <div class="wp-titles-{{ ai_gen_id }}">
        {%- if block.settings.subtitle != blank -%}
<div class="wp-subtitle-wrap-{{ ai_gen_id }}">
  <svg
    class="wp-flame-{{ ai_gen_id }}"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      class="wp-flame-outer-{{ ai_gen_id }}"
      d="M12.1 22C7.7 22 5 19.2 5 15.4c0-2.8 1.5-5.1 3.9-7.4-.1 2.1.8 3.2 1.8 3.7-.3-3.7 1.4-6.8 3.8-9.7.2 3.2 4.5 5.4 4.5 10.1C19 17.2 16.3 22 12.1 22Z"
    />
    <path
      class="wp-flame-inner-{{ ai_gen_id }}"
      d="M12.2 19.2c-1.9 0-3.1-1.2-3.1-2.9 0-1.2.6-2.3 1.7-3.4 0 1 .5 1.7 1.2 1.9-.1-1.8.7-3.1 1.7-4.3.2 1.6 2.1 2.7 2.1 4.8 0 2-1.5 3.9-3.6 3.9Z"
    />
  </svg>

  <span class="wp-subtitle-{{ ai_gen_id }}">
    {{ block.settings.subtitle }}
  </span>
</div>        {%- endif -%}
        <h2 class="wp-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>

      {%- if block.settings.show_view_all and block.settings.collection_url != blank -%}
        <a href="{{ block.settings.collection_url }}" class="wp-view-all-{{ ai_gen_id }}">
          {{ block.settings.view_all_text | default: 'عرض الكل' }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="wp-carousel-container-{{ ai_gen_id }}">
    <div class="wp-track-{{ ai_gen_id }}" id="WpTrack-{{ ai_gen_id }}">
      
      <!-- 1) EDITORIAL LARGE CARD (Renders ONLY ONCE at the start) -->
      <a
        href="{{ block.settings.editorial_cta_url | default: '#' }}"
        class="wp-editorial-card-{{ ai_gen_id }}"
        style="
          background-color: {{ block.settings.editorial_bg_color | default: '#5B171C' }};
          color: {{ block.settings.editorial_text_color | default: '#ffffff' }};
          {% if block.settings.editorial_bg_image != blank %}background-image: url('{{ block.settings.editorial_bg_image | image_url: width: 800 }}');{% endif %}
        "
      >
        {%- if block.settings.overlay_opacity > 0 -%}
          <div
            class="wp-editorial-overlay-{{ ai_gen_id }}"
            style="background: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>
        {%- endif -%}

        <div class="wp-editorial-content-{{ ai_gen_id }}">
          {%- if block.settings.editorial_label != blank -%}
            <span class="wp-editorial-label-{{ ai_gen_id }}">{{ block.settings.editorial_label }}</span>
          {%- endif -%}
          {%- if block.settings.editorial_heading != blank -%}
            <h3 class="wp-editorial-heading-{{ ai_gen_id }}">{{ block.settings.editorial_heading }}</h3>
          {%- endif -%}
          {%- if block.settings.editorial_desc != blank -%}
            <p class="wp-editorial-desc-{{ ai_gen_id }}">{{ block.settings.editorial_desc }}</p>
          {%- endif -%}
        </div>
