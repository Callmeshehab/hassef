<script>
(function() {
  const blockId = '{{ ai_gen_id }}';
  const track = document.getElementById('WpTrack-' + blockId);
  const dotsContainer = document.getElementById('WpDots-' + blockId);
  
  if (!track) return;

// Smart Pagination Dots - RTL/LTR + Touch/Mouse Scroll Safe
if (dotsContainer) {
  const dots = Array.from(
    dotsContainer.querySelectorAll('.wp-dot-' + blockId)
  );

  const slides = Array.from(track.children).filter(child =>
    child.classList.contains('wp-editorial-card-' + blockId) ||
    child.classList.contains('wp-products-col-' + blockId)
  );

  if (slides.length && dots.length) {

    let ticking = false;

    function getSlidePosition(slide) {
      const trackRect = track.getBoundingClientRect();
      const slideRect = slide.getBoundingClientRect();

      // Distance of slide from the visible start edge
      if (document.documentElement.dir === 'rtl') {
        return Math.abs(trackRect.right - slideRect.right);
      }

      return Math.abs(slideRect.left - trackRect.left);
    }

    function updateActiveDot() {
      let closestIndex = 0;
      let closestDistance = Infinity;

      slides.forEach((slide, index) => {
        const distance = getSlidePosition(slide);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === closestIndex);
      });

      ticking = false;
    }

    function requestUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(updateActiveDot);
        ticking = true;
      }
    }

    // Update immediately while dragging / swiping
    track.addEventListener('scroll', requestUpdate, {
      passive: true
    });

    // Update after resize
    window.addEventListener('resize', requestUpdate);

    // Clicking a dot
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const slide = slides[index];

        if (!slide) return;

        slide.scrollIntoView({
          behavior: 'smooth',
          inline: 'start',
          block: 'nearest'
        });

        // Update immediately
        dots.forEach((d, i) => {
          d.classList.toggle('is-active', i === index);
        });
      });
    });

    // Initial state
    updateActiveDot();
  }
}

  // AJAX Add to Cart Buttons
  const addButtons = document.querySelectorAll('#WpBlock-' + blockId + ' .wp-add-btn-' + blockId);
  addButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      const variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;

      const self = this;
      self.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => res.json())
      .then(data => {
        self.classList.remove('is-loading');
        self.classList.add('is-added');
        setTimeout(() => self.classList.remove('is-added'), 2000);

        if (window.Shopify && Shopify.onItemAdded) {
          Shopify.onItemAdded(data);
        }
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            const countEl = document.getElementById('hfCartCount');
            if (countEl) {
              countEl.textContent = cart.item_count;
              countEl.style.display = cart.item_count > 0 ? 'inline-flex' : 'none';
            }
          }).catch(() => {});
      })
      .catch(() => {
        self.classList.remove('is-loading');
      });
    });
  });

})();
</script>

