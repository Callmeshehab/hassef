{% doc %}
  @prompt
    شريط عرض منتجات مينيمل بسيط بهادئ وواجهة أنيقة مستوحاة من تصاميم أبل Apple Minimalist Showcase
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* Apple Minimalist Product Showcase Bar */
  .apple-product-bar-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", "IBM Plex Sans Arabic", sans-serif;
    box-sizing: border-box;
    position: relative;
    direction: rtl;
    -webkit-font-smoothing: antialiased;
  }

  /* Header Section */
  .apple-bar-header-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
    padding: 0 4px;
  }

  .apple-bar-titles-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .apple-bar-eyebrow-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: #86868b;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .apple-bar-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Nav Controls Header Side */
  .apple-bar-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apple-nav-btn-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ block.settings.nav_bg }};
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: {{ block.settings.nav_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .apple-nav-btn-{{ ai_gen_id }}:hover:not(:disabled) {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.06);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .apple-nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .apple-nav-btn-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.2;
  }

  /* Track & Container */
  .apple-bar-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 -4px;
    padding: 6px 4px 12px 4px;
  }

  .apple-bar-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* Minimalist Card */
  .apple-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .apple-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.08);
  }

  /* Badge Pill */
  .apple-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #1d1d1f;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 2;
    letter-spacing: -0.01em;
  }

  /* Image Area */
  .apple-card-image-wrap-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #fbfbfd;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apple-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apple-card-{{ ai_gen_id }}:hover .apple-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .apple-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f7;
  }

  .apple-card-placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  /* Card Content Info */
  .apple-card-info-{{ ai_gen_id }} {
    padding: 18px 20px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
    gap: 12px;
  }

  .apple-card-meta-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .apple-card-vendor-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
    color: #86868b;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .apple-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.35;
    letter-spacing: -0.015em;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .apple-card-bottom-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 8px;
  }

  .apple-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .apple-card-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: #86868b;
    font-weight: 400;
    font-size: 0.85em;
  }

  .apple-card-btn-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    color: #0071e3;
    background: rgba(0, 113, 227, 0.08);
    padding: 6px 14px;
    border-radius: 20px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .apple-card-{{ ai_gen_id }}:hover .apple-card-btn-{{ ai_gen_id }} {
    background: #0071e3;
    color: #ffffff;
  }

  .apple-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 50px 20px;
    color: #86868b;
    font-size: 15px;
  }

  @media screen and (max-width: 749px) {
    .apple-product-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_v | times: 0.75 }}px 16px;
    }

    .apple-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.82 }}px;
    }

    .apple-bar-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<apple-product-bar-{{ ai_gen_id }} class="apple-product-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="apple-bar-header-{{ ai_gen_id }}">
    <div class="apple-bar-titles-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <span class="apple-bar-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="apple-bar-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if block.settings.products.count > 0 %}
      <div class="apple-bar-controls-{{ ai_gen_id }}">
        <button
          class="apple-nav-btn-{{ ai_gen_id }} apple-nav-prev-{{ ai_gen_id }}"
          aria-label="السابق"
          data-direction="prev"
        >
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <button
          class="apple-nav-btn-{{ ai_gen_id }} apple-nav-next-{{ ai_gen_id }}"
          aria-label="التالي"
          data-direction="next"
        >
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>

  {% if block.settings.products.count > 0 %}
    <div class="apple-bar-container-{{ ai_gen_id }}">
      <div class="apple-bar-wrapper-{{ ai_gen_id }}">
        {% for product in block.settings.products %}
          <a href="{{ product.url }}" class="apple-card-{{ ai_gen_id }}">
            {% if product.compare_at_price > product.price %}
              <span class="apple-card-badge-{{ ai_gen_id }}">خصم خاص</span>
            {% elsif forloop.index == 1 %}
              <span class="apple-card-badge-{{ ai_gen_id }}">جديد</span>
            {% endif %}

            <div class="apple-card-image-wrap-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="apple-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="apple-card-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="apple-card-info-{{ ai_gen_id }}">
              <div class="apple-card-meta-{{ ai_gen_id }}">
                {% if product.vendor != blank %}
                  <span class="apple-card-vendor-{{ ai_gen_id }}">{{ product.vendor }}</span>
                {% endif %}
                <h3 class="apple-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              </div>

              <div class="apple-card-bottom-{{ ai_gen_id }}">
                <div class="apple-card-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span class="apple-card-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
                <span class="apple-card-btn-{{ ai_gen_id }}">
                  تسوق <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="apple-empty-state-{{ ai_gen_id }}">
      اختر مجموعة المنتجات لعرضها بتصميم أبل الأنيق
    </div>
  {% endif %}
</apple-product-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AppleProductBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardWidth = {{ block.settings.card_width }};
        this.gap = {{ block.settings.gap }};
        this.visibleCards = {{ block.settings.visible_cards }};
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.apple-bar-wrapper-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.apple-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.apple-nav-next-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.apple-card-{{ ai_gen_id }}');

        if (!this.wrapper || this.cards.length === 0) return;

        this.totalCards = this.cards.length;
        this.setupEventListeners();
        this.handleResize();

        window.addEventListener('resize', () => this.handleResize());
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.wrapper.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        }, { passive: true });

        this.wrapper.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        }, { passive: true });

        this.wrapper.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              this.navigate('prev');
            } else {
              this.navigate('next');
            }
          }
          isDragging = false;
        });
      }

      handleResize() {
        if (window.innerWidth <= 749) {
          this.cardWidth = {{ block.settings.card_width | times: 0.82 }};
          this.visibleCards = Math.min(2, this.totalCards);
        } else {
          this.cardWidth = {{ block.settings.card_width }};
          this.visibleCards = Math.min({{ block.settings.visible_cards }}, this.totalCards);
        }
        this.maxIndex = Math.max(0, this.totalCards - this.visibleCards);
        this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
        this.updatePosition();
        this.updateButtons();
      }

      navigate(direction) {
        if (direction === 'next' && this.currentIndex < this.maxIndex) {
          this.currentIndex++;
        } else if (direction === 'prev' && this.currentIndex > 0) {
          this.currentIndex--;
        }
        this.updatePosition();
        this.updateButtons();
      }

      updatePosition() {
        const offset = (this.currentIndex * (this.cardWidth + this.gap));
        this.wrapper.style.transform = `translateX(${offset}px)`;
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }
      }
    }

    customElements.define('apple-product-bar-{{ ai_gen_id }}', AppleProductBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "شريط أبل للمنتجات",
  "settings": [
    {
      "type": "header",
      "content": "العناوين"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "النص الثانوي العلوي",
      "default": "المنتجات المميزة"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي",
      "default": "تصاميم هادئة. لمسات فاخرة."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "حجم العنوان الرئيسي",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "المنتجات"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "قائمة المنتجات",
      "limit": 12
    },
    {
      "type": "range",
      "id": "visible_cards",
      "label": "عدد المنتجات المعروضة على الشاشات الكبيرة",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "عرض الشريط الإجمالي",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "تصميم بطاقة المنتج"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "عرض بطاقة المنتج",
      "min": 220,
      "max": 420,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "gap",
      "label": "المسافة بين البطاقات",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "استدارة زوايا البطاقة",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "لون خلفية البطاقة",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "النصوص والأسعار"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "حجم اسم المنتج",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "حجم السعر",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "لون عناوين المنتجات",
      "default": "#1d1d1f"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "لون السعر",
      "default": "#1d1d1f"
    },
    {
      "type": "header",
      "content": "الخلفية والحشوات"
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "الحشوة العمودية",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_h",
      "label": "الحشوة الأفقية",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "استدارة زوايا الشريط الكلي",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "لون خلفية الشريط",
      "default": "#f5f5f7"
    },
    {
      "type": "header",
      "content": "أزرار التنقل"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "خلفية زري التنقل",
      "default": "rgba(255, 255, 255, 0.85)"
    },
    {
      "type": "color",
      "id": "nav_icon_color",
      "label": "لون أيقونة الأسهم",
      "default": "#1d1d1f"
    }
  ],
  "presets": [
    {
      "name": "شريط أبل للمنتجات"
    }
  ]
}
{% endschema %}
