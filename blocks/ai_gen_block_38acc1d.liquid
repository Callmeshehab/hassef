{% doc %}
  @prompt
    مختارات هذا الأسبوع — Apple Editorial & Product Showcase Block
    Large Editorial Card + 2 Stacked Product Cards Carousel
{% enddoc %}

{%- assign ai_gen_id = block.id | replace: '_', '' | downcase -%}
{%- assign is_rtl = request.locale.iso_code | default: 'ar' -%}

{% style %}
/* ── MAIN BLOCK WRAPPER ── */
.wp-block-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.block_width_percent }}%;
  max-width: 100%;
  margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px;
  padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  background-color: {{ block.settings.background_color }};
  border-radius: {{ block.settings.block_radius }}px;
  box-sizing: border-box;
  direction: {{ request.locale.iso_code | default: 'ar' | replace: 'ar', 'rtl' | replace: 'en', 'ltr' }};
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "IBM Plex Sans Arabic", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
  position: relative;
  overflow: hidden;
}

/* Header */
.wp-header-{{ ai_gen_id }} {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: {{ block.settings.header_gap }}px;
  padding: 0 2px;
}

.wp-titles-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.wp-subtitle-{{ ai_gen_id }} {
  font-size: {{ block.settings.subtitle_size }}px;
  font-weight: 600;
  color: {{ block.settings.accent_color }};
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.wp-title-{{ ai_gen_id }} {
  font-size: {{ block.settings.block_title_size }}px;
  font-weight: 700;
  color: {{ block.settings.title_color }};
  margin: 0;
  line-height: 1.2;
}

.wp-view-all-{{ ai_gen_id }} {
  font-size: 14px;
  font-weight: 600;
  color: {{ block.settings.accent_color }};
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: opacity 0.2s ease;
}

.wp-view-all-{{ ai_gen_id }}:hover {
  opacity: 0.8;
}

/* ── CAROUSEL TRACK ── */
.wp-carousel-container-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
}

.wp-track-{{ ai_gen_id }} {
  display: flex;
  gap: {{ block.settings.slide_gap }}px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding: 4px 0 12px;
}

.wp-track-{{ ai_gen_id }}::-webkit-scrollbar {
  display: none;
}

/* ── SLIDE GROUP (Editorial + 2 Stacked Products) ── */
.wp-slide-{{ ai_gen_id }} {
  flex: 0 0 100%;
  max-width: 100%;
  scroll-snap-align: start;
  display: grid;
  grid-template-columns: calc(48% - ({{ block.settings.card_gap }}px / 2)) calc(52% - ({{ block.settings.card_gap }}px / 2));
  gap: {{ block.settings.card_gap }}px;
  box-sizing: border-box;
}

@media screen and (min-width: 750px) {
  .wp-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(50% - ({{ block.settings.slide_gap }}px / 2));
    max-width: calc(50% - ({{ block.settings.slide_gap }}px / 2));
  }
}

@media screen and (min-width: 1100px) {
  .wp-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - ({{ block.settings.slide_gap }}px * 2 / 3));
    max-width: calc(33.333% - ({{ block.settings.slide_gap }}px * 2 / 3));
  }
}

/* ── LARGE EDITORIAL CARD ── */
.wp-editorial-card-{{ ai_gen_id }} {
  position: relative;
  border-radius: {{ block.settings.card_radius }}px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: {{ block.settings.editorial_padding }}px;
  box-sizing: border-box;
  text-decoration: none;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  border: 1px solid rgba(0, 0, 0, 0.05);
  background-size: cover;
  background-position: center;
  height: 100%;
}

.wp-editorial-card-{{ ai_gen_id }}:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.09);
}

.wp-editorial-overlay-{{ ai_gen_id }} {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.wp-editorial-content-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.wp-editorial-label-{{ ai_gen_id }} {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.85;
}

.wp-editorial-heading-{{ ai_gen_id }} {
  font-size: {{ block.settings.editorial_heading_size }}px;
  font-weight: 700;
  line-height: 1.22;
  margin: 0;
  letter-spacing: -0.015em;
}

.wp-editorial-desc-{{ ai_gen_id }} {
  font-size: 13px;
  line-height: 1.45;
  opacity: 0.9;
  margin: 0;
}

.wp-editorial-img-wrap-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0;
}

.wp-editorial-img-{{ ai_gen_id }} {
  max-width: 85%;
  max-height: 150px;
  object-fit: contain;
  transition: transform 0.4s ease;
}

.wp-editorial-card-{{ ai_gen_id }}:hover .wp-editorial-img-{{ ai_gen_id }} {
  transform: scale(1.06);
}

.wp-editorial-cta-{{ ai_gen_id }} {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  margin-top: auto;
  padding-top: 8px;
}

/* ── STACKED PRODUCTS COLUMN ── */
.wp-products-col-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: {{ block.settings.card_gap }}px;
  justify-content: space-between;
  height: 100%;
}

/* ── PRODUCT CARD ── */
.wp-product-card-{{ ai_gen_id }} {
  flex: 1;
  border-radius: {{ block.settings.card_radius }}px;
  padding: 12px 14px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  text-decoration: none;
  border: 1px solid rgba(0, 0, 0, 0.05);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
}

.wp-product-card-{{ ai_gen_id }}:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.wp-product-header-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 4px;
}

.wp-product-title-{{ ai_gen_id }} {
  font-size: 13px;
  font-weight: 700;
  color: #171717;
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.wp-product-meta-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: #737373;
  font-weight: 500;
}

.wp-product-img-wrap-{{ ai_gen_id }} {
  width: 100%;
  height: 85px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4px 0;
}

.wp-product-img-{{ ai_gen_id }} {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.wp-product-card-{{ ai_gen_id }}:hover .wp-product-img-{{ ai_gen_id }} {
  transform: scale(1.06);
}

.wp-product-footer-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
}

.wp-product-price-{{ ai_gen_id }} {
  font-size: 13px;
  font-weight: 700;
  color: #171717;
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.wp-product-compare-{{ ai_gen_id }} {
  font-size: 11px;
  color: #a3a3a3;
  text-decoration: line-through;
  font-weight: 400;
}

.wp-add-btn-{{ ai_gen_id }} {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #ffffff;
  color: #171717;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  padding: 0;
  outline: none;
}

.wp-add-btn-{{ ai_gen_id }}:hover {
  background: {{ block.settings.accent_color }};
  color: #ffffff;
  border-color: {{ block.settings.accent_color }};
  transform: scale(1.12);
}

.wp-add-btn-{{ ai_gen_id }}.is-loading {
  opacity: 0.6;
  pointer-events: none;
}

.wp-add-btn-{{ ai_gen_id }}.is-added {
  background: #22c55e;
  color: #ffffff;
  border-color: #22c55e;
}

/* ── PAGINATION DOTS ── */
.wp-dots-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: {{ block.settings.dots_margin_top }}px;
}

.wp-dot-{{ ai_gen_id }} {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.wp-dot-{{ ai_gen_id }}.is-active {
  background: {{ block.settings.accent_color }};
  width: 22px;
  border-radius: 4px;
}

/* Mobile Small Responsive */
@media screen and (max-width: 480px) {
  .wp-product-card-{{ ai_gen_id }} {
    padding: 10px;
  }
  .wp-product-title-{{ ai_gen_id }} {
    font-size: 12px;
  }
  .wp-product-img-wrap-{{ ai_gen_id }} {
    height: 65px;
  }
}
{% endstyle %}

<div class="wp-block-{{ ai_gen_id }}" id="WpBlock-{{ ai_gen_id }}">
  {%- if block.settings.title != blank -%}
    <div class="wp-header-{{ ai_gen_id }}">
      <div class="wp-titles-{{ ai_gen_id }}">
        {%- if block.settings.subtitle != blank -%}
          <span class="wp-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</span>
        {%- endif -%}
        <h2 class="wp-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>

      {%- if block.settings.show_view_all and block.settings.collection_url != blank -%}
        <a href="{{ block.settings.collection_url }}" class="wp-view-all-{{ ai_gen_id }}">
          {{ block.settings.view_all_text | default: 'عرض الكل' }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="wp-carousel-container-{{ ai_gen_id }}">
    <div class="wp-track-{{ ai_gen_id }}" id="WpTrack-{{ ai_gen_id }}">
      
      {%- if block.settings.products != blank and block.settings.products.count > 0 -%}

        {%- for product in block.settings.products -%}
          {%- assign mod2 = forloop.index0 | modulo: 2 -%}
          
          {%- if mod2 == 0 -%}
            {%- assign s_idx = forloop.index0 | divided_by: 2 -%}
            {%- assign color_idx = s_idx | modulo: 5 -%}
            {%- assign card_bg = block.settings.fixed_card_bg -%}
            {%- if block.settings.enable_auto_colors -%}
              {%- case color_idx -%}
                {%- when 0 -%}{%- assign card_bg = block.settings.color_1 -%}
                {%- when 1 -%}{%- assign card_bg = block.settings.color_2 -%}
                {%- when 2 -%}{%- assign card_bg = block.settings.color_3 -%}
                {%- when 3 -%}{%- assign card_bg = block.settings.color_4 -%}
                {%- when 4 -%}{%- assign card_bg = block.settings.color_5 -%}
              {%- endcase -%}
            {%- endif -%}

            <div class="wp-slide-{{ ai_gen_id }}">
              
              {%- comment -%} 1) LARGE EDITORIAL CARD {%- endcomment -%}
              <a
                href="{{ block.settings.editorial_cta_url | default: '#' }}"
                class="wp-editorial-card-{{ ai_gen_id }}"
                style="
                  background-color: {{ block.settings.editorial_bg_color | default: '#5B171C' }};
                  color: {{ block.settings.editorial_text_color | default: '#ffffff' }};
                  {% if block.settings.editorial_bg_image != blank %}background-image: url('{{ block.settings.editorial_bg_image | image_url: width: 800 }}');{% endif %}
                "
              >
                {%- if block.settings.overlay_opacity > 0 -%}
                  <div
                    class="wp-editorial-overlay-{{ ai_gen_id }}"
                    style="background: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
                  ></div>
                {%- endif -%}

                <div class="wp-editorial-content-{{ ai_gen_id }}">
                  {%- if block.settings.editorial_label != blank -%}
                    <span class="wp-editorial-label-{{ ai_gen_id }}">{{ block.settings.editorial_label }}</span>
                  {%- endif -%}
                  {%- if block.settings.editorial_heading != blank -%}
                    <h3 class="wp-editorial-heading-{{ ai_gen_id }}">{{ block.settings.editorial_heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.editorial_desc != blank -%}
                    <p class="wp-editorial-desc-{{ ai_gen_id }}">{{ block.settings.editorial_desc }}</p>
                  {%- endif -%}
                </div>

                {%- if block.settings.editorial_image != blank -%}
                  <div class="wp-editorial-img-wrap-{{ ai_gen_id }}">
                    <img
                      src="{{ block.settings.editorial_image | image_url: width: 600 }}"
                      alt="{{ block.settings.editorial_heading | escape }}"
                      class="wp-editorial-img-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}

                {%- if block.settings.editorial_cta_text != blank -%}
                  <div class="wp-editorial-cta-{{ ai_gen_id }}" style="color: {{ block.settings.editorial_accent_color | default: '#ffffff' }}">
                    {{ block.settings.editorial_cta_text }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
                  </div>
                {%- endif -%}
              </a>

              {%- comment -%} 2) STACKED PRODUCTS COLUMN {%- endcomment -%}
              <div class="wp-products-col-{{ ai_gen_id }}">
          {%- endif -%}

                {%- comment -%} RENDER SELECTED PRODUCT CARD {%- endcomment -%}
                <div
                  class="wp-product-card-{{ ai_gen_id }}"
                  style="background-color: {{ card_bg | default: '#ffffff' }};"
                >
                  <a href="{{ product.url }}" style="text-decoration:none; color:inherit; display:flex; flex-direction:column; flex:1; justify-content:space-between;">
                    <div class="wp-product-header-{{ ai_gen_id }}">
                      <h4 class="wp-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                      <div class="wp-product-meta-{{ ai_gen_id }}">
                        {%- if block.settings.show_vendor and product.vendor != blank -%}
                          <span>{{ product.vendor }}</span>
                        {%- endif -%}
                        {%- if block.settings.show_year -%}
                          {%- assign p_year = product.metafields.custom.year | default: product.metafields.my_fields.year | default: product.published_at | date: '%Y' -%}
                          {%- if p_year != blank -%}
                            <span>• {{ p_year }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="wp-product-img-wrap-{{ ai_gen_id }}">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 400 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          class="wp-product-img-{{ ai_gen_id }}"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- elsif product.images.first -%}
                        <img
                          src="{{ product.images.first | image_url: width: 400 }}"
                          alt="{{ product.title | escape }}"
                          class="wp-product-img-{{ ai_gen_id }}"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {%- endif -%}
                    </div>

                    <div class="wp-product-footer-{{ ai_gen_id }}">
                      <div class="wp-product-price-{{ ai_gen_id }}">
                        {{ product.price | money }}
                        {%- if product.compare_at_price > product.price -%}
                          <span class="wp-product-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                  </a>
                      {%- if block.settings.show_add_button -%}
                        {%- assign v_id = product.first_available_variant.id | default: product.variants.first.id -%}
                        <button
                          type="button"
                          class="wp-add-btn-{{ ai_gen_id }}"
                          data-variant-id="{{ v_id }}"
                          aria-label="إضافة للسلة"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </button>
                      {%- endif -%}
                    </div>
                </div>

          {%- if mod2 == 1 or forloop.last -%}
              </div> <!-- end .wp-products-col -->
            </div> <!-- end .wp-slide -->
          {%- endif -%}

        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Demonstration Placeholders if no products are selected in Customizer {%- endcomment -%}
        <div class="wp-slide-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.editorial_cta_url | default: '#' }}"
            class="wp-editorial-card-{{ ai_gen_id }}"
            style="
              background-color: {{ block.settings.editorial_bg_color | default: '#5B171C' }};
              color: {{ block.settings.editorial_text_color | default: '#ffffff' }};
              {% if block.settings.editorial_bg_image != blank %}background-image: url('{{ block.settings.editorial_bg_image | image_url: width: 800 }}');{% endif %}
            "
          >
            <div class="wp-editorial-content-{{ ai_gen_id }}">
              {%- if block.settings.editorial_label != blank -%}
                <span class="wp-editorial-label-{{ ai_gen_id }}">{{ block.settings.editorial_label }}</span>
              {%- endif -%}
              {%- if block.settings.editorial_heading != blank -%}
                <h3 class="wp-editorial-heading-{{ ai_gen_id }}">{{ block.settings.editorial_heading }}</h3>
              {%- endif -%}
              {%- if block.settings.editorial_desc != blank -%}
                <p class="wp-editorial-desc-{{ ai_gen_id }}">{{ block.settings.editorial_desc }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.editorial_cta_text != blank -%}
              <div class="wp-editorial-cta-{{ ai_gen_id }}" style="color: {{ block.settings.editorial_accent_color | default: '#ffffff' }}">
                {{ block.settings.editorial_cta_text }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
              </div>
            {%- endif -%}
          </a>

          <div class="wp-products-col-{{ ai_gen_id }}">
            {%- for k in (1..2) -%}
              <div class="wp-product-card-{{ ai_gen_id }}" style="background-color: {{ block.settings.color_1 | default: '#FAF9F5' }};">
                <div class="wp-product-header-{{ ai_gen_id }}">
                  <h4 class="wp-product-title-{{ ai_gen_id }}">اختر المنتجات من القائمة جانباً {{ k }}</h4>
                  <div class="wp-product-meta-{{ ai_gen_id }}">الحصيف • 1978</div>
                </div>
                <div class="wp-product-img-wrap-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
                <div class="wp-product-footer-{{ ai_gen_id }}">
                  <div class="wp-product-price-{{ ai_gen_id }}">350 ج.م</div>
                  <button type="button" class="wp-add-btn-{{ ai_gen_id }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    </div>

    {%- if block.settings.show_dots -%}
      <div class="wp-dots-{{ ai_gen_id }}" id="WpDots-{{ ai_gen_id }}">
        {%- assign total_p = block.settings.products.count | default: 2 -%}
        {%- assign total_slides = total_p | divided_by: 2 -%}
        {%- assign rem = total_p | modulo: 2 -%}
        {%- if rem > 0 -%}{%- assign total_slides = total_slides | plus: 1 -%}{%- endif -%}
        {%- if total_slides > 1 -%}
          {%- for s in (1..total_slides) -%}
            <button
              type="button"
              class="wp-dot-{{ ai_gen_id }}{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
(function() {
  const blockId = '{{ ai_gen_id }}';
  const track = document.getElementById('WpTrack-' + blockId);
  const dotsContainer = document.getElementById('WpDots-' + blockId);
  
  if (!track) return;

  // Pagination Dots Sync
  if (dotsContainer) {
    const dots = dotsContainer.querySelectorAll('.wp-dot-' + blockId);
    
    // Click to scroll
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        const slideWidth = track.firstElementChild ? track.firstElementChild.offsetWidth : 300;
        const gap = {{ block.settings.slide_gap | default: 16 }};
        track.scrollTo({
          left: idx * (slideWidth + gap),
          behavior: 'smooth'
        });
      });
    });

    // Scroll listener for active dot
    let scrollTimeout;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const slideWidth = track.firstElementChild ? track.firstElementChild.offsetWidth : 300;
        const gap = {{ block.settings.slide_gap | default: 16 }};
        const currentIdx = Math.round(track.scrollLeft / (slideWidth + gap));
        
        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === currentIdx);
        });
      }, 50);
    }, { passive: true });
  }

  // AJAX Add to Cart Buttons
  const addButtons = document.querySelectorAll('#WpBlock-' + blockId + ' .wp-add-btn-' + blockId);
  addButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      const variantId = this.getAttribute('data-variant-id');
      if (!variantId) return;

      const self = this;
      self.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => res.json())
      .then(data => {
        self.classList.remove('is-loading');
        self.classList.add('is-added');
        setTimeout(() => self.classList.remove('is-added'), 2000);

        if (window.Shopify && Shopify.onItemAdded) {
          Shopify.onItemAdded(data);
        }
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            const countEl = document.getElementById('hfCartCount');
            if (countEl) {
              countEl.textContent = cart.item_count;
              countEl.style.display = cart.item_count > 0 ? 'inline-flex' : 'none';
            }
          }).catch(() => {});
      })
      .catch(() => {
        self.classList.remove('is-loading');
      });
    });
  });

})();
</script>

